def _kebab(key: str) -> str:
    return key.replace("_", "-")


def _build_cli_args(group: str, cmd: str | None, args: dict) -> list[str]:
    """Translate MCP tool args (JSON object with snake_case keys) into
    chad-webui CLI args (--kebab-case flags)."""
    out = [group]
    if cmd:
        out.append(cmd)
    for key, value in args.items():
        if value is None or value is False:
            continue
        flag = f"--{_kebab(key)}"
        if value is True:
            out.append(flag)
        else:
            out.extend([flag, str(value)])
    return out


def _run_tool(group: str, cmd: str | None, args: dict) -> dict:
    """Invoke chad-webui as a subprocess and return MCP content block."""
    if not shutil.which(CHAD_WEBUI) and not os.path.isfile(CHAD_WEBUI):
        return {
            "isError": True,
            "content": [{"type": "text", "text": f"chad-webui not found at {CHAD_WEBUI}"}],
        }
    cmd_argv = [CHAD_WEBUI, *_build_cli_args(group, cmd, args)]
    # Drop NODE_OPTIONS (it would try to --require .js into python3) and
    # restore the L7 outbound proxy env. The gateway's launch env (set by
    # chad-gateway-watchdog) doesn't include HTTPS_PROXY since the SSH
    # command bypasses /etc/environment, so urllib in chad-webui hits
    # "Errno 101 Network is unreachable" trying direct egress. The L7
    # OpenShell proxy at 10.200.0.1:3128 is the only outbound path.
    child_env = {k: v for k, v in os.environ.items() if k != "NODE_OPTIONS"}
    proxy = "http://10.200.0.1:3128"
    child_env.setdefault("HTTPS_PROXY", proxy)
    child_env.setdefault("HTTP_PROXY", proxy)
    child_env.setdefault("https_proxy", proxy)
    child_env.setdefault("http_proxy", proxy)
    child_env.setdefault("NO_PROXY", "localhost,127.0.0.1,::1,10.200.0.1")
    child_env.setdefault("no_proxy", "localhost,127.0.0.1,::1,10.200.0.1")
    # The L7 proxy MITMs TLS for hosts with l7_protocol="rest" (e.g.
    # chad.supachad.com) so it can inspect request bodies. Python urllib
    # then sees the proxy's CA-issued cert, not Cloudflare's. NODE_EXTRA_CA_CERTS
    # handles this for Node; for Python we point ssl/urllib at the same bundle.
    child_env.setdefault("SSL_CERT_FILE", "/etc/openshell-tls/ca-bundle.pem")
    child_env.setdefault("REQUESTS_CA_BUNDLE", "/etc/openshell-tls/ca-bundle.pem")
    try:
        proc = subprocess.run(
            cmd_argv, capture_output=True, text=True, timeout=60, env=child_env,
        )
    except subprocess.TimeoutExpired:
        return {
            "isError": True,
            "content": [{"type": "text", "text": "chad-webui timed out after 60s"}],
        }
    stdout = (proc.stdout or "").strip()
    stderr = (proc.stderr or "").strip()
    if proc.returncode != 0:
        msg = stderr or stdout or f"exit {proc.returncode}"
        return {
            "isError": True,
            "content": [{"type": "text", "text": msg}],
        }
    return {
        "isError": False,
        "content": [{"type": "text", "text": stdout or "(no output)"}],
    }


# ────────────────────────────────────────────────────────────────────
# JSON-RPC dispatch
# ────────────────────────────────────────────────────────────────────


def _send(msg: dict) -> None:
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


def _result(req_id, result) -> None:
    _send({"jsonrpc": "2.0", "id": req_id, "result": result})


def _error(req_id, code, message) -> None:
    _send({
        "jsonrpc": "2.0", "id": req_id,
        "error": {"code": code, "message": message},
    })


def handle(msg: dict) -> None:
    req_id = msg.get("id")
    method = msg.get("method")
    params = msg.get("params") or {}

    if method == "initialize":
        _result(req_id, {
            "protocolVersion": PROTOCOL_VERSION,
            "serverInfo": {"name": SERVER_NAME, "version": SERVER_VERSION},
            "capabilities": {"tools": {}},
        })
    elif method == "tools/list":
        tools = [
            {"name": name, "description": desc, "inputSchema": schema}
            for (name, _group, _cmd, schema, desc) in TOOLS
        ]
        _result(req_id, {"tools": tools})
    elif method == "tools/call":
        name = params.get("name") or ""
        args = params.get("arguments") or {}
        match = next(
            ((g, c) for (n, g, c, _s, _d) in TOOLS if n == name), None
        )
        if match is None:
            _error(req_id, -32601, f"unknown tool: {name}")
            return
        group, cmd = match
        _result(req_id, _run_tool(group, cmd, args))
    elif method == "notifications/initialized":
        # Just acknowledged silently per MCP spec — no response for notifications.
        return
    elif method == "shutdown":
        _result(req_id, None)
    elif method == "exit":
        sys.exit(0)
    else:
        if req_id is not None:
            _error(req_id, -32601, f"method not implemented: {method}")


def main() -> None:
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError as e:
            _error(None, -32700, f"parse error: {e}")
            continue
        try:
            handle(msg)
        except Exception as e:
            tb = traceback.format_exc()
            sys.stderr.write(f"chad-webui-mcp internal error: {e}\n{tb}\n")
            req_id = msg.get("id")
            if req_id is not None:
                _error(req_id, -32603, f"internal error: {e}")


if __name__ == "__main__":
    main()
