#
# Copy this file to .env (in the same directory) and fill in the blanks.
# scripts/openwebui-setup.sh reads it and writes back the tunnel token / id.
#
# .env is gitignored — never commit secrets.

# ── Mode ────────────────────────────────────────────────────────────
# tunnel = domain-backed managed tunnel + Cloudflare Access (production)
# quick  = ephemeral *.trycloudflare.com URL, no Access (testing only)
#
# Quick mode requires NO Cloudflare API token, account id, zone id, or
# domain. Just `bash scripts/openwebui-setup.sh --mode=quick` and
# open-webui's own email/password is the only auth. URL changes on
# every cloudflared restart.
WEBUI_MODE=tunnel

# In quick mode, ENABLE_SIGNUP=True for the very first launch lets you
# create the first admin account. Flip back to False after that.
# Tunnel mode keeps it False at all times — Cloudflare Access is the
# trust boundary, accounts auto-provision on first authenticated visit.
ENABLE_SIGNUP=False

# Set automatically by setup script. Leave blank.
WEBUI_AUTH_TRUSTED_EMAIL_HEADER=

# ── Domain ──────────────────────────────────────────────────────────
# A domain managed in Cloudflare DNS. Quick tunnels (*.trycloudflare.com)
# do NOT support Cloudflare Access, so a real domain is required.
CF_DOMAIN=
# Subdomain for the chat UI — full URL becomes <subdomain>.<domain>.
WEBUI_SUBDOMAIN=chad

# ── Admin allowlist ─────────────────────────────────────────────────
# Comma-separated emails. Cloudflare Access enforces — only listed emails
# can request the 6-digit OTP and reach the dashboard. open-webui's
# trusted-header SSO then auto-provisions or resumes the matching
# account on first authenticated visit (CF Access is the trust boundary;
# there is no second pending-approval queue inside open-webui).
#
# Tunnel mode requires at least one entry. Quick mode ignores this var.
# Re-running openwebui-setup.sh PATCHes the live Access policy, so this
# value is the single source of truth for who can sign in.
ADMIN_EMAILS=

# ── Cloudflare API ──────────────────────────────────────────────────
# Token scopes required:
#   - Zone.Zone:Read              (read zone id)
#   - Zone.DNS:Edit               (CNAME the subdomain to the tunnel)
#   - Account.Cloudflare Tunnel:Edit
#   - Account.Access: Apps and Policies:Edit
# Create at https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=
# Account id and zone id are visible in the Cloudflare dashboard sidebar.
CF_ACCOUNT_ID=
CF_ZONE_ID=

# ── Inference endpoint ──────────────────────────────────────────────
# Default: NemoClaw's local OpenAI-compat shim. Adjust to point at the
# K2.5 endpoint Chad uses (`openclaw agent --local` defaults to localhost).
# host.docker.internal resolves to the host gateway from inside the container.
OPENAI_API_BASE_URL=http://host.docker.internal:8000/v1
OPENAI_API_KEY=sk-no-key-required

# ── Tunnel state (auto-populated by openwebui-setup.sh) ─────────────
# Do not edit manually; setup writes these after creating the tunnel.
CF_TUNNEL_TOKEN=
CF_TUNNEL_ID=

# ── Cosmetics ───────────────────────────────────────────────────────
WEBUI_NAME=Chad
WEBUI_HOST_PORT=3000
# Defaults to ~/.nemoclaw/openwebui/data when blank.
WEBUI_DATA_DIR=

# ── Browser VM (browser-vm terminal bridge) ─────────────────────────
# Secret shared by the relay (RELAY_API_KEY/RELAY_WS_KEY) and the
# terminal-server connection key. Generate with: openssl rand -base64 48
# Must stay stable across container recreates, else the UI terminal and
# the loader stop authenticating.
BROWSER_VM_RELAY_KEY=
# Compose-internal name of the relay service; only change the scheme/host
# if you move the relay off the openwebui-net bridge.
BROWSER_VM_RELAY_URL=http://browser-vm-relay:8787
BROWSER_VM_LOG_VERBOSE=0
