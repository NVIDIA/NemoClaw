def cmd_health(args):
    """Pulls /api/version + a no-auth probe; useful when the chad sandbox can
    reach the box but you're not sure if auth or network is wrong."""
    creds = _creds()
    base = os.environ.get("OPENWEBUI_BASE_URL") or creds.get("OPENWEBUI_BASE_URL", DEFAULT_BASE)
    # /api/version is unauthed (mounted at /api, not /api/v1)
    version_url = base.rstrip("/").rsplit("/", 1)[0] + "/version"
    slug = os.environ.get("CHAD_OPERATOR_SLUG", "").strip().lower()
    per_op_key_name = (
        f"OPENWEBUI_API_KEY_{slug.upper().replace('-', '_').replace('.', '_')}" if slug else None
    )
    out = {
        "base": base,
        "version_url": version_url,
        "operator_slug": slug or None,
        "operator_email": os.environ.get("CHAD_OPERATOR_EMAIL") or None,
        "operator_role": os.environ.get("CHAD_OPERATOR_ROLE") or None,
        "selected_key": per_op_key_name if (per_op_key_name and creds.get(per_op_key_name)) else (
            "OPENWEBUI_API_KEY" if not slug else f"{per_op_key_name} (MISSING — would fail closed)"
        ),
        "has_api_key": bool(creds.get("OPENWEBUI_API_KEY")),
        "has_cf_access": bool(creds.get("CF_ACCESS_CLIENT_ID") and creds.get("CF_ACCESS_CLIENT_SECRET")),
    }
    headers = {"User-Agent": "chad-webui/0.1"}
    cf_id = creds.get("CF_ACCESS_CLIENT_ID")
    cf_secret = creds.get("CF_ACCESS_CLIENT_SECRET")
    if cf_id and cf_secret:
        headers["CF-Access-Client-Id"] = cf_id
        headers["CF-Access-Client-Secret"] = cf_secret
    try:
        req = urllib.request.Request(version_url, headers=headers)
        with urllib.request.urlopen(req, timeout=10) as resp:
            out["version_status"] = resp.status
            out["version_body"] = resp.read().decode("utf-8", errors="replace")[:300]
    except urllib.error.HTTPError as e:
        out["version_status"] = e.code
        out["version_body"] = e.read().decode("utf-8", errors="replace")[:300]
    except urllib.error.URLError as e:
        out["version_status"] = "network_error"
        out["version_body"] = str(e.reason)
    _print(out)


