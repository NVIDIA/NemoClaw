def cmd_models_create(args):
    # access_control: None (default) = public (every user sees the model).
    # Pass --access-control with an OpenWebUI ACL JSON
    #   {"read":{"group_ids":[...],"user_ids":[...]},"write":{...}}
    # to scope a model to specific users/groups (e.g. keep the powerful `chad`
    # model to operators while a Tier-0 model is public). See multi-user design.
    body = {
        "id": args.id,
        "base_model_id": args.base_model_id,
        "name": args.name,
        "params": json.loads(args.params) if args.params else {},
        "meta": json.loads(args.meta) if args.meta else {},
        "access_control": json.loads(args.access_control) if args.access_control else None,
    }
    _print(_http("POST", "/models/create", body=body))


def cmd_models_update(args):
    """Patch params/meta/name/access on a model row. id is required to identify."""
    body = {"id": args.id}
    if args.name is not None:
        body["name"] = args.name
    if args.params is not None:
        body["params"] = json.loads(args.params)
    if args.meta is not None:
        body["meta"] = json.loads(args.meta)
    if args.access_control is not None:
        body["access_control"] = json.loads(args.access_control) if args.access_control else None
