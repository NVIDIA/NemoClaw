def cmd_events_list(args):
    # Defaults: today through 14 days out. Helpful for "what's coming up".
    start = args.start or datetime.now(timezone.utc).date().isoformat()
    end = args.end or (datetime.now(timezone.utc).date().replace(day=1)).isoformat()
    if not args.end:
        # +14 days from start
        s_dt = datetime.fromisoformat(start if "T" in start else f"{start}T00:00:00+00:00")
        end = (s_dt + (datetime.fromtimestamp(s_dt.timestamp() + 14 * 86400, tz=timezone.utc) - s_dt)).isoformat()
    params = {"start": start, "end": end, "calendar_ids": args.calendar_ids}
    _print(_http("GET", "/calendars/events", params=params))


