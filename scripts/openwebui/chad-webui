from datetime import datetime, timezone

DEFAULT_CREDS = "/sandbox/.nemoclaw/credentials.json"
DEFAULT_BASE = "https://chad.supachad.com/api/v1"
SCHEDULED_TASKS_CALENDAR_ID = "__scheduled_tasks__"


# ─────────────────────────────────────────────────────────────────
# Plumbing
# ─────────────────────────────────────────────────────────────────


def _creds() -> dict:
    path = os.environ.get("CHAD_CREDENTIALS", DEFAULT_CREDS)
    try:
        with open(path) as fh:
            return json.load(fh)
    except FileNotFoundError:
        sys.stderr.write(f"chad-webui: credentials file not found: {path}\n")
        sys.exit(2)
    except json.JSONDecodeError as e:
        sys.stderr.write(f"chad-webui: credentials JSON invalid: {e}\n")
        sys.exit(2)


def _pick_api_key(creds: dict) -> str:
    """Select the OpenWebUI bearer key for this request.

    If CHAD_OPERATOR_SLUG is set (chad-shim sets it before launching
    `openclaw agent`), require OPENWEBUI_API_KEY_<SLUG.upper()> — fail
    closed rather than escalate to the default admin key. This is the
    enforcement layer that lets OpenWebUI's per-resource permission check
    contain a jailbroken or confused LLM: tjcooke chats use tjcooke's
    user-role key, so any cross-operator write returns 403 at the API
    even if Chad is talked into attempting it.

    Anonymous requests (no slug — direct curl, internal cron, etc.) fall
    back to OPENWEBUI_API_KEY. Set that to a low-privilege key if you
    want defense-in-depth for non-operator callers too."""
    slug = os.environ.get("CHAD_OPERATOR_SLUG", "").strip().lower()
    if slug:
        key_name = f"OPENWEBUI_API_KEY_{slug.upper().replace('-', '_').replace('.', '_')}"
        per_op = creds.get(key_name)
        if per_op:
            return per_op
        sys.stderr.write(
            f"chad-webui: refusing to use default key for operator {slug!r} — "
            f"missing {key_name} in credentials. Either add it or run without "
            f"CHAD_OPERATOR_SLUG to use the default key explicitly.\n"
        )
        sys.exit(3)
    default = creds.get("OPENWEBUI_API_KEY")
    if not default:
        sys.stderr.write("chad-webui: OPENWEBUI_API_KEY missing from credentials\n")
        sys.exit(2)
    return default


def _http(method: str, path: str, body: dict | None = None, params: dict | None = None) -> dict | list:
    creds = _creds()
    api_key = _pick_api_key(creds)

    base = os.environ.get("OPENWEBUI_BASE_URL") or creds.get("OPENWEBUI_BASE_URL", DEFAULT_BASE)
    url = f"{base.rstrip('/')}{path}"
    if params:
        filtered = {k: v for k, v in params.items() if v is not None}
        if filtered:
            url = f"{url}?{urllib.parse.urlencode(filtered)}"

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Accept": "application/json",
        "User-Agent": "chad-webui/0.1",
    }
    cf_id = creds.get("CF_ACCESS_CLIENT_ID")
    cf_secret = creds.get("CF_ACCESS_CLIENT_SECRET")
    if cf_id and cf_secret:
        headers["CF-Access-Client-Id"] = cf_id
        headers["CF-Access-Client-Secret"] = cf_secret

    data = None
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read().decode("utf-8")
            if not raw:
                return {}
            return json.loads(raw)
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", errors="replace")[:600]
        sys.stderr.write(f"chad-webui: HTTP {e.code} {e.reason} on {method} {path}\n{detail}\n")
        sys.exit(1)
    except urllib.error.URLError as e:
        sys.stderr.write(f"chad-webui: network error on {method} {url}: {e.reason}\n")
        sys.exit(1)


def _http_multipart(path: str, file_path: str) -> dict:
    """POST a single file as multipart/form-data. Used for files upload,
    which is the only chad-webui endpoint that doesn't accept JSON."""
    import mimetypes
    import uuid as _uuid

    creds = _creds()
    api_key = _pick_api_key(creds)
    base = os.environ.get("OPENWEBUI_BASE_URL") or creds.get("OPENWEBUI_BASE_URL", DEFAULT_BASE)
    url = f"{base.rstrip('/')}{path}"

    try:
        with open(file_path, "rb") as fh:
            file_bytes = fh.read()
    except OSError as e:
        sys.stderr.write(f"chad-webui: cannot read file {file_path!r}: {e}\n")
        sys.exit(2)

    filename = os.path.basename(file_path)
    content_type, _ = mimetypes.guess_type(filename)
    content_type = content_type or "application/octet-stream"

    boundary = f"----chadwebui{_uuid.uuid4().hex}"
    body_parts = [
        f"--{boundary}\r\n".encode(),
        f'Content-Disposition: form-data; name="file"; filename="{filename}"\r\n'.encode(),
        f"Content-Type: {content_type}\r\n\r\n".encode(),
        file_bytes,
        f"\r\n--{boundary}--\r\n".encode(),
    ]
    body = b"".join(body_parts)

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Accept": "application/json",
        "User-Agent": "chad-webui/0.2",
        "Content-Type": f"multipart/form-data; boundary={boundary}",
        "Content-Length": str(len(body)),
    }
    cf_id = creds.get("CF_ACCESS_CLIENT_ID")
    cf_secret = creds.get("CF_ACCESS_CLIENT_SECRET")
    if cf_id and cf_secret:
        headers["CF-Access-Client-Id"] = cf_id
        headers["CF-Access-Client-Secret"] = cf_secret

    req = urllib.request.Request(url, data=body, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            raw = resp.read().decode("utf-8")
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", errors="replace")[:600]
        sys.stderr.write(f"chad-webui: HTTP {e.code} {e.reason} on POST {path}\n{detail}\n")
        sys.exit(1)
    except urllib.error.URLError as e:
        sys.stderr.write(f"chad-webui: network error on POST {url}: {e.reason}\n")
        sys.exit(1)


def _print(payload) -> None:
    json.dump(payload, sys.stdout, indent=2, default=str)
    sys.stdout.write("\n")


def _iso_to_ns(s: str | None) -> int | None:
    """Accepts ISO 8601 (with or without trailing Z) or a bare YYYY-MM-DD.
    Returns nanoseconds-since-epoch as int, matching OpenWebUI's storage."""
    if s is None or s == "":
        return None
    text = s.strip()
    if "T" not in text and len(text) == 10:
        text = f"{text}T00:00:00+00:00"
    text = text.replace("Z", "+00:00")
    try:
        dt = datetime.fromisoformat(text)
    except ValueError as e:
        sys.stderr.write(f"chad-webui: cannot parse timestamp {s!r}: {e}\n")
        sys.exit(2)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return int(dt.timestamp() * 1_000_000_000)


def _ns_to_iso(ns: int | None) -> str | None:
    if not ns:
        return None
    return datetime.fromtimestamp(ns / 1_000_000_000, tz=timezone.utc).isoformat()


def _now_ns() -> int:
    return int(time.time() * 1_000_000_000)


