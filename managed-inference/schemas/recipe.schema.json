{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NVIDIA/NemoClaw/managed-inference/schemas/recipe.schema.json",
  "$comment": "SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\nSPDX-License-Identifier: Apache-2.0",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "nemoclaw.nvidia.com/managed-inference/v1" },
    "kind": { "const": "ServingRecipe" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["backend", "bindings", "model", "runtime", "execution", "serve", "readiness"],
      "properties": {
        "backend": { "const": "vllm" },
        "bindings": {
          "type": "object",
          "required": ["sparkTopology"],
          "properties": {
            "sparkTopology": {
              "type": "object",
              "required": ["type", "qualificationId", "schemaVersion", "outputSchema"],
              "properties": {
                "type": { "const": "topologyQualificationOutput" },
                "qualificationId": { "const": "dgx-spark.gb10.dual-cx7" },
                "schemaVersion": { "const": 1 },
                "outputSchema": { "const": "nemoclaw.nvidia.com/dual-spark-topology/v1" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "required": ["id", "revision", "servedName", "downloadSizeBytes", "preparationRef", "encodingPath"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
            "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "servedName": { "$ref": "#/$defs/stableId" },
            "downloadSizeBytes": { "type": "integer", "minimum": 1 },
            "preparationRef": { "const": "deepseek-v4-flash-0731/v1" },
            "encodingPath": { "const": "encoding/encoding_dsv4.py" }
          },
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "required": ["image", "imageDownloadSizeBytes", "architecture", "networkMode", "ipcMode", "sharedMemoryBytes", "devices", "environment"],
          "properties": {
            "image": { "type": "string", "pattern": "^[a-z0-9.-]+(?:/[a-z0-9._-]+)+@sha256:[0-9a-f]{64}$" },
            "imageDownloadSizeBytes": { "type": "integer", "minimum": 1 },
            "architecture": { "const": "arm64" },
            "networkMode": { "const": "host" },
            "ipcMode": { "const": "host" },
            "sharedMemoryBytes": { "type": "integer", "minimum": 1 },
            "devices": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^/dev/[A-Za-z0-9._/-]+$" }
            },
            "environment": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
              "additionalProperties": { "type": "string", "maxLength": 1024 }
            }
          },
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "required": ["materializerRef", "lifecycleRef", "topologyBinding", "nodeCount", "tensorParallelSize", "pipelineParallelSize", "distributedExecutorBackend"],
          "properties": {
            "materializerRef": { "const": "vllm.dual-dgx-spark/v1" },
            "lifecycleRef": { "const": "vllm.dual-dgx-spark/v1" },
            "topologyBinding": { "const": "sparkTopology" },
            "nodeCount": { "const": 2 },
            "tensorParallelSize": { "const": 2 },
            "pipelineParallelSize": { "const": 1 },
            "distributedExecutorBackend": { "const": "mp" }
          },
          "additionalProperties": false
        },
        "serve": {
          "type": "object",
          "required": ["authentication", "arguments"],
          "properties": {
            "authentication": { "const": "bearer" },
            "arguments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "pattern": "^--[a-z0-9]+(?:-[a-z0-9]+)*$" },
                  "value": { "type": ["string", "number", "boolean"] }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "readiness": {
          "type": "object",
          "required": ["timeoutSeconds", "expectedModel"],
          "properties": {
            "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
            "expectedModel": { "$ref": "#/$defs/stableId" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["id", "displayName"],
      "properties": {
        "id": { "const": "vllm.deepseek-v4-flash-0731.spark-dual.v1" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)+$",
      "maxLength": 160
    }
  }
}
