+    for variant in ["default", "low"] {
+        let name = format!("NemoClawHermesDesktop-{actual_sid}-{variant}");
+        require(name.len() < 240 && !name.contains('\\'), "desktop name exceeds owned contract")?;
+        let mut row = record.clone();
+        row["desktopName"] = json!(name); row["labelVariant"] = json!(variant);
+        let result = (|| -> Result<Option<PrivateDesktop>, String> {
+            let characters: Vec<u16> = name.encode_utf16().chain(Some(0)).collect();
+            let found = unsafe { OpenDesktopW(characters.as_ptr(), 0, 0, 0x0002_0000) };
+            if !found.is_null() {
+                let closed = unsafe { CloseDesktop(found) } != 0;
+                row["preexistingOpened"] = json!(true); row["preexistingHandleClosed"] = json!(closed);
