+    let actual_sid = sid(root_token.0, 31)?;
+    require(number(root_token.0, 29)? == 1 && actual_sid == expected_sid,
+        "desktop root differs from the actual owned AppContainer")?;
+    let host_token = token(unsafe { GetCurrentProcess() }, 8)?;
+    require(number(host_token.0, 29)? == 0, "desktop creator is not a host process")?;
+    let user = sid(host_token.0, 1)?;
