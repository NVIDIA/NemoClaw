+    let mut info = FileInfo::default();
+    if unsafe { GetFileInformationByHandle(owned.0, &mut info) } == 0 {
+        return Err(error("GetFileInformationByHandle/Hermes-descendant"));
+    }
+    require(
+        info.attributes & 0x400 == 0 && info.attributes & 0x10 != 0,
+        "Hermes writable descendant is not an ordinary directory",
+    )
