--- /dev/null
+++ b/src/backends/appcontainer/common/src/msys_token_inspection.rs
@@ -0,0 +1,433 @@
+// Copyright (c) NVIDIA Corporation.
+// Licensed under the MIT License.
+// CI-only exact-owned-job token inspection or explicitly selected TOKEN_QUERY repair.
+// The worker never grants process/job/filesystem rights or resumes a child.
+use std::os::windows::ffi::OsStrExt;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::thread::{self, JoinHandle};
+use windows::Win32::Foundation::{CloseHandle, DUPLICATE_HANDLE_OPTIONS, DuplicateHandle, HANDLE};
+use windows::Win32::Storage::FileSystem::{
+    BY_HANDLE_FILE_INFORMATION, CreateFileW, FILE_ATTRIBUTE_DIRECTORY,
+    FILE_ATTRIBUTE_REPARSE_POINT, FILE_FLAG_BACKUP_SEMANTICS, FILE_FLAG_OPEN_REPARSE_POINT,
+    FILE_READ_ATTRIBUTES, FILE_SHARE_READ, FILE_SHARE_WRITE, FILE_TRAVERSE,
+    GetFileInformationByHandle, OPEN_EXISTING,
+};
+use windows::Win32::System::Threading::{
+    GetCurrentProcess, PROCESS_QUERY_LIMITED_INFORMATION, PROCESS_SYNCHRONIZE,
+};
+use windows::core::PCWSTR;
+
+struct QueryHandle(HANDLE);
+impl QueryHandle {
+    fn get(&self) -> HANDLE {
+        self.0
+    }
+}
+// Each duplicate has exactly one owning thread and is never published to the
+// guest. Windows kernel handles are process-global, not thread-affine.
+unsafe impl Send for QueryHandle {}
+impl Drop for QueryHandle {
+    fn drop(&mut self) {
+        unsafe {
+            let _ = CloseHandle(self.0);
+        }
+    }
+}
+fn duplicate(source: HANDLE, rights: u32) -> Result<QueryHandle, String> {
+    let mut handle = HANDLE::default();
+    unsafe {
+        DuplicateHandle(
+            GetCurrentProcess(),
+            source,
+            GetCurrentProcess(),
+            &mut handle,
+            rights,
+            false,
+            DUPLICATE_HANDLE_OPTIONS(0),
+        )
+    }
+    .map_err(|error| format!("inspection handle duplication failed: {error}"))?;
+    Ok(QueryHandle(handle))
+}
+fn pin_directory(path: &Path) -> Result<QueryHandle, String> {
+    let wide: Vec<u16> = path.as_os_str().encode_wide().chain(Some(0)).collect();
+    let handle = unsafe {
+        CreateFileW(
+            PCWSTR(wide.as_ptr()),
+            FILE_READ_ATTRIBUTES.0 | FILE_TRAVERSE.0,
+            FILE_SHARE_READ | FILE_SHARE_WRITE,
+            None,
+            OPEN_EXISTING,
+            FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT,
+            None,
+        )
+    }
+    .map_err(|error| format!("inspection root open failed: {error}"))?;
+    let owned = QueryHandle(handle);
+    let mut info = BY_HANDLE_FILE_INFORMATION::default();
+    unsafe { GetFileInformationByHandle(handle, &mut info) }
+        .map_err(|error| format!("inspection root information failed: {error}"))?;
+    if info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT.0 != 0
+        || info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY.0 == 0
+    {
+        return Err("inspection root is not an ordinary directory".into());
+    }
+    Ok(owned)
+}
+fn trusted_root(cwd: &str, writable: &[String], container: &str) -> Result<PathBuf, String> {
+    // The host-owned request, not guest JSON, selects this only prototype root.
+    // Keep the containing drive root outside the guest writable capability.
+    let bytes = cwd.as_bytes();
+    let prefix = "\\NemoClawMsysProof-";
+    let role = ["start", "a", "b", "d"]
+        .into_iter()
+        .find(|role| container.ends_with(&format!("-{role}")))
+        .ok_or("Unexpected inspection role")?;
+    let suffix = format!("-state-{role}");
+    let valid = bytes.len() == 2 + prefix.len() + 12 + suffix.len()
+        && bytes[0].is_ascii_alphabetic()
+        && bytes[1] == b':'
+        && cwd[2..].starts_with(prefix)
+        && cwd.ends_with(&suffix)
+        && cwd.as_bytes()[2 + prefix.len()..2 + prefix.len() + 12]
+            .iter()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(byte));
+    if !valid || writable.len() != 1 || writable[0] != cwd {
+        return Err("inspection root differs from the host-owned prototype writable path".into());
+    }
+    if container.len() != 16 + role.len()
+        || !container.starts_with("nm-")
+        || !container.as_bytes()[3..15]
+            .iter()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(byte))
+    {
+        return Err("inspection container differs from the host-owned prototype identity".into());
+    }
+    Ok(PathBuf::from(cwd))
+}
+
+fn normalized_state_path(path: &str) -> Result<String, String> {
+    let path = path.replace('/', "\\");
+    let path = path.strip_suffix('\\').unwrap_or(&path);
+    let parts: Vec<_> = path.split('\\').collect();
+    if parts.len() < 2
+        || parts[0].len() != 2
+        || !parts[0].as_bytes()[0].is_ascii_alphabetic()
+        || parts[0].as_bytes()[1] != b':'
+        || parts[1..].iter().any(|part| {
+            part.is_empty()
+                || matches!(*part, "." | "..")
+                || part.ends_with(['.', ' '])
+                || part
+                    .chars()
+                    .any(|ch| ch.is_control() || "<>:\"|?*".contains(ch))
+        })
+    {
+        return Err("Hermes state path is not an unambiguous drive-root path".into());
+    }
+    Ok(path.to_ascii_lowercase())
+}
+
+fn installed_root(
+    cwd: &str,
+    writable: &[String],
+    expected: &str,
+) -> Result<(PathBuf, Vec<String>), String> {
+    let expected = normalized_state_path(expected)?;
+    if normalized_state_path(cwd)? != expected || writable.is_empty() {
+        return Err("Hermes state differs from the actual host account's leased root".into());
+    }
+    let prefix = format!("{expected}\\");
+    let mut descendants = Vec::new();
+    let mut root_present = false;
+    for entry in writable {
+        let path = normalized_state_path(entry)?;
+        if path == expected {
+            root_present = true;
+        } else if let Some(relative) = path.strip_prefix(&prefix) {
+            descendants.push(relative.to_owned());
+        } else {
+            return Err("Hermes writable capability is outside its leased state root".into());
+        }
+    }
+    if !root_present {
+        return Err("Hermes leased state root is not the writable owner".into());
+    }
+    Ok((PathBuf::from(cwd), descendants))
+}
+
+fn private_desktop_admission(
+    requested: Option<&str>,
+    github_actions: bool,
+    inspection: &str,
+    cwd: &str,
+    writable: &[String],
+    container: &str,
+    ui_disabled: bool,
+) -> Result<bool, String> {
+    let Some(value) = requested else { return Ok(false) };
+    if value != "1" || !github_actions || inspection != "repair-query" || ui_disabled
+        || !(container.ends_with("-start") || container.ends_with("-d"))
+    {
+        return Err("private desktop creation requires the explicit Hermes CI request".into());
+    }
+    trusted_root(cwd, writable, container)?;
+    Ok(true)
+}
+
+pub(crate) fn private_desktop_creation_requested(
+    cwd: &str, writable: &[String], container: &str, ui_disabled: bool,
+) -> Result<bool, String> {
+    let requested = std::env::var("NEMOCLAW_HERMES_PRIVATE_DESKTOP").ok();
+    let inspection = std::env::var("NEMOCLAW_MSYS_TOKEN_INSPECTION").unwrap_or_default();
+    if requested.as_deref() == Some("1") && inspection == "hermes-query" {
+        if ui_disabled {
+            return Err("installed Hermes desktop creation requires its UI-compatible policy".into());
+        }
+        // The dedicated gateway holds the runtime/state owners. Derive the
+        // account identity from the actual host token, never guest variables.
+        let (root, descendants) = installed_root(
+            cwd, writable, &crate::msys_token_readback::host_hermes_root()?,
+        )?;
+        let directory = pin_directory(&root)?;
+        for relative in &descendants {
+            crate::msys_token_readback::verify_owned_descendant(directory.get(), relative)?;
+        }
+        return Ok(true);
+    }
+    let selected = private_desktop_admission(
+        requested.as_deref(),
+        std::env::var("GITHUB_ACTIONS").as_deref() == Ok("true"),
+        &inspection,
+        cwd, writable, container, ui_disabled,
+    )?;
+    if selected {
+        // Prove the already host-selected state is an ordinary owned directory
+        // before any child is created. Guest environment is not consulted.
+        let _root = pin_directory(Path::new(cwd))?;
+    }
+    Ok(selected)
+}
+
+pub(crate) fn read_private_desktop_mask(job: HANDLE) -> Result<u32, String> {
+    use windows::Win32::System::JobObjects::{
+        QueryInformationJobObject, JobObjectBasicUIRestrictions,
+        JOBOBJECT_BASIC_UI_RESTRICTIONS,
+    };
+    let mut actual = JOBOBJECT_BASIC_UI_RESTRICTIONS::default();
+    unsafe {
+        QueryInformationJobObject(
+            Some(job), JobObjectBasicUIRestrictions,
+            &mut actual as *mut _ as *mut std::ffi::c_void,
+            std::mem::size_of_val(&actual) as u32, None,
+        )
+    }.map_err(|error| format!("job UI readback failed: {error}"))?;
+    Ok(actual.UIRestrictionsClass.0)
+}
+
+pub(crate) fn verify_private_desktop_mask(job: HANDLE, before: u32) -> Result<(), String> {
+    let after = read_private_desktop_mask(job)?;
+    let record = serde_json::json!({
+        "schemaVersion":1, "classification":"admitted-Hermes-desktop-creation",
+        "beforeMask":before, "afterMask":after, "removedMask":before ^ after,
+        "bundledCreateAndSwitch":true, "logoutRestrictionPreserved":after & 0x80 != 0,
+        "everyOtherUiBitPreserved":after == before & !0x40,
+        "hostDesktopGrantsAdded":false, "childResumed":false
+    });
+    eprintln!("NEMOCLAW_HERMES_DESKTOP_MASK={record}");
+    if before & 0xc0 != 0xc0 || after != before & !0x40 {
+        return Err("effective job UI mask did not preserve every other restriction".into());
+    }
+    Ok(())
+}
+
+pub(crate) fn root_image_layout_requested(
+    cwd: &str,
+    writable: &[String],
+    container: &str,
+) -> Result<bool, String> {
+    match std::env::var("NEMOCLAW_MSYS_IMAGE_LAYOUT") {
+        Err(std::env::VarError::NotPresent) => return Ok(false),
+        Ok(value) if value == "preferred" => (),
+        _ => return Err("invalid host MSYS image-layout opt-in".into()),
+    }
+    // The unmodified negative baseline must retain its original root policy.
+    if container.ends_with("-base") {
+        return Ok(false);
+    }
+    if std::env::var("GITHUB_ACTIONS").as_deref() != Ok("true")
+        || std::env::var("NEMOCLAW_MSYS_TOKEN_INSPECTION").as_deref() != Ok("repair-query")
+    {
+        return Err("MSYS root image placement requires the opted-in CI prototype".into());
+    }
+    trusted_root(cwd, writable, container)?;
+    Ok(true)
+}
+
+// PROCESS_CREATION_MITIGATION_POLICY_FORCE_RELOCATE_IMAGES_ALWAYS_OFF.
+// Other mitigation choices remain at the original caller-selected values.
+pub(crate) const ROOT_IMAGE_PLACEMENT: u64 = 0x0000_0000_0000_0200;
+
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    #[link_name = "GetProcessMitigationPolicy"]
+    fn query_aslr_policy(
+        process: *mut std::ffi::c_void,
+        policy: i32,
+        buffer: *mut std::ffi::c_void,
+        length: usize,
+    ) -> i32;
+}
+
+fn effective_aslr(process: HANDLE) -> (bool, u32, i32) {
+    // ProcessASLRPolicy is1; its Windows policy structure is a single DWORD.
+    let mut flags: u32 = 0;
+    let known = unsafe {
+        query_aslr_policy(
+            process.0,
+            1,
+            &mut flags as *mut _ as *mut _,
+            size_of::<u32>(),
+        )
+    } != 0;
+    let error = if known {
+        0
+    } else {
+        std::io::Error::last_os_error().raw_os_error().unwrap_or(0)
+    };
+    (known, flags, error)
+}
+
+pub(crate) fn log_root_image_layout(root_process: HANDLE, root_pid: u32, policy: u64) {
+    let host = effective_aslr(unsafe { GetCurrentProcess() });
+    let root = effective_aslr(root_process);
+    let record = serde_json::json!({
+        "schemaVersion":1, "classification":"initial-MXC-canonical-Bash-image-layout",
+        "creationPolicy":format!("0x{policy:016x}"), "rootPid":root_pid,
+        "hostAslrKnown":host.0, "hostAslrFlags":host.1, "hostAslrError":host.2,
+        "rootAslrKnown":root.0, "rootAslrFlags":root.1, "rootAslrError":root.2,
+        "rootResumed":false
+    });
+    eprintln!("NEMOCLAW_MSYS_ROOT_IMAGE_LAYOUT={record}");
+}
+
+fn diagnostic_desktop_requested(private_desktop: bool, container: &str) -> bool {
+    private_desktop && (container.ends_with("-d") || container.ends_with("-start"))
+        && std::env::var("GITHUB_ACTIONS").as_deref() == Ok("true")
+        && std::env::var("NEMOCLAW_MSYS_TOKEN_INSPECTION").as_deref() == Ok("repair-query")
+}
+
+pub(crate) struct OwnerGuard {
+    stop: Arc<AtomicBool>,
+    worker: Option<JoinHandle<()>>,
+    // The runner terminates/drains before its fields drop. Primary handles
+    // close first; this Drop joins the observer (releasing query duplicates)
+    // before the desktop vector drops and performs its actual absence check.
+    _desktops: Vec<crate::msys_token_readback::PrivateDesktop>,
+}
+impl OwnerGuard {
+    pub(crate) fn has_desktops(&self) -> bool { !self._desktops.is_empty() }
+}
+impl Drop for OwnerGuard {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Release);
+        if let Some(worker) = self.worker.take() {
+            if worker.join().is_err() {
+                eprintln!(
+                    "NEMOCLAW_MSYS_HOST_TOKEN_INSPECTION={{\"status\":\"owner-thread-panicked\"}}"
+                );
+            }
+        }
+    }
+}
+
+pub(crate) fn start_if_requested(
+    cwd: &str,
+    writable: &[String],
+    container: &str,
+    expected_sid: &str,
+    job: HANDLE,
+    root_process: HANDLE,
+    private_desktop: bool,
+) -> Result<Option<OwnerGuard>, String> {
+    let (repair, installed) = match std::env::var("NEMOCLAW_MSYS_TOKEN_INSPECTION") {
+        Err(std::env::VarError::NotPresent) => return Ok(None),
+        Ok(value) if value == "1" => (false, false),
+        Ok(value) if value == "repair-query" => (true, false),
+        Ok(value) if value == "hermes-query" => (true, true),
+        _ => return Err("invalid host token-inspection opt-in".into()),
+    };
+    if !installed && (container.ends_with("-base") || (!repair && !container.ends_with("-start"))) {
+        return Ok(None);
+    }
+    let (root, descendants) = if installed {
+        // This environment belongs to the dedicated host Hermes gateway. The
+        // installed caller holds both runtime and native-state leases; guest
+        // environment/request text never selects the host account or job.
+        installed_root(
+            cwd,
+            writable,
+            &crate::msys_token_readback::host_hermes_root()?,
+        )?
+    } else {
+        (trusted_root(cwd, writable, container)?, Vec::new())
+    };
+    if !expected_sid.starts_with("S-1-15-2-") || expected_sid.len() > 184 {
+        return Err("inspection expected AppContainer identity is invalid".into());
+    }
+    let directory = pin_directory(&root)?;
+    for relative in &descendants {
+        crate::msys_token_readback::verify_owned_descendant(directory.get(), relative)?;
+    }
+    // The installed gateway holds the runtime/state leases. Its actual account
+    // root is pinned and every writable descendant has been validated above.
+    // Reuse the same owned desktops; the explicit CI admission is unchanged.
+    let desktops = if (private_desktop && installed)
+        || diagnostic_desktop_requested(private_desktop, container) {
+        crate::msys_token_readback::prepare_private_desktops(job, root_process, expected_sid)?
+    } else { Vec::new() };
+    // JOB_OBJECT_QUERY only; never assign, terminate, or set attributes.
+    let job = duplicate(job, 0x0004)?;
+    let process = duplicate(
+        root_process,
+        PROCESS_QUERY_LIMITED_INFORMATION.0 | PROCESS_SYNCHRONIZE.0,
+    )?;
+    let sid = expected_sid.to_owned();
+    let stop = Arc::new(AtomicBool::new(false));
+    let thread_stop = stop.clone();
+    let worker = thread::Builder::new()
+        .name("mxc-msys-token-inspection".into())
+        .spawn(move || {
+            let answer = crate::msys_token_readback::inspect(
+                &root,
+                directory.get(),
+                job.get(),
+                process.get(),
+                &sid,
+                repair,
+                &thread_stop,
+            );
+            let result = match answer {
+                Ok(value) => value,
+                Err(error) => serde_json::json!({"status":"inspection-failed","error":error}),
+            };
+            // Host-owned output enters the already retained executor stderr. The
+            // guest receives only a synchronization acknowledgement, no token data.
+            match serde_json::to_string(&result) {
+                Ok(line) if line.len() <= 16 * 1024 => {
+                    eprintln!("NEMOCLAW_MSYS_HOST_TOKEN_INSPECTION={line}")
+                }
+                _ => {
+                    eprintln!("NEMOCLAW_MSYS_HOST_TOKEN_INSPECTION={{\"status\":\"result-bound\"}}")
+                }
+            }
+        })
+        .map_err(|error| format!("inspection owner thread start failed: {error}"))?;
+    Ok(Some(OwnerGuard {
+        stop,
+        worker: Some(worker),
+        _desktops: desktops,
+    }))
+}
