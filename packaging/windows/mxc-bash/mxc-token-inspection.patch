+pub(super) fn verify_owned_descendant(root: HANDLE, relative: &str) -> Result<(), String> {
+    // Only normalized host policy descendants reach this check. Resolve from
+    // the already retained root, rejecting reparse traversal at any component.
+    let characters: Vec<u16> = relative.encode_utf16().collect();
+    require(
+        !characters.is_empty() && characters.len() <= 32766,
+        "Hermes descendant path exceeds bound",
+    )?;
+    let name = UnicodeName {
+        length: (characters.len() * 2) as u16,
+        maximum_length: (characters.len() * 2) as u16,
+        buffer: characters.as_ptr(),
+    };
+    let attributes = ObjectAttributes {
+        length: size_of::<ObjectAttributes>() as u32,
+        root: root.0,
+        name: &name,
+        attributes: 0x1040,
+        security: std::ptr::null(),
+        quality: std::ptr::null(),
+    };
+    let mut handle = std::ptr::null_mut();
+    let mut io = IoStatus::default();
+    let status = unsafe {
+        NtCreateFile(
+            &mut handle,
+            0x0010_0080,
+            &attributes,
+            &mut io,
+            std::ptr::null(),
+            0,
+            3,
+            1,
+            0x0020_0021,
+            std::ptr::null(),
+            0,
+        )
+    };
+    require(
+        status == 0 && !handle.is_null(),
+        &format!("Hermes descendant open: NTSTATUS 0x{:08x}", status as u32),
+    )?;
