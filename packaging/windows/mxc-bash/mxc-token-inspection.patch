+        Ok(value) => value,
+        Err(error) => {
+            record["stage"] = json!("desktop-descriptor"); record["error"] = json!(error);
+            eprintln!("NEMOCLAW_HERMES_DESKTOP={record}"); return Ok(Vec::new());
+        }
