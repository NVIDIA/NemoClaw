+fn desktop_name(handle: RawHandle) -> Result<String, String> {
+    let mut name = [0u16; 256];
+    let mut needed = 0;
+    require(unsafe { GetUserObjectInformationW(handle, 2, name.as_mut_ptr().cast(), 512, &mut needed) } != 0,
+        &error("GetUserObjectInformationW name"))?;
+    require(needed >= 2 && needed <= 512 && needed % 2 == 0, "desktop object name size differs")?;
+    let end = name[..needed as usize / 2].iter().position(|c| *c == 0).ok_or("desktop object name not terminated")?;
+    String::from_utf16(&name[..end]).map_err(|_| "desktop object name encoding differs".into())
+}
+fn desktop_security(handle: RawHandle, information: u32) -> Result<Vec<u64>, String> {
+    let mut bytes = vec![0u64; 512];
+    let mut needed = 0;
+    let mut requested = information;
+    require(unsafe { GetUserObjectSecurity(handle, &mut requested, bytes.as_mut_ptr().cast(), 4096, &mut needed) } != 0,
+        &error("GetUserObjectSecurity"))?;
+    require(needed >= 20 && needed <= 4096, "desktop descriptor size exceeds bound")?;
+    require(unsafe { IsValidSecurityDescriptor(bytes.as_ptr().cast()) } != 0,
+        "desktop descriptor invalid")?;
+    let actual = unsafe { GetSecurityDescriptorLength(bytes.as_ptr().cast()) };
+    require(actual >= 20 && actual <= needed, "desktop descriptor length differs")?;
+    bytes.truncate((needed as usize + 7) / 8);
+    Ok(bytes)
+}
+fn desktop_hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+fn desktop_acl_hex(acl: RawHandle) -> Result<String, String> {
+    require(!acl.is_null(), "NULL desktop DACL is not adapted")?;
+    let head = unsafe { std::slice::from_raw_parts(acl.cast::<u8>(), 8) };
+    let size = u16::from_le_bytes([head[2], head[3]]) as usize;
+    require(size >= 8 && size <= 4096, "desktop ACL exceeds bound")?;
+    let bytes = unsafe { std::slice::from_raw_parts(acl.cast::<u8>(), size) };
+    let count = u16::from_le_bytes([head[4], head[5]]);
+    let mut used = 8usize;
+    for _ in 0..count {
+        require(used + 4 <= size, "desktop ACE header exceeds ACL")?;
+        let length = u16::from_le_bytes([bytes[used + 2], bytes[used + 3]]) as usize;
+        require(length >= 4 && used + length <= size, "desktop ACE exceeds ACL")?;
+        used += length;
+    }
+    // Do not record unused allocation slack after the last ACE.
+    Ok(desktop_hex(&bytes[..used]))
+}
+fn desktop_merge(acl: RawHandle, sid: &str, mask: u32, mode: u32) -> Result<DesktopAllocation, String> {
+    let mut bytes = sid_bytes(sid)?;
+    let access = DesktopAccess { mask, mode, inheritance: 0, trustee: DesktopTrustee {
+        multiple: std::ptr::null_mut(), operation: 0, form: 0, kind: 0, sid: bytes.as_mut_ptr().cast(),
+    }};
+    let mut output = std::ptr::null_mut();
+    let status = unsafe { SetEntriesInAclW(1, &access, acl, &mut output) };
+    if status != 0 || output.is_null() {
+        if !output.is_null() { unsafe { LocalFree(output); } }
+        return Err(format!("SetEntriesInAclW: Win32 {status}; outputPresent={}", !output.is_null()));
+    }
+    Ok(DesktopAllocation(output))
