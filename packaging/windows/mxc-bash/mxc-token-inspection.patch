+pub(crate) fn desktop_teardown_snapshot(job: HANDLE, root: HANDLE) {
+    let mut accounting = DesktopJobAccounting::default();
+    let mut needed = 0;
+    let queried = unsafe { QueryInformationJobObject(job.0, 1,
+        (&mut accounting as *mut DesktopJobAccounting).cast(), size_of::<DesktopJobAccounting>() as u32,
+        &mut needed) } != 0;
