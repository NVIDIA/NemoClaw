+fn sid(token: RawHandle, class: u32) -> Result<String, String> {
+    // Query directly into the final local array: token SID pointers refer to
+    // this exact output allocation and must not survive a copied return value.
+    let mut data = [0usize; 512];
+    let mut needed = 0;
+    if unsafe {
+        GetTokenInformation(
+            token,
+            class,
+            data.as_mut_ptr().cast(),
+            std::mem::size_of_val(&data) as u32,
+            &mut needed,
+        )
+    } == 0
+    {
+        return Err(error(&format!("GetTokenInformation/SID/{class}")));
+    }
+    let begin = data.as_ptr() as usize;
+    let end = begin
+        .checked_add(needed as usize)
+        .ok_or("SID output overflow")?;
+    require(
+        needed as usize >= std::mem::size_of::<usize>()
+            && needed as usize <= std::mem::size_of_val(&data),
+        "SID output size invalid",
+    )?;
+    let pointer = data[0];
+    require(
+        pointer >= begin + std::mem::size_of::<usize>()
+            && pointer.checked_add(8).is_some_and(|n| n <= end),
+        "SID pointer outside token output",
+    )?;
+    let header = unsafe { std::slice::from_raw_parts(pointer as *const u8, 8) };
+    let length = 8 + usize::from(header[1]) * 4;
+    require(
+        header[0] == 1 && header[1] <= 15 && pointer.checked_add(length).is_some_and(|n| n <= end),
+        "SID body outside token output",
+    )?;
+    let bytes = unsafe { std::slice::from_raw_parts(pointer as *const u8, length) };
+    let authority = bytes[2..8]
+        .iter()
+        .fold(0u64, |value, byte| (value << 8) | u64::from(*byte));
+    let mut text = format!("S-1-{authority}");
+    for part in bytes[8..].chunks_exact(4) {
+        text.push_str(&format!(
+            "-{}",
+            u32::from_le_bytes(part.try_into().unwrap())
+        ));
+    }
+    Ok(text)
