+    let elevation_type = number(host_token.0, 18);
+    let host_session = number(host_token.0, 12);
+    let root_session = number(root_token.0, 12);
+    let host_integrity = sid(host_token.0, 25);
+    let root_integrity = sid(root_token.0, 25);
+    let station = unsafe { GetProcessWindowStation() };
+    let desktop = unsafe { GetThreadDesktop(GetCurrentThreadId()) };
+    let station_name = desktop_name(station);
+    let current_desktop = desktop_name(desktop);
+    let mut record = json!({"schemaVersion":1,"classification":"owned-Hermes-desktop",
+        "stage":"prepare","rootPid":unsafe { GetProcessId(root_process.0) },
+        "actualJobAndAppContainerBound":true,"appContainerSid":actual_sid,
+        "hostUserSid":user,"hostTokenElevation":elevated.as_ref().ok(),
+        "hostTokenElevationError":elevated.as_ref().err(),"hostTokenElevationType":elevation_type.as_ref().ok(),
+        "hostTokenElevationTypeError":elevation_type.as_ref().err(),
+        "hostSession":host_session.as_ref().ok(),"rootSession":root_session.as_ref().ok(),
+        "hostSessionError":host_session.as_ref().err(),"rootSessionError":root_session.as_ref().err(),
+        "hostIntegritySid":host_integrity.as_ref().ok(),"rootIntegritySid":root_integrity.as_ref().ok(),
+        "stationName":station_name.as_ref().ok(),"currentDesktopName":current_desktop.as_ref().ok(),
+        "stationNameError":station_name.as_ref().err(),"currentDesktopNameError":current_desktop.as_ref().err(),
+        "childStartupDesktop":"winsta0\\default","hostDesktopSelected":false,
+        "requestedAccess":0x000e_0083u32,"inheritHandle":false,
+        "existingObjectSecurityChanged":false,"unelevatedSupportQualified":false});
+    // appcontainer_runner uses winsta0\default. No host station/thread switch is
+    // permitted here; an unexpected service/desktop context remains diagnostic.
+    let context_matches = station_name.as_ref().is_ok_and(|v| v.eq_ignore_ascii_case("WinSta0"))
+        && current_desktop.as_ref().is_ok_and(|v| v.eq_ignore_ascii_case("Default"))
+        && host_session.is_ok() && host_session.as_ref().ok() == root_session.as_ref().ok();
+    record["contextMatched"] = json!(context_matches);
+    if !context_matches {
+        record["stage"] = json!("host-context");
+        eprintln!("NEMOCLAW_HERMES_DESKTOP={record}");
+        return Ok(Vec::new());
+    }
+    let prepared = (|| -> Result<(Vec<u64>, DesktopAllocation, DesktopAllocation, u16), String> {
+        let baseline = desktop_security(desktop, 4)?;
+        let mut present = 0;
+        let mut defaulted = 0;
+        let mut acl = std::ptr::null_mut();
+        require(unsafe { GetSecurityDescriptorDacl(baseline.as_ptr().cast(), &mut present, &mut acl, &mut defaulted) } != 0,
+            &error("GetSecurityDescriptorDacl"))?;
+        require(present != 0 && !acl.is_null(), "Absent/NULL current desktop DACL is not adapted")?;
+        record["baselineDaclHex"] = json!(desktop_acl_hex(acl)?);
+        // Chrome window.cc applies this exact RestrictedCode reduction to the
+        // copied current DACL. Preserve all baseline principals/ACE semantics;
+        // then add only the exact admitted AppContainer desktop access.
+        let reduced = desktop_merge(acl, "S-1-5-12", 0x000d_013e, 3)?;
+        record["restrictedCodeReducedDaclHex"] = json!(desktop_acl_hex(reduced.0)?);
+        let granted = desktop_merge(reduced.0, &actual_sid, 0x000e_0083, 1)?;
+        record["newDesktopDaclHex"] = json!(desktop_acl_hex(granted.0)?);
+        record["changes"] = json!([{"sid":"S-1-5-12","mode":"DENY_ACCESS","mask":0x000d_013eu32},
+            {"sid":actual_sid,"mode":"GRANT_ACCESS","mask":0x000e_0083u32}]);
+        let mut control = 0;
+        let mut revision = 0;
+        require(unsafe { GetSecurityDescriptorControl(baseline.as_ptr().cast(), &mut control, &mut revision) } != 0,
+            &error("GetSecurityDescriptorControl"))?;
+        Ok((baseline, reduced, granted, control))
