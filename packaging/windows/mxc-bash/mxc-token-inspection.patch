+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+// Disposable Windows CI inspection and explicit exact-TOKEN_QUERY repair.
+// No token contents, default DACL, privileges, process rights or resume operation change.
+use serde_json::{Value, json};
+use std::ffi::c_void;
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Duration;
+use windows::Win32::Foundation::HANDLE;
+
+type RawHandle = *mut c_void;
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+struct FileTime {
+    low: u32,
+    high: u32,
+}
+#[repr(C)]
+#[derive(Default)]
+struct FileInfo {
+    attributes: u32,
+    creation: FileTime,
+    access: FileTime,
+    write: FileTime,
+    volume: u32,
+    size_high: u32,
+    size_low: u32,
+    links: u32,
+    index_high: u32,
+    index_low: u32,
+}
+#[repr(C)]
+#[derive(Default)]
+struct ProcessBasic {
+    reserved: usize,
+    peb: usize,
+    reserved2: [usize; 2],
+    pid: usize,
+    parent_pid: usize,
+}
+#[repr(C)]
+struct UnicodeName {
+    length: u16,
+    maximum_length: u16,
+    buffer: *const u16,
+}
+#[repr(C)]
+struct ObjectAttributes {
+    length: u32,
+    root: RawHandle,
+    name: *const UnicodeName,
+    attributes: u32,
+    security: *const c_void,
+    quality: *const c_void,
+}
+#[repr(C)]
+#[derive(Default)]
+struct IoStatus {
+    status: usize,
+    information: usize,
+}
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn GetLastError() -> u32;
+    fn GetModuleHandleW(name: *const u16) -> RawHandle;
+    fn GetProcAddress(module: RawHandle, name: *const u8) -> *const c_void;
+    fn CloseHandle(handle: RawHandle) -> i32;
+    fn GetFileInformationByHandle(handle: RawHandle, info: *mut FileInfo) -> i32;
+    fn ReadFile(
+        handle: RawHandle,
+        bytes: *mut u8,
+        count: u32,
+        read: *mut u32,
+        overlapped: *mut c_void,
+    ) -> i32;
+    fn WriteFile(
+        handle: RawHandle,
+        bytes: *const u8,
+        count: u32,
+        written: *mut u32,
+        overlapped: *mut c_void,
+    ) -> i32;
+    fn OpenProcess(access: u32, inherit: i32, pid: u32) -> RawHandle;
+    fn GetProcessId(process: RawHandle) -> u32;
+    fn GetProcessTimes(
+        process: RawHandle,
+        creation: *mut FileTime,
+        exit: *mut FileTime,
+        kernel: *mut FileTime,
+        user: *mut FileTime,
+    ) -> i32;
+    fn IsProcessInJob(process: RawHandle, job: RawHandle, result: *mut i32) -> i32;
+    fn QueryInformationJobObject(
+        job: RawHandle,
+        class: u32,
+        output: *mut c_void,
+        bytes: u32,
+        needed: *mut u32,
+    ) -> i32;
+    fn WaitForSingleObject(handle: RawHandle, milliseconds: u32) -> u32;
+}
+#[link(name = "advapi32")]
+unsafe extern "system" {
+    fn OpenProcessToken(process: RawHandle, access: u32, token: *mut RawHandle) -> i32;
+    fn GetTokenInformation(
+        token: RawHandle,
+        class: u32,
+        output: *mut c_void,
+        bytes: u32,
+        needed: *mut u32,
+    ) -> i32;
+    fn GetKernelObjectSecurity(
+        object: RawHandle,
+        information: u32,
+        output: *mut c_void,
+        bytes: u32,
+        needed: *mut u32,
+    ) -> i32;
+    fn IsValidSecurityDescriptor(descriptor: *const c_void) -> i32;
+    fn GetSecurityDescriptorLength(descriptor: *const c_void) -> u32;
+    fn InitializeSecurityDescriptor(descriptor: *mut c_void, revision: u32) -> i32;
+    fn SetSecurityDescriptorDacl(
+        descriptor: *mut c_void,
+        present: i32,
+        acl: *const c_void,
+        defaulted: i32,
+    ) -> i32;
+    fn SetKernelObjectSecurity(
+        object: RawHandle,
+        information: u32,
+        descriptor: *const c_void,
+    ) -> i32;
+}
+#[link(name = "ntdll")]
+unsafe extern "system" {
+    fn NtQueryInformationProcess(
+        process: RawHandle,
+        class: u32,
+        output: *mut ProcessBasic,
+        bytes: u32,
+        needed: *mut u32,
+    ) -> i32;
+    fn NtCreateFile(
+        output: *mut RawHandle,
+        access: u32,
+        attributes: *const ObjectAttributes,
+        io: *mut IoStatus,
+        allocation: *const i64,
+        file_attributes: u32,
+        share: u32,
+        disposition: u32,
+        options: u32,
+        ea: *const c_void,
+        ea_bytes: u32,
+    ) -> i32;
+}
+
+struct Owned(RawHandle);
+impl Drop for Owned {
+    fn drop(&mut self) {
+        unsafe {
+            CloseHandle(self.0);
+        }
+    }
+}
+fn error(stage: &str) -> String {
+    format!("{stage}: Win32 {}", unsafe { GetLastError() })
+}
+fn require(value: bool, reason: &str) -> Result<(), String> {
+    if value {
+        Ok(())
+    } else {
+        Err(reason.to_owned())
+    }
+}
+fn relative_file(root: RawHandle, reply: bool) -> Result<Option<Owned>, String> {
+    let name = if reply {
+        "msys-token-inspection.ack"
+    } else {
+        "msys-token-inspection.request"
+    };
+    let characters: Vec<u16> = name.encode_utf16().collect();
+    let unicode = UnicodeName {
+        length: (characters.len() * 2) as u16,
+        maximum_length: (characters.len() * 2) as u16,
+        buffer: characters.as_ptr(),
+    };
+    let attributes = ObjectAttributes {
+        length: std::mem::size_of::<ObjectAttributes>() as u32,
+        root,
+        name: &unicode,
+        attributes: 0x1040,
+        security: std::ptr::null(),
+        quality: std::ptr::null(),
+    };
+    let mut handle = std::ptr::null_mut();
+    let mut io = IoStatus::default();
+    // Fixed relative leaf under the retained directory object, OBJ_DONT_REPARSE,
+    // FILE_OPEN_REPARSE_POINT|NON_DIRECTORY|SYNCHRONOUS_IO_NONALERT.
+    let status = unsafe {
+        NtCreateFile(
+            &mut handle,
+            if reply { 0x4010_0000 } else { 0x8010_0000 },
+            &attributes,
+            &mut io,
+            std::ptr::null(),
+            0x80,
+            // Exclude writers and deletion while the request's metadata and
+            // bytes are checked. Guest cleanup retries sharing within its
+            // existing budget; it cannot retire the file during this read.
+            1,
+            if reply { 2 } else { 1 },
+            0x0020_0060,
+            std::ptr::null(),
+            0,
+        )
+    };
+    if !reply && matches!(status as u32, 0xc0000034 | 0xc0000043 | 0xc0000056) {
+        return Ok(None);
+    }
+    require(
+        status == 0 && !handle.is_null(),
+        &format!(
+            "NtCreateFile/fixed-relative-inspection-leaf: NTSTATUS 0x{:08x}",
+            status as u32
+        ),
+    )?;
+    Ok(Some(Owned(handle)))
+}
+fn created(process: RawHandle) -> Result<u64, String> {
+    let (mut start, mut end, mut kernel, mut user) = (
+        FileTime::default(),
+        FileTime::default(),
+        FileTime::default(),
+        FileTime::default(),
+    );
+    if unsafe { GetProcessTimes(process, &mut start, &mut end, &mut kernel, &mut user) } == 0 {
+        return Err(error("GetProcessTimes"));
+    }
+    Ok((u64::from(start.high) << 32) | u64::from(start.low))
+}
+fn member(process: RawHandle, job: RawHandle) -> Result<(), String> {
+    let mut yes = 0;
+    if unsafe { IsProcessInJob(process, job, &mut yes) } == 0 {
+        return Err(error("IsProcessInJob/exact-job"));
+    }
+    require(
+        yes != 0 && unsafe { WaitForSingleObject(process, 0) } == 258,
+        "Expected live member of the retained MXC job",
+    )
+}
+fn candidate_members(job: RawHandle, parent: u32, child: u32) -> Result<(), String> {
+    let mut data = [0usize; 257];
+    let mut needed = 0;
+    if unsafe {
+        QueryInformationJobObject(
+            job,
+            3,
+            data.as_mut_ptr().cast(),
+            std::mem::size_of_val(&data) as u32,
+            &mut needed,
+        )
+    } == 0
+    {
+        return Err(error("QueryInformationJobObject/owned-process-list"));
+    }
+    let counts = unsafe { std::slice::from_raw_parts(data.as_ptr().cast::<u32>(), 2) };
+    require(
+        counts[0] == counts[1] && counts[1] > 0 && counts[1] <= 256,
+        "Retained job process list exceeded its bound",
+    )?;
+    let members = &data[1..=counts[1] as usize];
+    require(
+        members.contains(&(parent as usize)) && members.contains(&(child as usize)),
+        "Candidate PID is not in retained job process list",
+    )
+}
+fn process(pid: u32) -> Result<Owned, String> {
+    // QUERY_INFORMATION is needed for the kernel parent-generation check;
+    // SYNCHRONIZE proves liveness. No process/token write or resume right.
+    let handle = unsafe { OpenProcess(0x0010_0400, 0, pid) };
+    if handle.is_null() {
+        Err(error("OpenProcess/query-and-synchronize"))
+    } else {
+        Ok(Owned(handle))
+    }
+}
+fn token(process: RawHandle, access: u32) -> Result<Owned, String> {
+    let mut handle = std::ptr::null_mut();
+    if unsafe { OpenProcessToken(process, access, &mut handle) } == 0 {
+        Err(error("OpenProcessToken/host-readback"))
+    } else {
+        Ok(Owned(handle))
+    }
+}
+fn info(token: RawHandle, class: u32) -> Result<([usize; 512], usize), String> {
+    let mut storage = [0usize; 512];
+    let mut needed = 0;
+    if unsafe {
+        GetTokenInformation(
+            token,
+            class,
+            storage.as_mut_ptr().cast(),
+            std::mem::size_of_val(&storage) as u32,
+            &mut needed,
+        )
+    } == 0
+    {
+        return Err(error(&format!("GetTokenInformation/{class}")));
+    }
+    require(
+        needed > 0 && needed as usize <= std::mem::size_of_val(&storage),
+        "Token information exceeded its fixed bound",
+    )?;
+    Ok((storage, needed as usize))
+}
+fn number(token: RawHandle, class: u32) -> Result<u32, String> {
+    let (data, size) = info(token, class)?;
+    require(size == 4, "Token scalar has another size")?;
+    Ok(data[0] as u32)
+}
+fn sid(token: RawHandle, class: u32) -> Result<String, String> {
+    // Query directly into the final local array: token SID pointers refer to
+    // this exact output allocation and must not survive a copied return value.
+    let mut data = [0usize; 512];
+    let mut needed = 0;
+    if unsafe {
+        GetTokenInformation(
+            token,
+            class,
+            data.as_mut_ptr().cast(),
+            std::mem::size_of_val(&data) as u32,
+            &mut needed,
+        )
+    } == 0
+    {
+        return Err(error(&format!("GetTokenInformation/SID/{class}")));
+    }
+    let begin = data.as_ptr() as usize;
+    let end = begin
+        .checked_add(needed as usize)
+        .ok_or("SID output overflow")?;
+    require(
+        needed as usize >= std::mem::size_of::<usize>()
+            && needed as usize <= std::mem::size_of_val(&data),
+        "SID output size invalid",
+    )?;
+    let pointer = data[0];
+    require(
+        pointer >= begin + std::mem::size_of::<usize>()
+            && pointer.checked_add(8).is_some_and(|n| n <= end),
+        "SID pointer outside token output",
+    )?;
+    let header = unsafe { std::slice::from_raw_parts(pointer as *const u8, 8) };
+    let length = 8 + usize::from(header[1]) * 4;
+    require(
+        header[0] == 1 && header[1] <= 15 && pointer.checked_add(length).is_some_and(|n| n <= end),
+        "SID body outside token output",
+    )?;
+    let bytes = unsafe { std::slice::from_raw_parts(pointer as *const u8, length) };
+    let authority = bytes[2..8]
+        .iter()
+        .fold(0u64, |value, byte| (value << 8) | u64::from(*byte));
+    let mut text = format!("S-1-{authority}");
+    for part in bytes[8..].chunks_exact(4) {
+        text.push_str(&format!(
+            "-{}",
+            u32::from_le_bytes(part.try_into().unwrap())
+        ));
+    }
+    Ok(text)
+}
+// An exact token-object DACL adaptation. These pure byte helpers deliberately
+// accept only the observed three allow ACEs (or that exact postimage).
+fn word(bytes: &[u8], offset: usize) -> Result<u16, String> {
+    let value = bytes
+        .get(offset..offset + 2)
+        .ok_or("DACL word out of bounds")?;
+    Ok(u16::from_le_bytes(value.try_into().unwrap()))
+}
+fn dword(bytes: &[u8], offset: usize) -> Result<u32, String> {
+    let value = bytes
+        .get(offset..offset + 4)
+        .ok_or("DACL dword out of bounds")?;
+    Ok(u32::from_le_bytes(value.try_into().unwrap()))
+}
+fn sid_bytes(text: &str) -> Result<Vec<u8>, String> {
+    let fields: Vec<_> = text.split('-').collect();
+    require(
+        fields.len() >= 4 && fields.len() <= 18 && fields[0] == "S" && fields[1] == "1",
+        "SID text shape differs",
+    )?;
+    let authority: u64 = fields[2].parse().map_err(|_| "SID authority invalid")?;
+    require(authority < (1u64 << 48), "SID authority exceeds bound")?;
+    let mut bytes = vec![1, (fields.len() - 3) as u8];
+    bytes.extend_from_slice(&authority.to_be_bytes()[2..]);
+    for part in &fields[3..] {
+        bytes.extend_from_slice(
+            &part
+                .parse::<u32>()
+                .map_err(|_| "SID component invalid")?
+                .to_le_bytes(),
+        );
+    }
+    Ok(bytes)
+}
+fn sid_at(bytes: &[u8], offset: usize) -> Result<&[u8], String> {
+    let header = bytes
+        .get(offset..offset + 8)
+        .ok_or("SID header out of bounds")?;
+    require(header[0] == 1 && header[1] <= 15, "SID header differs")?;
+    bytes
+        .get(offset..offset + 8 + usize::from(header[1]) * 4)
+        .ok_or("SID body out of bounds".into())
+}
+fn query_descriptor(
+    before: &[u8],
+    user: &[u8],
+    group: &[u8],
+    container: &[u8],
+) -> Result<(Vec<u8>, bool), String> {
+    require(
+        before.len() >= 28
+            && before.len() <= 4096
+            && before[0] == 1
+            && before[1] == 0
+            && word(before, 2)? == 0x8004,
+        "Token descriptor control differs from observed default",
+    )?;
+    require(dword(before, 12)? == 0, "Unexpected token SACL offset")?;
+    let owner_at = dword(before, 4)? as usize;
+    let group_at = dword(before, 8)? as usize;
+    let acl_at = dword(before, 16)? as usize;
+    require(
+        owner_at == 20
+            && group_at == owner_at + user.len()
+            && acl_at == group_at + group.len()
+            && sid_at(before, owner_at)? == user
+            && sid_at(before, group_at)? == group,
+        "Token descriptor owner/group differs from actual token",
+    )?;
+    require(
+        owner_at + user.len() <= acl_at && group_at + group.len() <= acl_at,
+        "Token owner/group overlaps DACL",
+    )?;
+    let acl = before.get(acl_at..).ok_or("Token DACL offset invalid")?;
+    let count = word(acl, 4)?;
+    require(
+        acl.len() >= 8
+            && acl[0] == 2
+            && acl[1] == 0
+            && word(acl, 6)? == 0
+            && usize::from(word(acl, 2)?) == acl.len()
+            && (count == 3 || count == 4),
+        "Token DACL header differs from observed default",
+    )?;
+    let admin = sid_bytes("S-1-5-32-544")?;
+    let system = sid_bytes("S-1-5-18")?;
+    let mut at = 8;
+    for (index, expected) in [user, admin.as_slice(), system.as_slice(), container]
+        .iter()
+        .take(usize::from(count))
+        .enumerate()
+    {
+        let ace = acl.get(at..).ok_or("Token ACE offset invalid")?;
+        let size = usize::from(word(ace, 2)?);
+        require(
+            ace[0] == 0
+                && ace[1] == 0
+                && size == 8 + expected.len()
+                && dword(ace, 4)? == if index == 3 { 8 } else { 0x000f01ff }
+                && sid_at(ace, 8)? == *expected,
+            "Token ACE differs from exact user/Admin/System/query template",
+        )?;
+        at += size;
+    }
+    require(
+        at == acl.len(),
+        "Token DACL contains trailing or additional ACE bytes",
+    )?;
+    if count == 4 {
+        return Ok((before.to_vec(), false));
+    }
+    let ace_size = 8 + container.len();
+    let next_size = acl.len() + ace_size;
+    require(
+        next_size <= u16::MAX as usize && before.len() + ace_size <= 4096,
+        "AppContainer query ACE exceeds fixed bound",
+    )?;
+    let mut after = before.to_vec();
+    after[acl_at + 2..acl_at + 4].copy_from_slice(&(next_size as u16).to_le_bytes());
+    after[acl_at + 4..acl_at + 6].copy_from_slice(&4u16.to_le_bytes());
+    after.extend_from_slice(&[0, 0]);
+    after.extend_from_slice(&(ace_size as u16).to_le_bytes());
+    after.extend_from_slice(&8u32.to_le_bytes());
+    after.extend_from_slice(container);
+    Ok((after, true))
+}
+fn descriptor(token: RawHandle) -> Result<Vec<u8>, String> {
+    let mut storage = [0usize; 512];
+    let mut needed = 0;
+    if unsafe {
+        GetKernelObjectSecurity(
+            token,
+            7,
+            storage.as_mut_ptr().cast(),
+            std::mem::size_of_val(&storage) as u32,
+            &mut needed,
+        )
+    } == 0
+    {
+        return Err(error("GetKernelObjectSecurity/token"));
+    }
+    require(
+        needed >= 20 && needed as usize <= std::mem::size_of_val(&storage),
+        "Token descriptor result exceeds bound",
+    )?;
+    require(
+        unsafe { IsValidSecurityDescriptor(storage.as_ptr().cast()) } != 0,
+        "Token descriptor invalid",
+    )?;
+    let size = unsafe { GetSecurityDescriptorLength(storage.as_ptr().cast()) } as usize;
+    require(
+        size >= 20 && size == needed as usize,
+        "Token descriptor length differs",
+    )?;
+    Ok(unsafe { std::slice::from_raw_parts(storage.as_ptr().cast::<u8>(), size) }.to_vec())
+}
+fn default_dacl(token: RawHandle) -> Result<Option<Vec<u8>>, String> {
+    let mut storage = [0usize; 512];
+    let mut needed = 0;
+    if unsafe {
+        GetTokenInformation(
+            token,
+            6,
+            storage.as_mut_ptr().cast(),
+            std::mem::size_of_val(&storage) as u32,
+            &mut needed,
+        )
+    } == 0
+    {
+        return Err(error("GetTokenInformation/TokenDefaultDacl"));
+    }
+    require(
+        needed as usize >= std::mem::size_of::<usize>()
+            && needed as usize <= std::mem::size_of_val(&storage),
+        "Default DACL result exceeds bound",
+    )?;
+    if storage[0] == 0 {
+        return Ok(None);
+    }
+    let base = storage.as_ptr() as usize;
+    let end = base + needed as usize;
+    let pointer = storage[0];
+    require(
+        pointer >= base + std::mem::size_of::<usize>()
+            && pointer.checked_add(8).is_some_and(|value| value <= end),
+        "Default DACL pointer out of bounds",
+    )?;
+    let header = unsafe { std::slice::from_raw_parts(pointer as *const u8, 8) };
+    let size = usize::from(word(header, 2)?);
+    require(
+        size >= 8 && pointer.checked_add(size).is_some_and(|value| value <= end),
+        "Default DACL bytes out of bounds",
+    )?;
+    Ok(Some(
+        unsafe { std::slice::from_raw_parts(pointer as *const u8, size) }.to_vec(),
+    ))
+}
+fn statistics(token: RawHandle) -> Result<Vec<u8>, String> {
+    let (storage, count) = info(token, 10)?;
+    require(count == 56, "TokenStatistics fixed structure differs")?;
+    Ok(unsafe { std::slice::from_raw_parts(storage.as_ptr().cast::<u8>(), count) }.to_vec())
+}
+fn same_token(left: RawHandle, right: RawHandle) -> Result<(), String> {
+    type Compare = unsafe extern "system" fn(RawHandle, RawHandle) -> i32;
+    let module_name: Vec<u16> = "kernelbase.dll".encode_utf16().chain(Some(0)).collect();
+    let module = unsafe { GetModuleHandleW(module_name.as_ptr()) };
+    require(!module.is_null(), "KernelBase module missing")?;
+    let pointer = unsafe { GetProcAddress(module, b"CompareObjectHandles\0".as_ptr()) };
+    require(!pointer.is_null(), "CompareObjectHandles unavailable")?;
+    let compare: Compare = unsafe { std::mem::transmute(pointer) };
+    require(
+        unsafe { compare(left, right) } != 0,
+        "Additional handle refers to another token object",
+    )
+}
+fn repair_query(
+    child: RawHandle,
+    parent: RawHandle,
+    root_process: RawHandle,
+    job: RawHandle,
+    child_time: u64,
+    parent_time: u64,
+    held_token: RawHandle,
+    expected_sid: &str,
+    stop: &AtomicBool,
+    record: &mut Value,
+) -> Result<(), String> {
+    let before = descriptor(held_token)?;
+    let user = sid_bytes(&sid(held_token, 1)?)?;
+    let group = sid_bytes(&sid(held_token, 5)?)?;
+    let container = sid_bytes(expected_sid)?;
+    let (after, needs_write) = query_descriptor(&before, &user, &group, &container)?;
+    let default_before = default_dacl(held_token)?;
+    let stats_before = statistics(held_token)?;
+    record["repairScope"] = json!("actual-AppContainer-SID/TOKEN_QUERY-only");
+    record["repairRequestedAccess"] = json!("0x00000008");
+    if needs_write {
+        // The only additional right is WRITE_DAC, after full read-only
+        // identity/template acceptance. Both handles must name the same object.
+        let writer = token(child, 0x0004_0000)?;
+        same_token(held_token, writer.0)?;
+        let current_primary = token(child, 8)?;
+        same_token(held_token, current_primary.0)?;
+        require(
+            !stop.load(Ordering::Acquire),
+            "Owner stopped before token DACL write",
+        )?;
+        member(root_process, job)?;
+        member(parent, job)?;
+        member(child, job)?;
+        require(
+            created(parent)? == parent_time && created(child)? == child_time,
+            "Owned generations changed before token DACL write",
+        )?;
+        require(
+            number(held_token, 29)? == 1
+                && number(held_token, 8)? == 1
+                && sid(held_token, 31)? == expected_sid,
+            "Token identity changed before DACL write",
+        )?;
+        require(
+            descriptor(held_token)? == before
+                && statistics(held_token)? == stats_before
+                && default_dacl(held_token)? == default_before,
+            "Token changed after read-only acceptance",
+        )?;
+        let acl_at = dword(&after, 16)? as usize;
+        let mut acl = [0usize; 512];
+        let aligned = unsafe {
+            std::slice::from_raw_parts_mut(
+                acl.as_mut_ptr().cast::<u8>(),
+                std::mem::size_of_val(&acl),
+            )
+        };
+        aligned[..after.len() - acl_at].copy_from_slice(&after[acl_at..]);
+        let mut sd = [0usize; 8];
+        if unsafe { InitializeSecurityDescriptor(sd.as_mut_ptr().cast(), 1) } == 0
+            || unsafe {
+                SetSecurityDescriptorDacl(sd.as_mut_ptr().cast(), 1, acl.as_ptr().cast(), 0)
+            } == 0
+        {
+            return Err(error("Build query-only DACL descriptor"));
+        }
+        if unsafe { SetKernelObjectSecurity(writer.0, 4, sd.as_ptr().cast()) } == 0 {
+            return Err(error("SetKernelObjectSecurity/DACL-only"));
+        }
+        record["tokenMutated"] = json!(true);
+        record["additionalTokenHandleAccess"] = json!("0x00040000");
+    }
+    let observed = descriptor(held_token)?;
+    require(
+        observed == after,
+        "Token DACL postimage differs from exact query-only append",
+    )?;
+    require(
+        statistics(held_token)? == stats_before && default_dacl(held_token)? == default_before,
+        "Token contents/default DACL changed",
+    )?;
+    let current_primary = token(child, 8)?;
+    same_token(held_token, current_primary.0)?;
+    member(parent, job)?;
+    member(child, job)?;
+    require(
+        created(parent)? == parent_time
+            && created(child)? == child_time
+            && number(held_token, 29)? == 1
+            && number(held_token, 8)? == 1
+            && sid(held_token, 31)? == expected_sid,
+        "Owned token identity changed after DACL write",
+    )?;
+    record["tokenDescriptorBeforeHex"] = json!(
+        before
+            .iter()
+            .map(|byte| format!("{byte:02x}"))
+            .collect::<String>()
+    );
+    record["tokenDescriptorAfterHex"] = json!(
+        observed
+            .iter()
+            .map(|byte| format!("{byte:02x}"))
+            .collect::<String>()
+    );
+    record["exactTokenObjectPreserved"] = json!(true);
+    record["tokenStatisticsUnchanged"] = json!(true);
+    record["tokenDefaultDaclUnchanged"] = json!(true);
+    record["tokenOwnerGroupAndOldAcesPreserved"] = json!(true);
+    record["repairVerified"] = json!(true);
+    record["status"] = json!(if needs_write {
+        "query-ace-appended-and-verified"
+    } else {
+        "query-ace-already-exact"
+    });
+    Ok(())
+}
+
+fn parse_frame(bytes: &[u8]) -> Result<[u64; 4], String> {
+    require(
+        !bytes.is_empty() && bytes.len() <= 128,
+        "Inspection request size invalid",
+    )?;
+    let text = std::str::from_utf8(bytes).map_err(|_| "Inspection request is not ASCII")?;
+    let text = text
+        .strip_suffix('\n')
+        .ok_or("Inspection request terminator missing")?;
+    require(
+        text.bytes().all(|c| c.is_ascii_digit() || c == b' '),
+        "Inspection request grammar invalid",
+    )?;
+    let fields: Vec<_> = text.split(' ').collect();
+    require(
+        fields.len() == 5 && fields[0] == "1",
+        "Inspection request field count invalid",
+    )?;
+    let mut result = [0u64; 4];
+    for (out, field) in result.iter_mut().zip(&fields[1..]) {
+        *out = field
+            .parse()
+            .map_err(|_| "Inspection request integer invalid")?;
+    }
+    require(
+        result[0] > 0
+            && result[0] <= u32::MAX as u64
+            && result[2] > 0
+            && result[2] <= u32::MAX as u64
+            && result[0] != result[2]
+            && result[1] > 0
+            && result[3] > 0,
+        "Inspection request identity invalid",
+    )?;
+    Ok(result)
+}
+fn request(root: RawHandle) -> Result<Option<[u64; 4]>, String> {
+    let Some(handle) = relative_file(root, false)? else {
+        return Ok(None);
+    };
+    let mut metadata = FileInfo::default();
+    if unsafe { GetFileInformationByHandle(handle.0, &mut metadata) } == 0 {
+        return Err(error("GetFileInformationByHandle/request"));
+    }
+    require(
+        metadata.attributes & (0x10 | 0x400) == 0
+            && metadata.links == 1
+            && metadata.size_high == 0
+            && metadata.size_low > 0
+            && metadata.size_low <= 128,
+        &format!(
+            "Inspection request is not a bounded ordinary single-link file: attributes=0x{:08x}, links={}, sizeHigh={}, sizeLow={}",
+            metadata.attributes, metadata.links, metadata.size_high, metadata.size_low
+        ),
+    )?;
+    let mut bytes = [0u8; 128];
+    let mut count = 0;
+    if unsafe {
+        ReadFile(
+            handle.0,
+            bytes.as_mut_ptr(),
+            metadata.size_low,
+            &mut count,
+            std::ptr::null_mut(),
+        )
+    } == 0
+    {
+        return Err(error("ReadFile/request"));
+    }
+    require(
+        count == metadata.size_low,
+        "Inspection request changed while held",
+    )?;
+    Ok(Some(parse_frame(&bytes[..count as usize])?))
+}
+fn acknowledge(
+    root: RawHandle,
+    frame: &[u64; 4],
+    repair: bool,
+    verified: bool,
+) -> Result<(), String> {
+    let text = if repair {
+        format!(
+            "1 {} {} {} {} {}\n",
+            frame[0],
+            frame[1],
+            frame[2],
+            frame[3],
+            if verified { "verified" } else { "failed" }
+        )
+    } else {
+        "inspected\n".to_owned()
+    };
+    let handle = relative_file(root, true)?.ok_or("Inspection acknowledgement was not created")?;
+    let mut count = 0;
+    if unsafe {
+        WriteFile(
+            handle.0,
+            text.as_ptr(),
+            text.len() as u32,
+            &mut count,
+            std::ptr::null_mut(),
+        )
+    } == 0
+    {
+        return Err(error("WriteFile/inspection-ack"));
+    }
+    require(
+        count as usize == text.len(),
+        "Inspection acknowledgement incomplete",
+    )
+}
+
+pub(super) fn inspect(
+    _request_root: &Path,
+    request_directory: HANDLE,
+    job: HANDLE,
+    root_process: HANDLE,
+    expected_appcontainer_sid: &str,
+    repair: bool,
+    stop: &AtomicBool,
+) -> Result<Value, String> {
+    let mut previous = None;
+    let mut processed = 0u64;
+    let mut failed = 0u64;
+    let mut emitted = 0u32;
+    let mut last_failure = None;
+    loop {
+        if !repair && processed >= 1 {
+            return Ok(
+                json!({"status":"owner-request-bound","requestsProcessed":processed,"repairMode":repair}),
+            );
+        }
+        let candidate = loop {
+            if stop.load(Ordering::Acquire)
+                || (repair && unsafe { WaitForSingleObject(root_process.0, 0) } != 258)
+            {
+                return Ok(
+                    json!({"status":"owner-stopped","requestsProcessed":processed,"requestsFailed":failed,
+                        "diagnosticsEmitted":emitted,"lastFailure":last_failure,"repairMode":repair,"lifetimeRepair":repair}),
+                );
+            }
+            let request = match request(request_directory.0) {
+                Ok(value) => value,
+                Err(error) if repair => {
+                    return Ok(json!({"status":"inspection-failed","error":error,
+                        "requestsProcessed":processed,"requestsFailed":failed,
+                        "diagnosticsEmitted":emitted,"lastFailure":last_failure,
+                        "repairMode":repair,"lifetimeRepair":true}));
+                }
+                Err(error) => return Err(error),
+            };
+            if let Some(value) = request {
+                if previous != Some(value) {
+                    break value;
+                }
+            }
+            std::thread::sleep(Duration::from_millis(10));
+        };
+        processed = processed.saturating_add(1);
+        previous = Some(candidate);
+        let [parent_pid, parent_time, child_pid, child_time] = candidate;
+        let mut record = json!({"schemaVersion":1,"classification":"owned-MXC-child-token-readback","status":"failed","parentPid":parent_pid,"parentCreationFiletime":parent_time.to_string(),"childPid":child_pid,"childCreationFiletime":child_time.to_string(),"tokenMutated":false,"childResumed":false});
+        let result = (|| -> Result<(), String> {
+            member(root_process.0, job.0)?;
+            let root_time = created(root_process.0)?;
+            require(
+                root_time <= parent_time && parent_time <= child_time,
+                "Candidate generation predates retained root/parent",
+            )?;
+            let root_token = token(root_process.0, 8)?;
+            require(
+                number(root_token.0, 29)? == 1
+                    && sid(root_token.0, 31)? == expected_appcontainer_sid,
+                "Retained root token differs from actual MXC profile",
+            )?;
+            candidate_members(job.0, parent_pid as u32, child_pid as u32)?;
+            let parent = process(parent_pid as u32)?;
+            let child = process(child_pid as u32)?;
+            member(parent.0, job.0)?;
+            member(child.0, job.0)?;
+            require(
+                created(parent.0)? == parent_time && created(child.0)? == child_time,
+                "Requested PID generation was replaced",
+            )?;
+            let mut basic = ProcessBasic::default();
+            let mut needed = 0;
+            let status = unsafe {
+                NtQueryInformationProcess(
+                    child.0,
+                    0,
+                    &mut basic,
+                    std::mem::size_of_val(&basic) as u32,
+                    &mut needed,
+                )
+            };
+            require(
+                status == 0,
+                &format!(
+                    "NtQueryInformationProcess/parent: NTSTATUS 0x{:08x}",
+                    status as u32
+                ),
+            )?;
+            require(
+                basic.pid == child_pid as usize && basic.parent_pid == parent_pid as usize,
+                "Child is not the kernel-recorded child of the held parent",
+            )?;
+            record["rootPid"] = json!(unsafe { GetProcessId(root_process.0) });
+            record["exactJobAndGenerationsBound"] = json!(true);
+            let parent_token = token(parent.0, 8)?;
+            require(
+                number(parent_token.0, 29)? == 1
+                    && sid(parent_token.0, 31)? == expected_appcontainer_sid,
+                "Held parent token differs from actual MXC profile",
+            )?;
+            // TOKEN_QUERY|READ_CONTROL only; never WRITE_DAC, ADJUST, DUPLICATE,
+            // ASSIGN_PRIMARY or an enabled privilege.
+            record["childTokenRequestedAccess"] = json!("0x00020008");
+            let child_token = token(child.0, 0x0002_0008)?;
+            let app = number(child_token.0, 29)?;
+            record["tokenIsAppContainer"] = json!(app);
+            require(app == 1, "Actual child token is not an AppContainer")?;
+            let actual_sid = sid(child_token.0, 31)?;
+            record["appContainerSid"] = json!(actual_sid);
+            require(
+                actual_sid == expected_appcontainer_sid,
+                "Actual child token differs from actual MXC profile",
+            )?;
+            record["tokenSession"] = json!(number(child_token.0, 12)?);
+            record["tokenType"] = json!(number(child_token.0, 8)?);
+            record["integritySid"] = json!(sid(child_token.0, 25)?);
+            let bytes = descriptor(child_token.0)?;
+            record["tokenDescriptorSecurityInformation"] = json!(7);
+            record["tokenDescriptorBytes"] = json!(bytes.len());
+            record["tokenDescriptorHex"] = json!(
+                bytes
+                    .iter()
+                    .map(|byte| format!("{byte:02x}"))
+                    .collect::<String>()
+            );
+            member(child.0, job.0)?;
+            require(
+                created(child.0)? == child_time,
+                "Child changed during readback",
+            )?;
+            if repair {
+                require(!stop.load(Ordering::Acquire), "Owner stopped before repair")?;
+                member(root_process.0, job.0)?;
+                require(
+                    number(child_token.0, 8)? == 1 && sid(child_token.0, 25)? == "S-1-16-4096",
+                    "Repair requires the observed primary low-integrity token",
+                )?;
+                require(
+                    number(child_token.0, 12)? == number(root_token.0, 12)?
+                        && number(child_token.0, 12)? == number(parent_token.0, 12)?,
+                    "Repair token session differs from owned root/parent",
+                )?;
+                require(
+                    sid(child_token.0, 1)? == sid(root_token.0, 1)?
+                        && sid(child_token.0, 1)? == sid(parent_token.0, 1)?,
+                    "Repair token user differs from owned root/parent",
+                )?;
+                repair_query(
+                    child.0,
+                    parent.0,
+                    root_process.0,
+                    job.0,
+                    child_time,
+                    parent_time,
+                    child_token.0,
+                    expected_appcontainer_sid,
+                    stop,
+                    &mut record,
+                )?;
+            } else {
+                record["status"] = json!("inspected-read-only");
+            }
+            Ok(())
+        })();
+        if let Err(reason) = result {
+            record["error"] = json!(reason);
+        }
+        record["repairMode"] = json!(repair);
+        // An exact matching acknowledgement only permits an independent contained
+        // token/SID/job recheck; it is never itself admission or a resume command.
+        let verified = repair
+            && record.get("repairVerified") == Some(&json!(true))
+            && record.get("error").is_none();
+        if repair {
+            let encoded = serde_json::to_string(&record).map_err(|error| error.to_string())?;
+            require(
+                encoded.len() <= 15 * 1024,
+                "Repair diagnostic exceeds fixed bound before acknowledgement",
+            )?;
+        }
+        if let Err(reason) = acknowledge(request_directory.0, &candidate, repair, verified) {
+            record["acknowledgementError"] = json!(reason);
+        }
+        if !repair {
+            return Ok(record);
+        }
+        let encoded = serde_json::to_string(&record).map_err(|error| error.to_string())?;
+        require(
+            encoded.len() <= 16 * 1024,
+            "Repair diagnostic exceeds fixed bound",
+        )?;
+        if !verified || record.get("acknowledgementError").is_some() {
+            failed = failed.saturating_add(1);
+            last_failure = Some(record.clone());
+        }
+        // Repair service follows the retained job's lifetime, rather than
+        // exhausting a fork count. Detail storage remains bounded per owner.
+        if !repair || emitted < 32 {
+            eprintln!("NEMOCLAW_MSYS_HOST_TOKEN_INSPECTION={encoded}");
+            emitted = emitted.saturating_add(1);
+        }
+    }
+}
