<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef SystemDriveMetadataPreparation ?>
  <?define SystemDriveMetadataPreparation = "false" ?>
  <?endif ?>
  <?ifndef RuntimeImageFinalization ?>
  <?define RuntimeImageFinalization = "false" ?>
  <?endif ?>
  <Bundle
    Name="NemoClaw"
    Manufacturer="NVIDIA Corporation"
    Version="$(var.ProductVersion)"
    UpgradeCode="1BA739B8-B632-4A8C-BB02-95058CC3A960"
    IconSourceFile="$(var.SourceRoot)\packaging\windows\assets\NemoClaw.ico"
    AboutUrl="https://github.com/NVIDIA/NemoClaw"
    Copyright="Copyright (c) 2026 NVIDIA Corporation and affiliates">
    <BootstrapperApplication SourceFile="$(var.BootstrapperPath)">
      <PayloadGroupRef Id="NemoClawBootstrapperPayloads" />
      <Payload Name="NemoClaw.MxcProbe.exe" SourceFile="$(var.WxcExecPath)" />
    </BootstrapperApplication>
    <Variable Name="NemoClawPreparationAttempt" Type="string" Value="" />
    <!-- Keep transactional rollback; omit the separate per-install OS restore point. -->
    <Chain DisableSystemRestore="yes">
      <?if $(var.SystemDriveMetadataPreparation) = "true" ?>
      <!-- Enable only after this exact helper has passed system-root and MXC
           launch qualification. The null-device prerequisite stays upstream. -->
      <ExePackage
        Id="MxcSystemDrivePreparation"
        CacheId="NemoClawSystemDriveMetadata-$(var.SystemDrivePrepSha256)"
        Name="mxc\NemoClawHostPreparation.exe"
        SourceFile="$(var.SystemDrivePrepPath)"
        InstallArguments="prepare-system-drive --diagnostic-log &quot;[WixBundleLog].host-preparation-[NemoClawPreparationAttempt].json&quot; --diagnostic-id [NemoClawPreparationAttempt]"
        PerMachine="yes"
        Permanent="yes"
        Compressed="yes"
        Vital="yes" />
      <?else ?>
      <ExePackage
        Id="MxcSystemDrivePreparation"
        CacheId="MxcSystemDrivePreparation-0.8.0-arm64"
        Name="mxc\wxc-host-prep-system-drive.exe"
        SourceFile="$(var.WxcHostPrepPath)"
        InstallArguments="prepare-system-drive"
        PerMachine="yes"
        Permanent="yes"
        Compressed="yes"
        Vital="yes" />
      <?endif ?>
      <ExePackage
        Id="MxcNullDevicePreparation"
        CacheId="MxcNullDevicePreparation-0.8.0-arm64"
        Name="mxc\wxc-host-prep-null-device.exe"
        SourceFile="$(var.WxcHostPrepPath)"
        InstallArguments="prepare-null-device"
        PerMachine="yes"
        Permanent="yes"
        Compressed="yes"
        Vital="yes" />
      <?if $(var.RuntimeImageFinalization) = "true" ?>
      <!-- This always-detected package runs only during uninstall, after MSI
           removal in reverse chain order, to commit the retained transaction. -->
      <ExePackage
        Id="NemoClawRuntimeRemovalCommit"
        CacheId="NemoClawRuntimeRemovalCommit-$(var.RuntimeFinalizerSha256)"
        Name="runtime\NemoClawRuntimeRemovalCommit.exe"
        SourceFile="$(var.RuntimeFinalizerPath)"
        InstallArguments="--runtime-bundle rollback $(var.RuntimeId)"
        UninstallArguments="--runtime-bundle complete-remove $(var.RuntimeId)"
        DetectCondition="1"
        PerMachine="yes"
        Compressed="yes"
        Vital="yes" />
      <!-- This deliberately undetected package opens the one runtime journal
           before MSI replacement. Burn invokes its uninstall command only to
           roll back an install or repair that did not reach completion. -->
      <ExePackage
        Id="NemoClawRuntimeTransactionBegin"
        CacheId="NemoClawRuntimeTransactionBegin-$(var.RuntimeFinalizerSha256)"
        Name="runtime\NemoClawRuntimeTransactionBegin.exe"
        SourceFile="$(var.RuntimeFinalizerPath)"
        InstallArguments="--runtime-bundle begin-install $(var.RuntimeTuple)"
        RepairArguments="--runtime-bundle begin-install $(var.RuntimeTuple)"
        UninstallArguments="--runtime-bundle rollback $(var.RuntimeId)"
        DetectCondition="0"
        PerMachine="yes"
        Compressed="yes"
        Vital="yes" />
      <?endif ?>
      <MsiPackage Id="NemoClawArm64Msi" SourceFile="$(var.MsiPath)" Compressed="yes" Vital="yes">
        <?if $(var.RuntimeImageFinalization) = "true" ?>
        <MsiProperty Name="NEMOCLAW_BUNDLE_MANAGED_RUNTIME" Value="1" />
        <?endif ?>
      </MsiPackage>
      <?if $(var.RuntimeImageFinalization) = "true" ?>
      <!-- Windows Installer strips SeManageVolumePrivilege from deferred custom
           actions. Burn runs this package from its elevated engine after MSI
           file placement and before declaring the bundle installed. -->
      <ExePackage
        Id="NemoClawRuntimeTransactionComplete"
        CacheId="NemoClawRuntimeTransactionComplete-$(var.RuntimeFinalizerSha256)"
        Name="runtime\NemoClawRuntimeTransactionComplete.exe"
        SourceFile="$(var.RuntimeFinalizerPath)"
        InstallArguments="--runtime-bundle complete-install $(var.RuntimeTuple)"
        RepairArguments="--runtime-bundle complete-install $(var.RuntimeTuple)"
        UninstallArguments="--runtime-bundle rollback $(var.RuntimeId)"
        DetectCondition="0"
        PerMachine="yes"
        Compressed="yes"
        Vital="yes" />
      <!-- Reverse chain order opens removal before MSI and lets the earlier
           removal-commit package finish only after MSI has removed its files. -->
      <ExePackage
        Id="NemoClawRuntimeRemovalBegin"
        CacheId="NemoClawRuntimeRemovalBegin-$(var.RuntimeFinalizerSha256)"
        Name="runtime\NemoClawRuntimeRemovalBegin.exe"
        SourceFile="$(var.RuntimeFinalizerPath)"
        InstallArguments="--runtime-bundle rollback $(var.RuntimeId)"
        UninstallArguments="--runtime-bundle begin-remove $(var.RuntimeId)"
        DetectCondition="1"
        PerMachine="yes"
        Compressed="yes"
        Vital="yes" />
      <?endif ?>
    </Chain>
  </Bundle>
</Wix>
