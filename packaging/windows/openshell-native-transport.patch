+    fn tree_cleanup(nonce: &str, environment: &HashMap<String, String>) {
+        for explicit_termination in [true, false] {
+            let previous_helpers = console_helpers();
+            let mut environment = environment.clone();
+            environment.insert("OPENSHELL_CONPTY_TEST_MODE".into(), "tree-parent".into());
+            let (send, receive) = mpsc::channel();
+            let (terminal, input) = Terminal::spawn(
+                std::env::current_exe().unwrap().to_str().unwrap(),
+                &fixture_args(),
+                None,
+                &environment,
+                move |data| {
+                    let _ = send.send(data);
+                },
+            )
+            .unwrap();
+            let parent = terminal.process.as_ref().unwrap().try_clone().unwrap();
+            let mut transcript = Vec::new();
+            wait_marker(&receive, &mut transcript, &format!("LEAF:{nonce}"));
+            let helpers = console_helpers()
+                .into_iter()
+                .filter(|pid| !previous_helpers.contains(pid))
+                .collect::<Vec<_>>();
+            assert_eq!(helpers.len(), 1, "expected one new ConPTY helper");
+            let helper_id = helpers[0];
+            let helper = unsafe {
+                let handle = OpenProcess(PROCESS_SYNCHRONIZE, false, helper_id).unwrap();
+                OwnedHandle::from_raw_handle(handle.0)
+            };
+            if let Some(expected) = environment.get("OPENSHELL_CONPTY_EXPECTED_SID") {
+                assert_eq!(
+                    crate::identity::test_process_appcontainer_sid(helper_id).unwrap(),
+                    *expected,
+                    "ConPTY helper must share the boundary's AppContainer identity"
+                );
+            }
+            let prefix = format!("CHILD:{nonce}:");
+            wait_marker(&receive, &mut transcript, ":END");
+            let text = String::from_utf8_lossy(&transcript);
+            let child_id: u32 = text
+                .split(&prefix)
+                .nth(1)
+                .unwrap()
+                .split(":END")
+                .next()
+                .unwrap()
+                .parse()
+                .unwrap();
+            // SAFETY: only the observed child's handle is opened, for waiting.
+            // The owning job controls termination; PID reuse cannot satisfy
+            // these assertions because we retain the handle before shutdown.
+            let child = unsafe {
+                let handle = OpenProcess(PROCESS_SYNCHRONIZE, false, child_id).unwrap();
+                OwnedHandle::from_raw_handle(handle.0)
+            };
+            assert_eq!(unsafe { WaitForSingleObject(raw(&child), 0) }, WAIT_TIMEOUT);
+            if explicit_termination {
+                terminal.terminate().unwrap();
+            }
+            drop(terminal);
+            drop(input);
+            assert_eq!(
+                unsafe { WaitForSingleObject(raw(&parent), 5000) },
+                WAIT_OBJECT_0
+            );
+            assert_eq!(
+                unsafe { WaitForSingleObject(raw(&child), 5000) },
+                WAIT_OBJECT_0
+            );
+            assert_eq!(
+                unsafe { WaitForSingleObject(raw(&helper), 5000) },
+                WAIT_OBJECT_0
+            );
+        }
+    }
