+    #[test]
+    fn native_console_termination_and_failed_spawn_release_resources() {
+        let program = std::env::current_exe().unwrap();
+        let (send, receive) = mpsc::channel();
+        let (terminal, input) = Terminal::spawn(
+            program.to_str().unwrap(),
+            &fixture_args(),
+            None,
+            &HashMap::from([("OPENSHELL_CONPTY_TEST_NONCE".into(), "termination".into())]),
+            move |data| {
+                let _ = send.send(data);
+            },
+        )
+        .unwrap();
+        wait_marker(&receive, &mut Vec::new(), "READY:termination");
+        assert_eq!(terminal.try_wait().unwrap(), None);
+        terminal.terminate().unwrap();
+        assert_ne!(wait_exit(&terminal), 0);
+        drop(terminal);
+        drop(input);
+        let absent = tempfile::tempdir().unwrap().path().join("absent.exe");
+        assert!(
+            Terminal::spawn(absent.to_str().unwrap(), &[], None, &HashMap::new(), |_| {}).is_err()
+        );
+        assert!(Terminal::spawn("cmd.exe", &[], None, &HashMap::new(), |_| {}).is_err());
+    }
+
+    #[test]
+    fn quotes_empty_spaces_quotes_and_trailing_slashes() {
+        assert_eq!(quote_argument(""), "\"\"");
+        assert_eq!(quote_argument("/C"), "/C");
+        for value in ["a&b", "a|b", "a>b", "a<b", "a^b", "(a)", "%PATH%", "!PATH!"] {
+            assert_eq!(quote_argument(value), format!("\"{value}\""));
