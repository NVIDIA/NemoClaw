+        let (send, receive) = mpsc::channel();
+        let (terminal, input) = Terminal::spawn(
+            program.to_str().unwrap(),
+            &args,
+            Some(directory.path().to_str().unwrap()),
+            &environment,
+            move |data| {
+                let _ = send.send(data);
+            },
+        )
+        .unwrap();
+        wait_marker(&receive, &mut Vec::new(), &format!("ARGV_COMPLETE:{nonce}"));
+        assert_eq!(wait_exit(&terminal), 0);
+        drop(terminal);
+        drop(input);
