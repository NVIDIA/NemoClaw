+#[cfg(test)]
+mod tests {
+    use super::super::tests::{RejectingExec, TestLoopbackConnector};
+    use super::*;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    struct PinnedKey(String);
+    impl russh::client::Handler for PinnedKey {
+        type Error = russh::Error;
+        async fn check_server_key(
+            &mut self,
+            key: &russh::keys::PublicKeyOrCertificate,
+        ) -> Result<bool, Self::Error> {
+            Ok(key
+                .public_key()
+                .fingerprint(russh::keys::HashAlg::Sha256)
+                .to_string()
+                == self.0)
+        }
+    }
+
+    #[tokio::test]
+    async fn relay_identity_is_pinned_and_mismatch_rejected() {
+        let key =
+            russh::keys::PrivateKey::random(&mut rand::rng(), russh::keys::Algorithm::Ed25519)
+                .unwrap();
+        let fingerprint = key
+            .public_key()
+            .fingerprint(russh::keys::HashAlg::Sha256)
+            .to_string();
+        let service = RelaySshService::new(
+            key,
+            Arc::new(TestLoopbackConnector),
+            Arc::new(RejectingExec),
+            MainSession::inert(),
+        );
+        let mut client = russh::client::connect_stream(
+            Arc::new(russh::client::Config::default()),
+            service.open(),
+            PinnedKey(fingerprint),
+        )
+        .await
+        .unwrap();
+        assert!(matches!(
+            client.authenticate_none("sandbox").await.unwrap(),
+            russh::client::AuthResult::Success
+        ));
+        client
+            .disconnect(russh::Disconnect::ByApplication, "done", "")
+            .await
+            .unwrap();
+        assert!(
+            russh::client::connect_stream(
+                Arc::new(russh::client::Config::default()),
+                service.open(),
+                PinnedKey("SHA256:wrong".into())
+            )
+            .await
+            .is_err()
+        );
+    }
+
+    #[tokio::test]
+    async fn cancelled_relay_wakes_blocked_reads_and_writes() {
+        for write in [false, true] {
+            let (client, server) = tokio::io::duplex(1);
+            let (cancel, cancelled) = oneshot::channel();
+            let owner = RelaySshStream {
+                stream: client,
+                _cancel: cancel,
+            };
+            let mut stream = CancelledStream {
+                stream: server,
+                cancelled,
+                closed: false,
+            };
+            let blocked = tokio::spawn(async move {
+                if write {
+                    stream.write_all(b"more than one byte").await
+                } else {
+                    stream.read_exact(&mut [0]).await.map(|_| ())
+                }
+            });
+            tokio::task::yield_now().await;
+            assert!(!blocked.is_finished());
+            drop(owner);
+            let error = tokio::time::timeout(std::time::Duration::from_secs(2), blocked)
+                .await
+                .unwrap()
+                .unwrap()
+                .unwrap_err();
+            assert_eq!(error.kind(), io::ErrorKind::ConnectionAborted);
+        }
+    }
+}
