+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Real TLS, JWT, authentication router and supervisor/relay handlers. The store
+//! and compute driver are test fixtures; no workload or MXC qualification is implied.
+
+use std::net::SocketAddr;
+use std::sync::Arc;
+use std::time::Duration;
+
+use openshell_core::jwt::SecretJwt;
+use openshell_core::proto::{
+    ObjectMeta, RelayFrame, RelayInit, Sandbox, SandboxPhase, SandboxStatus, SupervisorHello,
+    SupervisorMessage, gateway_message, open_shell_client::OpenShellClient, relay_frame,
+    supervisor_message,
+};
+use rcgen::{CertificateParams, IsCa, KeyPair};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpListener;
+use tokio::sync::mpsc;
+use tokio_stream::wrappers::ReceiverStream;
+use tonic::transport::{Certificate, Channel, ClientTlsConfig, Endpoint, Identity};
+use tonic::{Code, Request};
+
+use crate::auth::sandbox_jwt::SandboxSessionJwtAuthority;
+use crate::auth::sandbox_session::PersistedSandboxIdentity;
+
+const OWNER: &str = "relay-auth-owner";
+const OTHER: &str = "relay-auth-other";
+
+#[cfg(target_os = "windows")]
+mod windows_access_tests;
+
+struct Gateway {
+    state: Arc<crate::ServerState>,
+    authority: Arc<SandboxSessionJwtAuthority>,
+    addr: SocketAddr,
+    ca: String,
+    client_identity: Identity,
+    task: tokio::task::JoinHandle<()>,
+    _pki: tempfile::TempDir,
+}
+
+impl Drop for Gateway {
+    fn drop(&mut self) {
+        self.state.supervisor_sessions.disconnect(OWNER);
+        self.state.supervisor_sessions.disconnect(OTHER);
+        self.task.abort();
+    }
+}
+
+impl Gateway {
+    async fn start() -> Self {
+        let _ = rustls::crypto::aws_lc_rs::default_provider().install_default();
+        crate::install_jsonwebtoken_crypto_provider();
+        let mut state =
+            crate::grpc::test_support::test_server_state_without_provider_profiles().await;
+        let key = openshell_bootstrap::jwt::generate_jwt_key().unwrap();
+        let authority = Arc::new(
+            SandboxSessionJwtAuthority::from_pem(
+                key.signing_key_pem.as_bytes(),
+                key.public_key_pem.as_bytes(),
+                key.kid,
+                "relay-auth-gateway",
+                Some(Duration::from_secs(300)),
+            )
+            .unwrap(),
+        );
+        let mutable = Arc::get_mut(&mut state).unwrap();
+        mutable.config.auth.allow_unauthenticated_users = false;
+        mutable.config.mtls_auth.enabled = true;
+        mutable.sandbox_session_jwt_authority = Some(authority.clone());
+
+        let mut ca_params = CertificateParams::new(Vec::<String>::new()).unwrap();
+        ca_params.is_ca = IsCa::Ca(rcgen::BasicConstraints::Unconstrained);
+        let ca_key = KeyPair::generate().unwrap();
+        let ca = ca_params.self_signed(&ca_key).unwrap();
+        let server_key = KeyPair::generate().unwrap();
+        let server = CertificateParams::new(vec!["localhost".into(), "127.0.0.1".into()])
+            .unwrap()
+            .signed_by(&server_key, &ca, &ca_key)
+            .unwrap();
+        let client_key = KeyPair::generate().unwrap();
+        let mut client_params = CertificateParams::new(Vec::<String>::new()).unwrap();
+        client_params
+            .distinguished_name
+            .push(rcgen::DnType::CommonName, "relay-auth-user");
+        let client = client_params.signed_by(&client_key, &ca, &ca_key).unwrap();
+        let pki = tempfile::tempdir().unwrap();
+        std::fs::write(pki.path().join("ca.pem"), ca.pem()).unwrap();
+        let client_tls = pki.path().join("client/openshell/gateways/openshell/mtls");
+        std::fs::create_dir_all(&client_tls).unwrap();
+        std::fs::write(client_tls.join("ca.crt"), ca.pem()).unwrap();
+        std::fs::write(client_tls.join("tls.crt"), client.pem()).unwrap();
+        std::fs::write(client_tls.join("tls.key"), client_key.serialize_pem()).unwrap();
+        std::fs::write(pki.path().join("server.pem"), server.pem()).unwrap();
+        std::fs::write(
+            pki.path().join("server-key.pem"),
+            server_key.serialize_pem(),
+        )
+        .unwrap();
+        let tls = crate::TlsAcceptor::from_files(
+            &pki.path().join("server.pem"),
+            &pki.path().join("server-key.pem"),
+            Some(&pki.path().join("ca.pem")),
+            false,
+            None,
+            None,
+            Vec::new(),
+        )
+        .unwrap();
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        // The public connect command follows the gateway's advertised endpoint.
+        // Match the actual listener rather than the test state's default HTTP port.
+        let config = &mut Arc::get_mut(&mut state).unwrap().config;
+        config.bind_address = addr;
+        config.tls = Some(openshell_core::config::TlsConfig {
+            cert_path: pki.path().join("server.pem"),
+            key_path: pki.path().join("server-key.pem"),
+            client_ca_path: Some(pki.path().join("ca.pem")),
+            require_client_auth: false,
+            external_cert_path: None,
+            external_key_path: None,
+            external_server_names: Vec::new(),
+        });
+        let service = super::MultiplexService::new(state.clone());
+        let task = tokio::spawn(async move {
+            let mut connections = tokio::task::JoinSet::new();
+            loop {
+                tokio::select! {
+                    accepted = listener.accept() => {
+                        let Ok((stream, _)) = accepted else { break; };
+                        let tls = tls.clone();
+                        let service = service.clone();
+                        connections.spawn(async move {
+                            let Ok(stream) = tls.acceptor().accept(stream).await else { return; };
+                            let peer = super::extract_peer_identity(&stream);
+                            let _ = service.serve_with_peer_identity(stream, peer).await;
+                        });
+                    }
+                    _ = connections.join_next(), if !connections.is_empty() => {}
+                }
+            }
+        });
+        Self {
+            state,
+            authority,
+            addr,
+            ca: ca.pem(),
+            client_identity: Identity::from_pem(client.pem(), client_key.serialize_pem()),
+            task,
+            _pki: pki,
+        }
+    }
+
+    async fn client(&self, certificate: bool) -> OpenShellClient<Channel> {
+        let mut tls = ClientTlsConfig::new()
+            .domain_name("localhost")
+            .ca_certificate(Certificate::from_pem(&self.ca));
+        if certificate {
+            tls = tls.identity(self.client_identity.clone());
+        }
+        let channel = Endpoint::from_shared(format!("https://localhost:{}", self.addr.port()))
+            .unwrap()
+            .connect_timeout(Duration::from_secs(3))
+            .tls_config(tls)
+            .unwrap()
+            .connect()
+            .await
+            .unwrap();
+        OpenShellClient::new(channel)
+    }
+
+    async fn seed_identity(&self, id: &str) -> SecretJwt {
+        let identity = PersistedSandboxIdentity::new().unwrap();
+        let mut metadata = ObjectMeta {
+            id: id.into(),
+            name: id.into(),
+            workspace: "default".into(),
+            ..Default::default()
+        };
+        identity.write(&mut metadata.annotations);
+        self.state
+            .store
+            .put_message(&Sandbox {
+                metadata: Some(metadata),
+                status: Some(SandboxStatus {
+                    phase: SandboxPhase::Ready as i32,
+                    ..Default::default()
+                }),
+                ..Default::default()
+            })
+            .await
+            .unwrap();
+        self.authority
+            .mint_persisted_launch(id, &identity)
+            .unwrap()
+            .supervisor
+            .gateway_token
+    }
+}
+
+fn authorized<T>(body: T, token: Option<&str>) -> Request<T> {
+    let mut request = Request::new(body);
+    if let Some(token) = token {
+        request
+            .metadata_mut()
+            .insert("authorization", format!("Bearer {token}").parse().unwrap());
+    }
+    request
+}
+
+fn hello(
+    id: &str,
+) -> (
+    mpsc::Sender<SupervisorMessage>,
+    ReceiverStream<SupervisorMessage>,
+) {
+    let (tx, rx) = mpsc::channel(4);
+    tx.try_send(SupervisorMessage {
+        payload: Some(supervisor_message::Payload::Hello(SupervisorHello {
+            sandbox_id: id.into(),
+            instance_id: uuid::Uuid::new_v4().to_string(),
+            connection_epoch: 1,
+            ..Default::default()
+        })),
+    })
+    .unwrap();
+    (tx, ReceiverStream::new(rx))
+}
+
+fn relay(id: &str) -> (mpsc::Sender<RelayFrame>, ReceiverStream<RelayFrame>) {
+    let (tx, rx) = mpsc::channel(4);
+    tx.try_send(RelayFrame {
+        payload: Some(relay_frame::Payload::Init(RelayInit {
+            channel_id: id.into(),
+        })),
+    })
+    .unwrap();
+    (tx, ReceiverStream::new(rx))
+}
+
+fn ssh_forward(
+    sandbox: &str,
+    token: &str,
+) -> (
+    mpsc::Sender<openshell_core::proto::TcpForwardFrame>,
+    ReceiverStream<openshell_core::proto::TcpForwardFrame>,
+) {
+    use openshell_core::proto::{
+        SshRelayTarget, TcpForwardFrame, TcpForwardInit, tcp_forward_frame, tcp_forward_init,
+    };
+    let (tx, rx) = mpsc::channel(4);
+    tx.try_send(TcpForwardFrame {
+        payload: Some(tcp_forward_frame::Payload::Init(TcpForwardInit {
+            sandbox: sandbox.into(),
+            workspace: "default".into(),
+            service_id: format!("ssh-proxy:{sandbox}"),
+            target: Some(tcp_forward_init::Target::Ssh(SshRelayTarget {})),
+            authorization_token: token.into(),
+        })),
+    })
+    .unwrap();
+    (tx, ReceiverStream::new(rx))
+}
+
+/// Exercise the public user-side route, not only the internal relay registry.
+/// The supervisor endpoint exchanges fixture bytes; this is not an SSH or MXC test.
+#[tokio::test]
+async fn tls_user_ssh_forward_requires_credentials_and_scoped_session() {
+    use openshell_core::proto::{
+        CreateSshSessionRequest, TcpForwardFrame, relay_open, tcp_forward_frame,
+    };
+    tokio::time::timeout(Duration::from_secs(30), async {
+        let gateway = Gateway::start().await;
+        let owner = gateway.seed_identity(OWNER).await;
+        gateway.seed_identity(OTHER).await;
+        let mut supervisor = gateway.client(false).await;
+        let mut anonymous = gateway.client(false).await;
+        let mut user = gateway.client(true).await;
+        let (_hello_tx, stream) = hello(OWNER);
+        let mut messages = supervisor
+            .connect_supervisor(authorized(stream, Some(owner.expose_secret())))
+            .await
+            .unwrap()
+            .into_inner();
+        assert!(matches!(
+            messages.message().await.unwrap().unwrap().payload,
+            Some(gateway_message::Payload::SessionAccepted(_))
+        ));
+        let request = CreateSshSessionRequest {
+            sandbox: OWNER.into(),
+            workspace_scope: Some(openshell_core::proto::workspace_selector("default")),
+        };
+        assert_eq!(
+            anonymous
+                .create_ssh_session(request.clone())
+                .await
+                .unwrap_err()
+                .code(),
+            Code::Unauthenticated
+        );
+        let session = user.create_ssh_session(request).await.unwrap().into_inner();
+        assert_eq!(session.sandbox_id, OWNER);
+        assert!(!session.token.is_empty());
+
+        // A valid SSH session token does not replace gateway user authentication.
+        let (_tx, stream) = ssh_forward(OWNER, &session.token);
+        assert_eq!(
+            anonymous.forward_tcp(stream).await.unwrap_err().code(),
+            Code::Unauthenticated
+        );
+        for (sandbox, token) in [
+            (OWNER, ""),
+            (OWNER, "invalid-token"),
+            (OTHER, session.token.as_str()),
+        ] {
+            let (_tx, stream) = ssh_forward(sandbox, token);
+            assert_eq!(
+                user.forward_tcp(stream).await.unwrap_err().code(),
+                Code::Unauthenticated
+            );
+        }
+        assert!(
+            gateway
+                .state
+                .ssh_connections_by_sandbox
+                .lock()
+                .unwrap()
+                .is_empty()
+        );
+        assert!(
+            gateway
+                .state
+                .ssh_connections_by_token
+                .lock()
+                .unwrap()
+                .is_empty()
+        );
+
+        let (forward_tx, stream) = ssh_forward(OWNER, &session.token);
+        let mut forwarded = user.forward_tcp(stream).await.unwrap().into_inner();
+        let open = match messages.message().await.unwrap().unwrap().payload {
+            Some(gateway_message::Payload::RelayOpen(open)) => open,
+            _ => panic!("public ForwardTcp must open a supervisor relay"),
+        };
+        assert!(matches!(open.target, Some(relay_open::Target::Ssh(_))));
+        let (relay_tx, stream) = relay(&open.channel_id);
+        let mut inbound = supervisor
+            .relay_stream(authorized(stream, Some(owner.expose_secret())))
+            .await
+            .unwrap()
+            .into_inner();
+        let nonce = uuid::Uuid::new_v4().to_string().into_bytes();
+        forward_tx
+            .send(TcpForwardFrame {
+                payload: Some(tcp_forward_frame::Payload::Data(nonce.clone())),
+            })
+            .await
+            .unwrap();
+        match inbound.message().await.unwrap().unwrap().payload {
+            Some(relay_frame::Payload::Data(data)) => assert_eq!(data, nonce),
+            _ => panic!("expected user-to-supervisor data"),
+        }
+        relay_tx
+            .send(RelayFrame {
+                payload: Some(relay_frame::Payload::Data(nonce.clone())),
+            })
+            .await
+            .unwrap();
+        match forwarded.message().await.unwrap().unwrap().payload {
+            Some(tcp_forward_frame::Payload::Data(data)) => assert_eq!(data, nonce),
+            _ => panic!("expected supervisor-to-user data"),
+        }
+        drop(forward_tx);
+        drop(relay_tx);
+        drop(inbound);
+        drop(forwarded);
+        tokio::time::timeout(Duration::from_secs(3), async {
+            loop {
+                if gateway
+                    .state
+                    .ssh_connections_by_sandbox
+                    .lock()
+                    .unwrap()
+                    .is_empty()
+                    && gateway
+                        .state
+                        .ssh_connections_by_token
+                        .lock()
+                        .unwrap()
+                        .is_empty()
+                {
+                    break;
+                }
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await
+        .expect("closing both streams must release forwarding slots");
+    })
+    .await
+    .expect("public authenticated forwarding must finish within its deadline");
+}
