+    fn wait_marker(output: &mpsc::Receiver<Vec<u8>>, transcript: &mut Vec<u8>, marker: &str) {
+        let deadline = Instant::now() + Duration::from_secs(15);
+        while !String::from_utf8_lossy(transcript).contains(marker) {
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            let data = output.recv_timeout(remaining).unwrap_or_else(|error| {
+                panic!(
+                    "missing {marker}: {error}; output={}",
+                    String::from_utf8_lossy(transcript)
+                )
+            });
+            transcript.extend(data);
+            assert!(
+                transcript.len() < 128 * 1024,
+                "fixture output exceeded bound"
+            );
+        }
+    }
+
+    fn wait_exit(terminal: &Terminal) -> i32 {
+        let deadline = Instant::now() + Duration::from_secs(10);
+        loop {
+            if let Some(code) = terminal.try_wait().unwrap() {
+                return code;
+            }
+            assert!(Instant::now() < deadline, "terminal did not exit");
+            std::thread::sleep(Duration::from_millis(10));
+        }
+    }
