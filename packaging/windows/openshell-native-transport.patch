+
+#[derive(Default)]
+pub(super) struct RelayTasks(Mutex<HashMap<String, JoinHandle<()>>>);
+
+impl RelayTasks {
+    pub(super) fn insert(&self, id: String, task: JoinHandle<()>) {
+        let mut tasks = self.0.lock().expect("relay task ownership");
+        tasks.retain(|_, task| !task.is_finished());
+        if let Some(previous) = tasks.insert(id, task) {
+            previous.abort();
+        }
+    }
+
+    pub(super) fn close(&self, id: &str) {
+        if let Some(task) = self.0.lock().expect("relay task ownership").remove(id) {
+            task.abort();
+        }
+    }
+}
+
+impl Drop for RelayTasks {
+    fn drop(&mut self) {
+        for task in self.0.get_mut().expect("relay task ownership").values() {
+            task.abort();
+        }
+    }
+}
+
+pub(super) struct AbortOnDrop(pub(super) AbortHandle);
+
+impl Drop for AbortOnDrop {
+    fn drop(&mut self) {
+        self.0.abort();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    async fn owned_task() -> (JoinHandle<()>, tokio::sync::oneshot::Receiver<()>) {
+        let (lifetime, released) = tokio::sync::oneshot::channel();
+        let (started, ready) = tokio::sync::oneshot::channel();
+        let task = tokio::spawn(async move {
+            let _lifetime = lifetime;
+            let _ = started.send(());
+            std::future::pending::<()>().await;
+        });
+        ready.await.unwrap();
+        (task, released)
+    }
+
+    #[tokio::test]
+    async fn relay_close_and_session_drop_cancel_owned_tasks() {
+        let tasks = RelayTasks::default();
+        let (first, first_closed) = owned_task().await;
+        let (second, second_closed) = owned_task().await;
+        tasks.insert("first".into(), first);
+        tasks.insert("second".into(), second);
+        tasks.close("first");
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_secs(2), first_closed)
+                .await
+                .unwrap()
+                .is_err()
+        );
+        drop(tasks);
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_secs(2), second_closed)
+                .await
+                .unwrap()
+                .is_err()
+        );
+    }
+}
