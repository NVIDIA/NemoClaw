+#[cfg(target_os = "windows")]
+#[tokio::test]
+#[ignore = "requires OPENSHELL_TEST_NATIVE_CLI pointing to the matching source-built Windows CLI"]
+async fn native_cli_authenticated_forward_exits_with_stdin_open() {
+    use crate::persistence::ObjectType;
+    use openshell_core::proto::CreateSshSessionRequest;
+    use std::path::PathBuf;
+    use std::process::Stdio;
+
+    tokio::time::timeout(Duration::from_secs(30), async {
+        let source = PathBuf::from(
+            std::env::var_os("OPENSHELL_TEST_NATIVE_CLI")
+                .expect("set OPENSHELL_TEST_NATIVE_CLI to the matching source-built CLI"),
+        );
+        assert!(source.is_absolute() && source.is_file());
+        let gateway = Gateway::start().await;
+        let owner = gateway.seed_identity(OWNER).await;
+        let executable_dir = gateway._pki.path().join("Spark 空間 & apostrophe' %h");
+        std::fs::create_dir(&executable_dir).unwrap();
+        let executable = executable_dir.join("OpenShell CLI.exe");
+        std::fs::copy(source, &executable).unwrap();
+        let mut supervisor = gateway.client(false).await;
+        let (_hello_tx, stream) = hello(OWNER);
+        let mut messages = supervisor
+            .connect_supervisor(authorized(stream, Some(owner.expose_secret())))
+            .await
+            .unwrap()
+            .into_inner();
+        assert!(matches!(
+            messages.message().await.unwrap().unwrap().payload,
+            Some(gateway_message::Payload::SessionAccepted(_))
+        ));
+        let session = gateway
+            .client(true)
+            .await
+            .create_ssh_session(CreateSshSessionRequest {
+                sandbox: OWNER.into(),
+                workspace_scope: Some(openshell_core::proto::workspace_selector("default")),
+            })
+            .await
+            .unwrap()
+            .into_inner();
+
+        let native_command = || {
+            let mut command = tokio::process::Command::new(&executable);
+            command.env_clear();
+            for name in [
+                "SystemRoot",
+                "WINDIR",
+                "TEMP",
+                "TMP",
+                "USERPROFILE",
+                "APPDATA",
+                "LOCALAPPDATA",
+                "PROGRAMDATA",
+            ] {
+                if let Some(value) = std::env::var_os(name) {
+                    command.env(name, value);
+                }
+            }
+            command
+                .env("XDG_CONFIG_HOME", gateway._pki.path().join("client"))
+                .env("OPENSHELL_TELEMETRY_ENABLED", "false")
+                .stdin(Stdio::piped())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::piped())
+                .kill_on_drop(true);
+            command
+        };
+        // Exercise the public CLI's registry serialization through real mTLS.
+        // Store removal below is fixture state, not proof of compute teardown.
+        let list = || {
+            let mut command = native_command();
+            command.args([
+                "--gateway",
+                "openshell",
+                "--gateway-endpoint",
+                &format!("https://localhost:{}", gateway.addr.port()),
+                "sandbox",
+                "list",
+                "--output",
+                "json",
+            ]);
+            command
+        };
+        let listed = tokio::time::timeout(Duration::from_secs(5), list().output())
+            .await
+            .expect("listing must finish within its deadline")
+            .unwrap();
+        assert!(listed.status.success(), "authenticated CLI listing failed");
+        let registry: serde_json::Value = serde_json::from_slice(&listed.stdout).unwrap();
+        assert_eq!(registry["next_page_token"], "");
+        let sandboxes = registry["sandboxes"].as_array().unwrap();
+        assert_eq!(sandboxes.len(), 1);
+        assert_eq!(sandboxes[0]["name"], OWNER);
+
+        let spawn = |token: &str| {
+            native_command()
+                .args([
+                    "ssh-proxy",
+                    "--gateway",
+                    &format!("https://localhost:{}/proxy/connect", gateway.addr.port()),
+                    "--sandbox",
+                    OWNER,
+                    "--workspace",
+                    "default",
+                    "--token",
+                    token,
+                ])
+                .spawn()
+                .unwrap()
+        };
+        // Run the same binary and TLS client identity with an invalid session first.
+        let rejected = tokio::time::timeout(
+            Duration::from_secs(5),
+            spawn("invalid-token").wait_with_output(),
+        )
+        .await
+        .expect("invalid session must fail within its deadline")
+        .unwrap();
+        assert!(!rejected.status.success());
+        assert!(rejected.stdout.is_empty());
+        let diagnostic = String::from_utf8_lossy(&rejected.stderr);
+        assert!(
+            diagnostic.contains("SSH session token not found"),
+            "unexpected sanitized failure: {diagnostic}"
+        );
+
+        let mut child = spawn(&session.token);
+        let mut stdin = child.stdin.take().unwrap();
+        let mut stdout = child.stdout.take().unwrap();
+        let open = match messages.message().await.unwrap().unwrap().payload {
+            Some(gateway_message::Payload::RelayOpen(open)) => open,
+            _ => panic!("the CLI must open the actual public relay"),
+        };
+        let (relay_tx, stream) = relay(&open.channel_id);
+        let mut inbound = supervisor
+            .relay_stream(authorized(stream, Some(owner.expose_secret())))
+            .await
+            .unwrap()
+            .into_inner();
+        let request = format!("request-{}", uuid::Uuid::new_v4()).into_bytes();
+        stdin.write_all(&request).await.unwrap();
+        stdin.flush().await.unwrap();
+        let mut received = Vec::new();
+        while received.len() < request.len() {
+            match inbound.message().await.unwrap().unwrap().payload {
+                Some(relay_frame::Payload::Data(bytes)) => received.extend(bytes),
+                _ => panic!("expected native CLI input bytes"),
+            }
+            assert!(request.starts_with(&received));
+        }
+        assert_eq!(received, request);
+        let reply = format!("reply-{}", uuid::Uuid::new_v4()).into_bytes();
+        relay_tx
+            .send(RelayFrame {
+                payload: Some(relay_frame::Payload::Data(reply.clone())),
+            })
+            .await
+            .unwrap();
+        let mut returned = vec![0; reply.len()];
+        stdout.read_exact(&mut returned).await.unwrap();
+        assert_eq!(returned, reply);
+        drop(relay_tx);
+        drop(inbound);
+        // Keep the actual parent stdin pipe open throughout wait: this catches
+        // the Windows blocking-stdin shutdown failure on the authenticated route.
+        let status = tokio::time::timeout(Duration::from_secs(5), child.wait())
+            .await
+            .expect("CLI must exit when the relay closes despite open stdin")
+            .unwrap();
+        assert!(status.success());
+        drop(stdin);
+        let mut remaining = Vec::new();
+        stdout.read_to_end(&mut remaining).await.unwrap();
+        assert!(remaining.is_empty());
+        assert!(
+            gateway
+                .state
+                .ssh_connections_by_sandbox
+                .lock()
+                .unwrap()
+                .is_empty()
+        );
+        assert!(
+            gateway
+                .state
+                .ssh_connections_by_token
+                .lock()
+                .unwrap()
+                .is_empty()
+        );
+        gateway
+            .state
+            .store
+            .delete(Sandbox::object_type(), OWNER)
+            .await
+            .unwrap();
+        let empty = tokio::time::timeout(Duration::from_secs(5), list().output())
+            .await
+            .expect("empty listing must finish within its deadline")
+            .unwrap();
+        assert!(
+            empty.status.success(),
+            "authenticated empty CLI listing failed"
+        );
+        assert_eq!(
+            serde_json::from_slice::<serde_json::Value>(&empty.stdout).unwrap(),
+            serde_json::json!({"sandboxes": [], "next_page_token": ""})
+        );
+    })
+    .await
+    .expect("native CLI integration must finish within its deadline");
+}
