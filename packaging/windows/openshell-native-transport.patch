+
+    async fn terminal_attachment_round_trip(main: bool, mut environment: HashMap<String, String>) {
+        let nonce = format!("protocol-{}", std::process::id());
+        environment.insert("OPENSHELL_CONPTY_TEST_NONCE".into(), nonce.clone());
+        let program = std::env::current_exe()
+            .unwrap()
+            .to_str()
+            .unwrap()
+            .to_string();
+        let args = [
+            "--exact",
+            "conpty::tests::console_fixture",
+            "--ignored",
+            "--nocapture",
+            "--test-threads=1",
+        ]
+        .into_iter()
+        .map(str::to_string)
+        .collect();
+        let spawned = if main {
+            ManagedProcess::spawn_agent(
+                "terminal-main-test".into(),
+                AgentSpecWire {
+                    program,
+                    args,
+                    workdir: None,
+                    timeout_secs: 0,
+                    interactive: true,
+                },
+                environment,
+            )
+            .await
+        } else {
+            ManagedProcess::spawn_terminal(
+                "terminal-exec-test".into(),
+                ProcessKindWire::Exec,
+                program,
+                args,
+                None,
+                environment,
+            )
+            .await
+        };
+        let process = Arc::new(spawned.expect("launch real console fixture"));
+        if !matches!(process.child, ProcessControl::Terminal(_)) {
+            process
+                .terminate()
+                .await
+                .expect("clean up non-terminal regression");
+            panic!("interactive process must have a real terminal");
+        }
+        assert!(matches!(
+            (&process.kind, main),
+            (ProcessKindWire::Main, true) | (ProcessKindWire::Exec, false)
+        ));
+        let ProcessControl::Terminal(terminal) = &process.child else {
+            unreachable!("terminal checked above");
+        };
+        let native_pid = lock(terminal).as_ref().unwrap().process_id();
+        assert_ne!(native_pid, 0);
+        let (mut client, server) = tokio::io::duplex(4096);
+        let bridge = tokio::spawn(bridge_process(server, process.clone()));
+        let result = tokio::time::timeout(Duration::from_secs(20), async {
+            let mut output = Vec::new();
+            loop {
+                let (channel, data) = read_stream_frame(&mut client).await.unwrap().unwrap();
+                assert_eq!(channel, STREAM_STDOUT);
+                output.extend(data);
+                assert!(output.len() < 128 * 1024);
+                if String::from_utf8_lossy(&output).contains(&format!("READY:{nonce}")) {
+                    break;
+                }
+            }
+            assert!(
+                String::from_utf8_lossy(&output).contains(&format!("PID:{nonce}:{native_pid}:END"))
+            );
+            assert!(process.acquire_attachment().is_err());
+            process.resize(120, 40).expect("resize actual console");
+            write_stream_frame(
+                &mut client,
+                STREAM_STDIN,
+                format!("first {nonce}\r").as_bytes(),
+            )
+            .await
+            .unwrap();
+            tokio::time::sleep(Duration::from_millis(50)).await;
+            write_stream_frame(&mut client, STREAM_STDIN, "second café 窗口\r".as_bytes())
+                .await
+                .unwrap();
+            loop {
+                let (channel, data) = read_stream_frame(&mut client).await.unwrap().unwrap();
+                if channel == STREAM_EXIT {
+                    break;
+                }
+                assert_eq!(channel, STREAM_STDOUT, "terminal merges stdout/stderr");
+                output.extend(data);
+                assert!(output.len() < 128 * 1024);
+            }
+            assert!(String::from_utf8_lossy(&output).contains(&format!("COMPLETE:{nonce}")));
+            assert!(matches!(process.wait().await, ExitStatusWire::Exited(0)));
+            assert!(
+                process.resize(80, 24).is_err(),
+                "exited console cannot be resized"
+            );
+        })
+        .await;
+        process.terminate().await.expect("cleanup terminal");
+        result.expect("terminal protocol exchange completes");
+        bridge.await.unwrap().unwrap();
+    }
