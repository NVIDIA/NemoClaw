+#[tokio::test]
+async fn tls_jwt_supervisor_relay_rejects_wrong_authority_and_replay() {
+    tokio::time::timeout(Duration::from_secs(30), async {
+        let gateway = Gateway::start().await;
+        let owner = gateway.seed_identity(OWNER).await;
+        let other = gateway.seed_identity(OTHER).await;
+        let mut client = gateway.client(false).await;
+        let mut user = gateway.client(true).await;
+
+        // A live, correctly trusted TLS endpoint is the positive control for
+        // the wrong-CA rejection; connection refusal is not a security result.
+        client
+            .health(openshell_core::proto::HealthRequest {})
+            .await
+            .unwrap();
+        let rogue_key = KeyPair::generate().unwrap();
+        let mut rogue_params = CertificateParams::new(Vec::<String>::new()).unwrap();
+        rogue_params.is_ca = IsCa::Ca(rcgen::BasicConstraints::Unconstrained);
+        let rogue = rogue_params.self_signed(&rogue_key).unwrap();
+        assert!(
+            Endpoint::from_shared(format!("https://localhost:{}", gateway.addr.port()))
+                .unwrap()
+                .connect_timeout(Duration::from_secs(3))
+                .tls_config(
+                    ClientTlsConfig::new()
+                        .domain_name("localhost")
+                        .ca_certificate(Certificate::from_pem(rogue.pem()))
+                )
+                .unwrap()
+                .connect()
+                .await
+                .is_err()
+        );
+        client
+            .health(openshell_core::proto::HealthRequest {})
+            .await
+            .unwrap();
+
+        for (token, expected) in [
+            (None, Code::Unauthenticated),
+            (Some("invalid-credential"), Code::Unauthenticated),
+            (Some(other.expose_secret()), Code::PermissionDenied),
+        ] {
+            let (_tx, stream) = hello(OWNER);
+            let error = client
+                .connect_supervisor(authorized(stream, token))
+                .await
+                .unwrap_err();
+            assert_eq!(error.code(), expected);
+            assert!(!gateway.state.supervisor_sessions.has_session(OWNER));
+        }
+        let (_user_tx, stream) = hello(OWNER);
+        assert_eq!(
+            user.connect_supervisor(authorized(stream, None))
+                .await
+                .unwrap_err()
+                .code(),
+            Code::PermissionDenied
+        );
+        assert!(!gateway.state.supervisor_sessions.has_session(OWNER));
+
+        let (_owner_tx, stream) = hello(OWNER);
+        let mut messages = client
+            .connect_supervisor(authorized(stream, Some(owner.expose_secret())))
+            .await
+            .unwrap()
+            .into_inner();
+        assert!(matches!(
+            messages.message().await.unwrap().unwrap().payload,
+            Some(gateway_message::Payload::SessionAccepted(_))
+        ));
+        let (id, pending) = gateway
+            .state
+            .supervisor_sessions
+            .open_relay(OWNER, Duration::from_secs(2))
+            .await
+            .unwrap();
+        match messages.message().await.unwrap().unwrap().payload {
+            Some(gateway_message::Payload::RelayOpen(open)) => assert_eq!(open.channel_id, id),
+            _ => panic!("expected the actual gateway relay open"),
+        }
+
+        for (token, expected) in [
+            (None, Code::Unauthenticated),
+            (Some("invalid-credential"), Code::Unauthenticated),
+            (Some(other.expose_secret()), Code::PermissionDenied),
+        ] {
+            let (_tx, stream) = relay(&id);
+            assert_eq!(
+                client
+                    .relay_stream(authorized(stream, token))
+                    .await
+                    .unwrap_err()
+                    .code(),
+                expected
+            );
+        }
+        let (_tx, stream) = relay(&id);
+        assert_eq!(
+            user.relay_stream(authorized(stream, None))
+                .await
+                .unwrap_err()
+                .code(),
+            Code::PermissionDenied
+        );
+
+        // Failed callers must not consume the one-use pending channel.
+        let (out_tx, stream) = relay(&id);
+        let mut inbound = client
+            .relay_stream(authorized(stream, Some(owner.expose_secret())))
+            .await
+            .unwrap()
+            .into_inner();
+        let mut target = pending.await.unwrap().unwrap();
+        let nonce = uuid::Uuid::new_v4().to_string().into_bytes();
+        target.write_all(&nonce).await.unwrap();
+        match inbound.message().await.unwrap().unwrap().payload {
+            Some(relay_frame::Payload::Data(bytes)) => assert_eq!(bytes, nonce),
+            _ => panic!("expected gateway-to-supervisor data"),
+        }
+        out_tx
+            .send(RelayFrame {
+                payload: Some(relay_frame::Payload::Data(nonce.clone())),
+            })
+            .await
+            .unwrap();
+        let mut returned = vec![0; nonce.len()];
+        target.read_exact(&mut returned).await.unwrap();
+        assert_eq!(returned, nonce);
+        let (_tx, stream) = relay(&id);
+        assert_eq!(
+            client
+                .relay_stream(authorized(stream, Some(owner.expose_secret())))
+                .await
+                .unwrap_err()
+                .code(),
+            Code::NotFound
+        );
+
+        // A persisted runtime generation change revokes the old bearer for
+        // new RPCs. This does not claim revocation of an already-open stream.
+        let current = gateway
+            .state
+            .store
+            .get_message::<Sandbox>(OWNER)
+            .await
+            .unwrap()
+            .unwrap();
+        let next = PersistedSandboxIdentity::new().unwrap();
+        gateway
+            .state
+            .store
+            .update_message_cas::<Sandbox, _>(
+                OWNER,
+                current.metadata.as_ref().unwrap().resource_version,
+                |sandbox| next.write(&mut sandbox.metadata.as_mut().unwrap().annotations),
+            )
+            .await
+            .unwrap();
+        let (_tx, stream) = relay("unknown-channel");
+        assert_eq!(
+            client
+                .relay_stream(authorized(stream, Some(owner.expose_secret())))
+                .await
+                .unwrap_err()
+                .code(),
+            Code::Unauthenticated
+        );
+        let replacement = gateway
+            .authority
+            .mint_persisted_launch(OWNER, &next)
+            .unwrap();
+        let (_tx, stream) = relay("unknown-channel");
+        assert_eq!(
+            client
+                .relay_stream(authorized(
+                    stream,
+                    Some(replacement.supervisor.gateway_token.expose_secret())
+                ))
+                .await
+                .unwrap_err()
+                .code(),
+            Code::NotFound
+        );
+    })
+    .await
+    .expect("authenticated relay assertions must finish within their deadline");
+}
