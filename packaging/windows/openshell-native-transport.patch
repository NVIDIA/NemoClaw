+
+async fn run_access_test(public_connect: bool) {
+    tokio::time::timeout(Duration::from_secs(30), async {
+        use openshell_core::proto::CreateSshSessionRequest;
+        use tokio::io::AsyncBufReadExt;
+
+        let source_cli =
+            std::path::PathBuf::from(std::env::var_os("OPENSHELL_TEST_NATIVE_CLI").unwrap());
+        assert!(source_cli.is_absolute() && source_cli.is_file());
+        let gateway = Gateway::start().await;
+        let executable_dir = gateway._pki.path().join("Spark 空間 & apostrophe' %h");
+        std::fs::create_dir(&executable_dir).unwrap();
+        let cli = executable_dir.join("OpenShell CLI.exe");
+        std::fs::copy(source_cli, &cli).unwrap();
+        let owner = gateway.seed_identity(SANDBOX_ID).await;
+        if public_connect {
+            let native_ssh = std::path::PathBuf::from(std::env::var_os("SystemRoot").unwrap())
+                .join("System32/OpenSSH/ssh.exe");
+            assert!(native_ssh.is_file(), "native Windows OpenSSH is required");
+            let mut sandbox = gateway
+                .state
+                .store
+                .get_message::<Sandbox>(SANDBOX_ID)
+                .await
+                .unwrap()
+                .unwrap();
+            // This test owns fixture pipes, not a ConPTY. The public client must
+            // select -T from the real sandbox spec, not from a test-only override.
+            sandbox.spec = Some(openshell_core::proto::SandboxSpec {
+                tty: false,
+                ..Default::default()
+            });
+            gateway.state.store.put_message(&sandbox).await.unwrap();
+        }
+        let key =
+            russh::keys::PrivateKey::random(&mut rand_ssh::rng(), russh::keys::Algorithm::Ed25519)
+                .unwrap();
+        let fingerprint = key
+            .public_key()
+            .fingerprint(russh::keys::HashAlg::Sha256)
+            .to_string();
+        let key_path = gateway._pki.path().join("supervisor-host-key");
+        std::fs::write(
+            &key_path,
+            key.to_openssh(russh::keys::ssh_key::LineEnding::LF)
+                .unwrap()
+                .as_bytes(),
+        )
+        .unwrap();
+        let token_path = gateway._pki.path().join("supervisor-token");
+        std::fs::write(&token_path, owner.expose_secret()).unwrap();
+        let nonce = uuid::Uuid::new_v4().to_string();
+        let endpoint = format!("https://localhost:{}", gateway.addr.port());
+        let mut worker = isolated_command(&std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "multiplex::relay_auth_tests::windows_access_tests::supervisor_access_worker",
+                "--ignored",
+                "--nocapture",
+                "--test-threads=1",
+            ])
+            .env("OPENSHELL_TEST_ACCESS_ENDPOINT", &endpoint)
+            .env("OPENSHELL_TEST_ACCESS_NONCE", &nonce)
+            .env("OPENSHELL_TEST_ACCESS_KEY", &key_path)
+            .env("OPENSHELL_TLS_CA", gateway._pki.path().join("ca.pem"))
+            .env("OPENSHELL_SANDBOX_TOKEN_FILE", &token_path)
+            .spawn()
+            .unwrap();
+        let mut worker_output = tokio::io::BufReader::new(worker.stdout.take().unwrap()).lines();
+        loop {
+            let Some(line) = worker_output.next_line().await.unwrap() else {
+                let output = worker.wait_with_output().await.unwrap();
+                panic!(
+                    "worker ended before acceptance: {}",
+                    String::from_utf8_lossy(&output.stderr)
+                );
+            };
+            if line.contains("SESSION_ACCEPTED") {
+                break;
+            }
+        }
+        assert!(gateway.state.supervisor_sessions.has_session(SANDBOX_ID));
+        let session = gateway
+            .client(true)
+            .await
+            .create_ssh_session(CreateSshSessionRequest {
+                sandbox: SANDBOX_ID.into(),
+                workspace_scope: Some(openshell_core::proto::workspace_selector("default")),
+            })
+            .await
+            .unwrap()
+            .into_inner();
+        let spawn_proxy = || {
+            isolated_command(&cli)
+                .env("XDG_CONFIG_HOME", gateway._pki.path().join("client"))
+                .env("OPENSHELL_TELEMETRY_ENABLED", "false")
+                .args([
+                    "ssh-proxy",
+                    "--gateway",
+                    &format!("{endpoint}/proxy/connect"),
+                    "--sandbox",
+                    SANDBOX_ID,
+                    "--workspace",
+                    "default",
+                    "--token",
+                    &session.token,
+                ])
+                .spawn()
+                .unwrap()
+        };
+
+        // Reach the actual supervisor but reject its SSH identity before opening
+        // a main attachment. A following valid client must still acquire input.
+        let mut wrong = spawn_proxy();
+        let observed_key = Arc::new(Mutex::new(None));
+        let stream = tokio::io::join(wrong.stdout.take().unwrap(), wrong.stdin.take().unwrap());
+        assert!(
+            russh::client::connect_stream(
+                Arc::new(russh::client::Config::default()),
+                stream,
+                PinnedKey("SHA256:not-the-supervisor".into(), observed_key.clone())
+            )
+            .await
+            .is_err()
+        );
+        assert_eq!(
+            observed_key.lock().unwrap().as_deref(),
+            Some(fingerprint.as_str()),
+            "a transport failure before key verification is not a rejection control"
+        );
+        *observed_key.lock().unwrap() = None;
+        tokio::time::timeout(Duration::from_secs(5), wrong.wait())
+            .await
+            .unwrap()
+            .unwrap();
+
+        if public_connect {
+            let mut connect = isolated_command(&cli)
+                .env("XDG_CONFIG_HOME", gateway._pki.path().join("client"))
+                .env("OPENSHELL_TELEMETRY_ENABLED", "false")
+                .args([
+                    "--gateway",
+                    "openshell",
+                    "--gateway-endpoint",
+                    &endpoint,
+                    "--workspace",
+                    "default",
+                    "sandbox",
+                    "connect",
+                    SANDBOX_ID,
+                ])
+                .spawn()
+                .unwrap();
+            let mut input = connect.stdin.take().unwrap();
+            input
+                .write_all(format!("request:{nonce}\n").as_bytes())
+                .await
+                .unwrap();
+            input.flush().await.unwrap();
+            let result = tokio::time::timeout(Duration::from_secs(10), connect.wait_with_output())
+                .await
+                .expect("public connect must exit despite retained stdin")
+                .unwrap();
+            assert_eq!(
+                result.status.code(),
+                Some(23),
+                "public connect diagnostic: {}",
+                String::from_utf8_lossy(&result.stderr)
+            );
+            assert_eq!(
+                result.stdout,
+                format!("reply:{nonce}:café 窗口\n").as_bytes()
+            );
+            drop(input);
+        } else {
+            let mut proxy = spawn_proxy();
+            let stream = tokio::io::join(proxy.stdout.take().unwrap(), proxy.stdin.take().unwrap());
+            let mut client = russh::client::connect_stream(
+                Arc::new(russh::client::Config::default()),
+                stream,
+                PinnedKey(fingerprint.clone(), observed_key.clone()),
+            )
+            .await
+            .unwrap();
+            assert_eq!(
+                observed_key.lock().unwrap().as_deref(),
+                Some(fingerprint.as_str())
+            );
+            assert!(matches!(
+                client.authenticate_none("sandbox").await.unwrap(),
+                russh::client::AuthResult::Success
+            ));
+            let mut channel = client.channel_open_session().await.unwrap();
+            channel
+                .request_subsystem(true, "openshell-main")
+                .await
+                .unwrap();
+            assert!(matches!(
+                channel.wait().await,
+                Some(russh::ChannelMsg::Success)
+            ));
+            channel
+                .data(format!("request:{nonce}\n").as_bytes())
+                .await
+                .unwrap();
+            let mut output = Vec::new();
+            let mut status = None;
+            while let Some(message) = channel.wait().await {
+                match message {
+                    russh::ChannelMsg::Data { data } => {
+                        assert!(status.is_none(), "all output must precede terminal status");
+                        output.extend_from_slice(&data);
+                        assert!(output.len() < 4096);
+                    }
+                    russh::ChannelMsg::ExitStatus { exit_status } => {
+                        assert_eq!(output, format!("reply:{nonce}:café 窗口\n").as_bytes());
+                        assert!(status.replace(exit_status).is_none());
+                    }
+                    russh::ChannelMsg::Eof => {}
+                    russh::ChannelMsg::Close => break,
+                    _ => panic!("unexpected main attachment event"),
+                }
+            }
+            assert_eq!(
+                status,
+                Some(23),
+                "nonzero main exit must survive the full access route"
+            );
+            drop(channel);
+            drop(client);
+            assert!(
+                tokio::time::timeout(Duration::from_secs(5), proxy.wait())
+                    .await
+                    .unwrap()
+                    .unwrap()
+                    .success()
+            );
+        }
+        assert!(
+            tokio::time::timeout(Duration::from_secs(5), worker.wait())
+                .await
+                .unwrap()
+                .unwrap()
+                .success()
+        );
+        let mut drained = false;
+        while let Some(line) = worker_output.next_line().await.unwrap() {
+            drained |= line.contains("TERMINAL_DRAINED");
+        }
+        assert!(drained);
+        tokio::time::timeout(Duration::from_secs(3), async {
+            loop {
+                if gateway
+                    .state
+                    .ssh_connections_by_token
+                    .lock()
+                    .unwrap()
+                    .is_empty()
+                    && gateway
+                        .state
+                        .ssh_connections_by_sandbox
+                        .lock()
+                        .unwrap()
+                        .is_empty()
+                    && !gateway.state.supervisor_sessions.has_session(SANDBOX_ID)
+                {
+                    break;
+                }
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await
+        .expect("access route must release gateway ownership");
+    })
+    .await
+    .expect("native CLI/supervisor integration deadline");
+}
