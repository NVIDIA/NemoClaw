+fn deserialize_pipe_ports<'de, D>(deserializer: D) -> Result<Vec<u16>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    // google.protobuf.Struct represents every numeric value as a double.
+    let values = Vec::<f64>::deserialize(deserializer)?;
+    let mut ports = Vec::with_capacity(values.len().min(16));
+    for value in values {
+        if !(1.0..=65535.0).contains(&value) || value.fract() != 0.0 {
+            return Err(serde::de::Error::custom(
+                "pipe ports must be integers in 1..=65535",
+            ));
+        }
+        #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+        // The finite, positive integral range above is exactly representable as u16.
+        let port = value as u16;
+        ports.push(port);
+        openshell_mxc_boundary::launch::validate_loopback_pipe_ports(&ports)
+            .map_err(serde::de::Error::custom)?;
+    }
+    Ok(ports)
 }

