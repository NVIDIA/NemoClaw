+        environment.insert("OPENSHELL_CONPTY_TEST_MODE".into(), "tree-parent".into());
+        let process = ManagedProcess::spawn_terminal(
+            "owner-drop".into(),
+            ProcessKindWire::Exec,
+            std::env::current_exe().unwrap().to_str().unwrap().into(),
+            [
+                "--exact",
+                "conpty::tests::console_fixture",
+                "--ignored",
+                "--nocapture",
+                "--test-threads=1",
+            ]
+            .into_iter()
+            .map(str::to_string)
+            .collect(),
+            None,
+            environment,
+        )
+        .await
+        .unwrap();
+        let ProcessControl::Terminal(terminal) = &process.child else {
+            panic!("expected terminal");
+        };
+        // Retain a cleanup capability so a regression cannot leak the fixture.
+        let cleanup = terminal.clone();
+        // An in-flight writer can retain its input handle. Owner cleanup must
+        // not depend on closing stdin causing the console process to exit.
+        let retained_input = process.stdin.lock().await.take().unwrap();
+        let mut exit = process.exit.clone();
+        let mut cursor = process.output.cursor();
+        let mut transcript = Vec::new();
+        let ready = tokio::time::timeout(Duration::from_secs(10), async {
+            while !String::from_utf8_lossy(&transcript).contains(&format!("LEAF:{nonce}"))
+                || !String::from_utf8_lossy(&transcript).contains(":END")
+            {
+                let event = cursor.recv().await.expect("live console output");
+                assert_ne!(event.channel, STREAM_EXIT);
+                transcript.extend(event.payload);
+                assert!(transcript.len() < 128 * 1024);
+            }
+        })
+        .await;
+        let child_id: u32 = String::from_utf8_lossy(&transcript)
+            .split(&format!("CHILD:{nonce}:"))
+            .nth(1)
+            .expect("child PID marker")
+            .split(":END")
+            .next()
+            .unwrap()
+            .parse()
+            .unwrap();
+        // SAFETY: retain the observed child's handle before cancellation so
+        // PID reuse cannot satisfy the post-cleanup exit assertion.
+        let child = unsafe {
+            let handle = OpenProcess(PROCESS_SYNCHRONIZE, false, child_id).unwrap();
+            OwnedHandle::from_raw_handle(handle.0)
+        };
+        assert_eq!(
+            unsafe { WaitForSingleObject(HANDLE(child.as_raw_handle()), 0) },
+            WAIT_TIMEOUT
+        );
+        assert!(
+            exit.borrow().is_none(),
+            "job must be alive before owner drop"
+        );
+        if cancel_task {
+            let (started, ready) = tokio::sync::oneshot::channel();
+            let owner = tokio::spawn(async move {
+                let _owned_process = process;
+                let _ = started.send(());
+                std::future::pending::<()>().await;
+            });
+            tokio::time::timeout(Duration::from_secs(2), ready)
+                .await
+                .unwrap()
+                .unwrap();
+            owner.abort();
+            assert!(owner.await.unwrap_err().is_cancelled());
+        } else {
+            drop(process);
+        }
+        let stopped = tokio::time::timeout(Duration::from_secs(3), exit.changed()).await;
+        if let Some(terminal) = lock(&cleanup).as_ref() {
+            terminal.terminate().unwrap();
+        }
+        if stopped.is_err() {
+            tokio::time::timeout(Duration::from_secs(5), exit.changed())
+                .await
+                .expect("regression fixture cleanup")
+                .unwrap();
+        }
+        assert!(
+            lock(&cleanup).is_none(),
+            "monitor must finish terminal cleanup"
+        );
+        drop(retained_input);
+        assert_eq!(
+            unsafe { WaitForSingleObject(HANDLE(child.as_raw_handle()), 5000) },
+            WAIT_OBJECT_0,
+            "the live descendant must exit with its cancelled owner"
+        );
+        assert!(
+            ready.is_ok(),
+            "fixture must reach live descendant readiness"
+        );
+        assert!(
+            stopped.is_ok(),
+            "dropping the owner must stop the terminal job"
+        );
+        assert!(matches!(*exit.borrow(), Some(ExitStatusWire::Exited(_))));
+    }
+
