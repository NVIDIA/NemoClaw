+// Run in a child process: supervisor authentication uses process-wide token
+// slots, so mutating the test runner's environment would race unrelated tests.
+#[tokio::test]
+#[ignore = "subprocess fixture for native_cli_reaches_actual_supervisor_access"]
+async fn supervisor_access_worker() {
+    tokio::time::timeout(Duration::from_secs(20), async {
+        let _ = rustls::crypto::aws_lc_rs::default_provider().install_default();
+        let endpoint = std::env::var("OPENSHELL_TEST_ACCESS_ENDPOINT").unwrap();
+        let _channel = openshell_core::grpc_client::connect_channel_pub(&endpoint)
+            .await
+            .expect("worker must establish its pinned TLS and bearer channel");
+        let nonce = std::env::var("OPENSHELL_TEST_ACCESS_NONCE").unwrap();
+        let key = std::fs::read_to_string(std::env::var_os("OPENSHELL_TEST_ACCESS_KEY").unwrap())
+            .unwrap();
+        let key = openshell_supervisor_process::ssh::parse_host_key(Some(
+            &openshell_core::jwt::SecretSshHostKey::new(key),
+        ))
+        .unwrap();
+        let (input, mut received) = tokio::io::duplex(4096);
+        let (mut output, returned) = tokio::io::duplex(4096);
+        let boundary = Arc::new(BoundaryFixture(Mutex::new(Some(ProcessAttachment {
+            stdin: Box::new(input),
+            stdout: Box::new(returned),
+            stderr: Some(Box::new(tokio::io::empty())),
+            terminal: None,
+        }))));
+        let access = openshell_supervisor_process::delegated::start_boundary_access(
+            Some(SANDBOX_ID),
+            Some(&endpoint),
+            None,
+            false,
+            None,
+            boundary.clone(),
+            boundary.clone(),
+            boundary,
+            None,
+            Some(key),
+        )
+        .await
+        .unwrap();
+        let mut readiness = access.session_readiness().unwrap();
+        while !*readiness.borrow_and_update() {
+            readiness.changed().await.unwrap();
+        }
+        println!("SESSION_ACCEPTED");
+        let request = format!("request:{nonce}\n");
+        let mut bytes = vec![0; request.len()];
+        received.read_exact(&mut bytes).await.unwrap();
+        assert_eq!(bytes, request.as_bytes());
+        output
+            .write_all(format!("reply:{nonce}:café 窗口\n").as_bytes())
+            .await
+            .unwrap();
+        output.shutdown().await.unwrap();
+        drop(output);
+        access.publish_main_exit(23, true).await;
+        access.drain_main_terminal_delivery().await;
+        println!("TERMINAL_DRAINED");
+    })
+    .await
+    .expect("supervisor access worker deadline");
+}
+
+struct PinnedKey(String, Arc<Mutex<Option<String>>>);
+impl russh::client::Handler for PinnedKey {
+    type Error = russh::Error;
+    async fn check_server_key(
+        &mut self,
+        key: &russh::keys::PublicKeyOrCertificate,
+    ) -> Result<bool, Self::Error> {
+        let fingerprint = key
+            .public_key()
+            .fingerprint(russh::keys::HashAlg::Sha256)
+            .to_string();
+        *self.1.lock().unwrap() = Some(fingerprint.clone());
+        Ok(fingerprint == self.0)
+    }
+}
