@@ -0,0 +1,975 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Native terminal ownership inside the Windows boundary, never the supervisor.
+#![allow(unsafe_code)]
+
+use std::collections::{BTreeMap, HashMap};
+use std::ffi::c_void;
+use std::fs::File;
+use std::io::{self, Read};
+use std::mem::size_of;
+use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+use std::path::Path;
+use std::thread::JoinHandle;
+
+use windows::Win32::Foundation::{HANDLE, WAIT_OBJECT_0, WAIT_TIMEOUT};
+use windows::Win32::System::Console::{
+    COORD, ClosePseudoConsole, CreatePseudoConsole, HPCON, ResizePseudoConsole,
+};
+use windows::Win32::System::JobObjects::{
+    AssignProcessToJobObject, CreateJobObjectW, JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE,
+    JOBOBJECT_EXTENDED_LIMIT_INFORMATION, JobObjectExtendedLimitInformation,
+    SetInformationJobObject, TerminateJobObject,
+};
+use windows::Win32::System::Pipes::CreatePipe;
+use windows::Win32::System::Threading::{
+    CREATE_SUSPENDED, CREATE_UNICODE_ENVIRONMENT, CreateProcessW, DeleteProcThreadAttributeList,
+    EXTENDED_STARTUPINFO_PRESENT, GetExitCodeProcess, InitializeProcThreadAttributeList,
+    LPPROC_THREAD_ATTRIBUTE_LIST, PROC_THREAD_ATTRIBUTE_PSEUDOCONSOLE, PROCESS_INFORMATION,
+    ResumeThread, STARTF_USESTDHANDLES, STARTUPINFOEXW, TerminateProcess,
+    UpdateProcThreadAttribute, WaitForSingleObject,
+};
+use windows::core::{PCWSTR, PWSTR};
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidInput, message)
+}
+
+fn wide(value: &str) -> io::Result<Vec<u16>> {
+    if value.contains('\0') {
+        return Err(invalid("Windows process strings must not contain NUL"));
+    }
+    Ok(value.encode_utf16().chain(Some(0)).collect())
+}
+
+// Quote for the Windows CRT argv decoder; never invoke a shell. Leave simple
+// arguments bare so cmd.exe recognizes switches such as /D and /C.
+fn quote_argument(value: &str) -> String {
+    if !value.is_empty()
+        && !value.contains([
+            ' ', '\t', '\n', '\r', '"', '&', '|', '<', '>', '^', '(', ')', '%', '!',
+        ])
+    {
+        return value.to_string();
+    }
+    let mut result = String::from("\"");
+    let mut slashes = 0;
+    for ch in value.chars() {
+        if ch == '\\' {
+            slashes += 1;
+            continue;
+        }
+        result.extend(std::iter::repeat_n(
+            '\\',
+            slashes * if ch == '"' { 2 } else { 1 },
+        ));
+        if ch == '"' {
+            result.push('\\');
+        }
+        result.push(ch);
+        slashes = 0;
+    }
+    result.extend(std::iter::repeat_n('\\', slashes * 2));
+    result.push('"');
+    result
+}
+
+fn command_line(program: &str, args: &[String]) -> io::Result<Vec<u16>> {
+    let line = std::iter::once(program)
+        .chain(args.iter().map(String::as_str))
+        .map(quote_argument)
+        .collect::<Vec<_>>()
+        .join(" ");
+    let result = wide(&line)?;
+    if result.len() > 32767 {
+        return Err(invalid("Windows command line exceeds 32767 UTF-16 units"));
+    }
+    Ok(result)
+}
+
+fn environment_block(overrides: &HashMap<String, String>) -> io::Result<Vec<u16>> {
+    // Inherit only Windows runtime paths, never the boundary's ambient secrets.
+    // Workload/provider variables must arrive through governed overrides.
+    // Case folding prevents aliases from selecting an unintended proxy value.
+    let mut entries = BTreeMap::new();
+    for key in [
+        "SYSTEMROOT",
+        "WINDIR",
+        "PATH",
+        "COMSPEC",
+        "LOCALAPPDATA",
+        "TEMP",
+        "TMP",
+        "USERPROFILE",
+        "APPDATA",
+    ] {
+        if let Some(value) = std::env::var_os(key) {
+            let value = value
+                .into_string()
+                .map_err(|_| invalid("non-Unicode runtime path"))?;
+            entries.insert(key.to_string(), value);
+        }
+    }
+    let mut seen = HashMap::new();
+    for (key, value) in overrides {
+        if key.is_empty() || key.contains(['=', '\0']) || value.contains('\0') {
+            return Err(invalid("invalid Windows environment entry"));
+        }
+        let folded = key.to_uppercase();
+        if seen
+            .insert(folded.clone(), value)
+            .is_some_and(|previous| previous != value)
+        {
+            return Err(invalid(
+                "duplicate case-insensitive Windows environment key",
+            ));
+        }
+        entries.insert(key.to_uppercase(), value.clone());
+    }
+    let mut result = Vec::new();
+    for (key, value) in entries {
+        result.extend(wide(&format!("{key}={value}"))?);
+    }
+    if result.is_empty() {
+        result.push(0);
+    }
+    result.push(0);
+    Ok(result)
+}
+
+fn raw(handle: &OwnedHandle) -> HANDLE {
+    HANDLE(handle.as_raw_handle())
+}
+
+fn pipe() -> io::Result<(OwnedHandle, OwnedHandle)> {
+    let mut read = HANDLE::default();
+    let mut write = HANDLE::default();
+    // SAFETY: valid out-pointers. NULL security attributes make both ends
+    // non-inheritable. Each returned handle gains exactly one owner.
+    unsafe {
+        CreatePipe(&raw mut read, &raw mut write, None, 0)?;
+        Ok((
+            OwnedHandle::from_raw_handle(read.0),
+            OwnedHandle::from_raw_handle(write.0),
+        ))
+    }
+}
+
+struct Attributes {
+    storage: Vec<usize>,
+}
+
+impl Attributes {
+    fn new(console: HPCON) -> io::Result<Self> {
+        let mut bytes = 0;
+        // SAFETY: documented size query, then pointer-aligned live storage.
+        unsafe {
+            let _ = InitializeProcThreadAttributeList(None, 1, None, &raw mut bytes);
+            if bytes == 0 {
+                return Err(io::Error::last_os_error());
+            }
+            let mut storage = vec![0usize; bytes.div_ceil(size_of::<usize>())];
+            let pointer = LPPROC_THREAD_ATTRIBUTE_LIST(storage.as_mut_ptr().cast());
+            InitializeProcThreadAttributeList(Some(pointer), 1, None, &raw mut bytes)?;
+            let mut attributes = Self { storage };
+            UpdateProcThreadAttribute(
+                attributes.ptr(),
+                0,
+                PROC_THREAD_ATTRIBUTE_PSEUDOCONSOLE as usize,
+                Some(console.0 as *const c_void),
+                size_of::<HPCON>(),
+                None,
+                None,
+            )?;
+            Ok(attributes)
+        }
+    }
+
+    fn ptr(&mut self) -> LPPROC_THREAD_ATTRIBUTE_LIST {
+        LPPROC_THREAD_ATTRIBUTE_LIST(self.storage.as_mut_ptr().cast())
+    }
+}
+
+impl Drop for Attributes {
+    fn drop(&mut self) {
+        // SAFETY: list was initialized in this allocation, still alive here.
+        unsafe { DeleteProcThreadAttributeList(self.ptr()) };
+    }
+}
+
+pub(crate) struct Terminal {
+    process: Option<OwnedHandle>,
+    process_id: u32,
+    job: OwnedHandle,
+    console: Option<HPCON>,
+    reader: Option<JoinHandle<()>>,
+}
+
+impl Terminal {
+    pub(crate) fn spawn(
+        program: &str,
+        args: &[String],
+        workdir: Option<&str>,
+        environment: &HashMap<String, String>,
+        output: impl Fn(Vec<u8>) + Send + 'static,
+    ) -> io::Result<(Self, File)> {
+        // Avoid ambiguous CreateProcess search rules and shell/batch decoding.
+        if !Path::new(program).is_absolute()
+            || !Path::new(program)
+                .extension()
+                .is_some_and(|ext| ext.eq_ignore_ascii_case("exe"))
+        {
+            return Err(invalid(
+                "MXC terminal requires an absolute .exe program path",
+            ));
+        }
+        let application = wide(program)?;
+        let mut command = command_line(program, args)?;
+        let environment = environment_block(environment)?;
+        let directory = workdir
+            .filter(|value| !value.is_empty())
+            .map(wide)
+            .transpose()?;
+        let (input_read, input_write) = pipe()?;
+        let (output_read, output_write) = pipe()?;
+        // SAFETY: all handles/pointers below refer to owned live objects. The
+        // child is suspended until assigned to our non-breakaway job. No token
+        // substitution or inherited handles can move execution out of MXC.
+        unsafe {
+            let job = CreateJobObjectW(None, PCWSTR::null())?;
+            let mut terminal = Self {
+                process: None,
+                process_id: 0,
+                job: OwnedHandle::from_raw_handle(job.0),
+                console: None,
+                reader: None,
+            };
+            let mut limits = JOBOBJECT_EXTENDED_LIMIT_INFORMATION::default();
+            limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+            SetInformationJobObject(
+                raw(&terminal.job),
+                JobObjectExtendedLimitInformation,
+                (&raw const limits).cast(),
+                u32::try_from(size_of_val(&limits)).unwrap(),
+            )?;
+
+            // Dedicated synchronous reader: ClosePseudoConsole may wait for its
+            // output to drain, even on an error path. Never use the async pool
+            // or the thread that closes the console to drain that output.
+            terminal.reader = Some(
+                std::thread::Builder::new()
+                    .name("mxc-conpty-output".into())
+                    .spawn(move || {
+                        let mut file = File::from(output_read);
+                        let mut buffer = [0; 8192];
+                        loop {
+                            match file.read(&mut buffer) {
+                                Ok(0) => break,
+                                Ok(length) => output(buffer[..length].to_vec()),
+                                Err(error) if error.kind() == io::ErrorKind::Interrupted => {
+                                    continue;
+                                }
+                                Err(_) => break,
+                            }
+                        }
+                    })?,
+            );
+            // On failure the writer must close before terminal's reader joins.
+            let console = CreatePseudoConsole(
+                COORD { X: 80, Y: 24 },
+                raw(&input_read),
+                raw(&output_write),
+                0,
+            );
+            drop(input_read);
+            drop(output_write);
+            let console = console?;
+            terminal.console = Some(console);
+            let mut attributes = Attributes::new(console)?;
+            let mut startup = STARTUPINFOEXW::default();
+            startup.StartupInfo.cb = u32::try_from(size_of::<STARTUPINFOEXW>()).unwrap();
+            // Explicit NULL handles prevent redirected boundary stdio from
+            // replacing ConPTY's handles (even with bInheritHandles=false).
+            startup.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+            startup.lpAttributeList = attributes.ptr();
+            let mut info = PROCESS_INFORMATION::default();
+            CreateProcessW(
+                PCWSTR(application.as_ptr()),
+                Some(PWSTR(command.as_mut_ptr())),
+                None,
+                None,
+                false,
+                CREATE_SUSPENDED | CREATE_UNICODE_ENVIRONMENT | EXTENDED_STARTUPINFO_PRESENT,
+                Some(environment.as_ptr().cast()),
+                directory
+                    .as_ref()
+                    .map_or(PCWSTR::null(), |path| PCWSTR(path.as_ptr())),
+                &raw const startup.StartupInfo,
+                &raw mut info,
+            )?;
+            terminal.process = Some(OwnedHandle::from_raw_handle(info.hProcess.0));
+            terminal.process_id = info.dwProcessId;
+            let thread = OwnedHandle::from_raw_handle(info.hThread.0);
+            AssignProcessToJobObject(raw(&terminal.job), info.hProcess)?;
+            if ResumeThread(raw(&thread)) == u32::MAX {
+                return Err(io::Error::last_os_error());
+            }
+            Ok((terminal, File::from(input_write)))
+        }
+    }
+
+    pub(crate) fn process_id(&self) -> u32 {
+        self.process_id
+    }
+
+    pub(crate) fn try_wait(&self) -> io::Result<Option<i32>> {
+        let process = self
+            .process
+            .as_ref()
+            .ok_or_else(|| invalid("terminal process unavailable"))?;
+        // SAFETY: owned process handle remains alive for both calls.
+        unsafe {
+            match WaitForSingleObject(raw(process), 0) {
+                WAIT_TIMEOUT => Ok(None),
+                WAIT_OBJECT_0 => {
+                    let mut code = 0;
+                    GetExitCodeProcess(raw(process), &raw mut code)?;
+                    Ok(Some(i32::from_ne_bytes(code.to_ne_bytes())))
+                }
+                _ => Err(io::Error::last_os_error()),
+            }
+        }
+    }
+
+    pub(crate) fn terminate(&self) -> io::Result<()> {
+        // SAFETY: this job owns only this terminal's process tree.
+        unsafe { TerminateJobObject(raw(&self.job), 1)? };
+        Ok(())
+    }
+
+    pub(crate) fn resize(&self, cols: u16, rows: u16) -> io::Result<()> {
+        let cols = i16::try_from(cols).ok().filter(|value| *value > 0);
+        let rows = i16::try_from(rows).ok().filter(|value| *value > 0);
+        let (Some(cols), Some(rows)) = (cols, rows) else {
+            return Err(invalid("terminal dimensions must be between 1 and 32767"));
+        };
+        let console = self.console.ok_or_else(|| invalid("terminal is closed"))?;
+        // SAFETY: caller serializes access; console remains live for this call.
+        unsafe { ResizePseudoConsole(console, COORD { X: cols, Y: rows })? };
+        Ok(())
+    }
+}
+
+impl Drop for Terminal {
+    fn drop(&mut self) {
+        // SAFETY: on partial construction the process may not yet be in the
+        // job. Kill it explicitly as well. The reader remains active until
+        // ClosePseudoConsole returns, preventing a full-pipe shutdown deadlock.
+        unsafe {
+            let _ = TerminateJobObject(raw(&self.job), 1);
+            if let Some(process) = &self.process {
+                let _ = TerminateProcess(raw(process), 1);
+            }
+            if let Some(console) = self.console.take() {
+                ClosePseudoConsole(console);
+            }
+        }
+        if let Some(reader) = self.reader.take() {
+            let _ = reader.join();
+        }
+    }
+}
