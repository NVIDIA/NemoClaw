+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Windows SSH protocol adapter reachable only through the authenticated gateway
+//! session. There is no local socket, listener, or independently reachable endpoint.
+
+use std::future::Future;
+use std::io;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::task::{Context, Poll};
+
+use openshell_isolation_interface::contract::{BoundaryExec, BoundaryLoopbackConnector};
+use tokio::io::{AsyncRead, AsyncWrite, DuplexStream, ReadBuf};
+use tokio::sync::oneshot;
+
+use crate::main_session::MainSession;
+
+/// Retained protocol state; construction and opening are internal to access-plane
+/// composition and the accepted gateway session, respectively.
+pub struct RelaySshService {
+    config: Arc<russh::server::Config>,
+    port_forward: Arc<dyn BoundaryLoopbackConnector>,
+    boundary_exec: Arc<dyn BoundaryExec>,
+    main_session: Arc<MainSession>,
+    peer_timeout: std::time::Duration,
+}
+
+impl RelaySshService {
+    pub(crate) fn new(
+        host_key: russh::keys::PrivateKey,
+        port_forward: Arc<dyn BoundaryLoopbackConnector>,
+        boundary_exec: Arc<dyn BoundaryExec>,
+        main_session: Arc<MainSession>,
+    ) -> Self {
+        Self {
+            config: super::server_config(host_key),
+            port_forward,
+            boundary_exec,
+            main_session,
+            peer_timeout: super::SSH_PEER_TIMEOUT,
+        }
+    }
+
+    /// Only call after the gateway has accepted the supervisor session. SSH
+    /// authentication relies on that authorized relay, not on a second password.
+    pub(crate) fn open(&self) -> RelaySshStream {
+        let (client, server) = tokio::io::duplex(64 * 1024);
+        let (cancel, cancelled) = oneshot::channel();
+        let config = self.config.clone();
+        let port_forward = self.port_forward.clone();
+        let boundary_exec = self.boundary_exec.clone();
+        let main_session = self.main_session.clone();
+        let peer_timeout = self.peer_timeout;
+        tokio::spawn(async move {
+            // Russh owns an internal task. Abort of the outer task alone would
+            // detach it; cancellation therefore closes the actual stream, even
+            // when it is blocked writing to an unresponsive relay.
+            let stream = CancelledStream {
+                stream: server,
+                cancelled,
+                closed: false,
+            };
+            if let Err(error) = super::serve_stream(
+                stream,
+                config,
+                port_forward,
+                boundary_exec,
+                Some(main_session),
+                peer_timeout,
+            )
+            .await
+            {
+                tracing::debug!(%error, "authenticated in-process SSH relay ended");
+            }
+        });
+        RelaySshStream {
+            stream: client,
+            _cancel: cancel,
+        }
+    }
+
+    #[cfg(test)]
+    pub(super) fn with_test_timing(
+        host_key: russh::keys::PrivateKey,
+        port_forward: Arc<dyn BoundaryLoopbackConnector>,
+        boundary_exec: Arc<dyn BoundaryExec>,
+        main_session: Arc<MainSession>,
+        interval: std::time::Duration,
+        timeout: std::time::Duration,
+    ) -> Self {
+        let mut service = Self::new(host_key, port_forward, boundary_exec, main_session);
+        let config = Arc::get_mut(&mut service.config).unwrap();
+        config.keepalive_interval = config.keepalive_interval.map(|_| interval);
+        service.peer_timeout = timeout;
+        service
+    }
+}
+
+/// Dropping the owning relay actively wakes both SSH read and write operations.
+/// A write half-close alone still permits final output to drain.
+pub(crate) struct RelaySshStream {
+    stream: DuplexStream,
+    _cancel: oneshot::Sender<()>,
+}
+
+struct CancelledStream {
+    stream: DuplexStream,
+    cancelled: oneshot::Receiver<()>,
+    closed: bool,
+}
+
+impl CancelledStream {
+    fn check_cancelled(&mut self, cx: &mut Context<'_>) -> io::Result<()> {
+        if self.closed || Pin::new(&mut self.cancelled).poll(cx).is_ready() {
+            self.closed = true;
+            return Err(io::Error::new(
+                io::ErrorKind::ConnectionAborted,
+                "owning gateway relay closed",
+            ));
+        }
+        Ok(())
+    }
+}
+
+impl AsyncRead for CancelledStream {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        self.check_cancelled(cx)?;
+        Pin::new(&mut self.stream).poll_read(cx, buf)
+    }
+}
+
+impl AsyncWrite for CancelledStream {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        self.check_cancelled(cx)?;
+        Pin::new(&mut self.stream).poll_write(cx, buf)
+    }
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        self.check_cancelled(cx)?;
+        Pin::new(&mut self.stream).poll_flush(cx)
+    }
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        self.check_cancelled(cx)?;
+        Pin::new(&mut self.stream).poll_shutdown(cx)
+    }
+}
+
+impl AsyncRead for RelaySshStream {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.stream).poll_read(cx, buf)
+    }
+}
+
+impl AsyncWrite for RelaySshStream {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        Pin::new(&mut self.stream).poll_write(cx, buf)
+    }
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.stream).poll_flush(cx)
+    }
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.stream).poll_shutdown(cx)
+    }
+}
