+
+    #[test]
+    fn rejects_ambiguous_environment_keys() {
+        assert!(
+            environment_block(&HashMap::from([
+                ("PATH".into(), "one".into()),
+                ("Path".into(), "two".into())
+            ]))
+            .is_err()
+        );
+        for key in ["", "A=B", "A\0B"] {
+            assert!(environment_block(&HashMap::from([(key.into(), "value".into())])).is_err());
+        }
+        assert!(environment_block(&HashMap::from([("A".into(), "bad\0value".into())])).is_err());
+        let block = environment_block(&HashMap::from([
+            ("HTTP_PROXY".into(), "http://governed.invalid:1234".into()),
+            ("http_proxy".into(), "http://governed.invalid:1234".into()),
+        ]))
+        .unwrap();
+        let decoded = String::from_utf16(&block).unwrap();
+        let entries: Vec<_> = decoded
+            .split('\0')
+            .filter(|item| !item.is_empty())
+            .collect();
+        assert_eq!(
+            entries
+                .iter()
+                .filter(|entry| entry.starts_with("HTTP_PROXY="))
+                .count(),
+            1
+        );
+        for entry in entries {
+            let key = entry.split_once('=').unwrap().0;
+            assert!(
+                [
+                    "SYSTEMROOT",
+                    "WINDIR",
+                    "PATH",
+                    "COMSPEC",
+                    "LOCALAPPDATA",
+                    "TEMP",
+                    "TMP",
+                    "USERPROFILE",
+                    "APPDATA",
+                    "HTTP_PROXY"
+                ]
+                .contains(&key)
+            );
+        }
+    }
