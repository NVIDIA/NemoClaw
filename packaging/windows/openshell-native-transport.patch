new file mode 100644
index 0000000000000000000000000000000000000000..1b63ffe2f761e372f8f7f4dbf73df608512e0589
--- /dev/null
+++ b/crates/openshell-mxc-boundary/src/control_stdio.rs
@@ -0,0 +1,407 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Bounded, sequential transport for the existing TLS Sandbox Protocol.
+//! Framing separates discovery, attachment and reconnect without granting a
+//! second host TCP endpoint to the sandbox. It does not authenticate messages.
+
+use std::{future::Future, io, net::SocketAddr, time::Duration};
+use tokio::io::{AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt, DuplexStream};
+
+const MAGIC: &[u8; 8] = b"MXCSIO1\n";
+const FRAME_BYTES: usize = 16 * 1024;
+const DRAIN_TIMEOUT: Duration = Duration::from_secs(5);
+
+async fn drain_after_finish<T>(
+    mut finished: tokio::sync::watch::Receiver<bool>,
+    operation: impl Future<Output = io::Result<T>>,
+) -> io::Result<T> {
+    tokio::pin!(operation);
+    tokio::select! {
+        result = &mut operation => result,
+        _ = finished.changed() => {
+            tokio::time::timeout(DRAIN_TIMEOUT, operation).await
+                .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "MXC control drain timed out"))?
+        }
+    }
+}
+
+async fn session<R, W, F, Fut>(reader: &mut R, writer: &mut W, handler: F) -> io::Result<()>
+where
+    R: AsyncRead + Unpin,
+    W: AsyncWrite + Unpin,
+    F: FnOnce(DuplexStream) -> Fut,
+    Fut: Future<Output = io::Result<()>>,
+{
+    let (application, transport) = tokio::io::duplex(FRAME_BYTES * 2);
+    let (mut outgoing, mut incoming) = tokio::io::split(transport);
+    let (finished, finish_rx) = tokio::sync::watch::channel(false);
+    let transmit = async {
+        let mut bytes = vec![0; FRAME_BYTES];
+        loop {
+            let count = outgoing.read(&mut bytes).await?;
+            writer.write_u32(count as u32).await?;
+            writer.write_all(&bytes[..count]).await?;
+            writer.flush().await?;
+            if count == 0 {
+                return Ok(());
+            }
+        }
+    };
+    let receive = async {
+        let mut bytes = vec![0; FRAME_BYTES];
+        let mut receiver_closed = false;
+        loop {
+            let count = reader.read_u32().await? as usize;
+            if count > FRAME_BYTES {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "oversized MXC control frame",
+                ));
+            }
+            if count == 0 {
+                return incoming.shutdown().await;
+            }
+            reader.read_exact(&mut bytes[..count]).await?;
+            if !receiver_closed {
+                match incoming.write_all(&bytes[..count]).await {
+                    Ok(()) => {}
+                    Err(error) if error.kind() == io::ErrorKind::BrokenPipe => {
+                        receiver_closed = true
+                    }
+                    Err(error) => return Err(error),
+                }
+            }
+        }
+    };
+    let handle = async {
+        let result = handler(application).await;
+        let _ = finished.send(true);
+        result
+    };
+    tokio::try_join!(
+        handle,
+        drain_after_finish(finish_rx.clone(), transmit),
+        drain_after_finish(finish_rx, receive),
+    )?;
+    Ok(())
+}
+
+/// Run successive TLS sessions on inherited pipes. A malformed/truncated frame
+/// ends the entire transport; never scan for a new header after corruption.
+pub async fn run_client<R, W, F, Fut>(
+    mut reader: R,
+    mut writer: W,
+    mut handler: F,
+) -> io::Result<()>
+where
+    R: AsyncRead + Unpin,
+    W: AsyncWrite + Unpin,
+    F: FnMut(DuplexStream) -> Fut,
+    Fut: Future<Output = io::Result<()>>,
+{
+    for sequence in 1..=u64::MAX {
+        writer.write_all(MAGIC).await?;
+        writer.write_u64(sequence).await?;
+        writer.flush().await?;
+        session(&mut reader, &mut writer, &mut handler).await?;
+        tokio::time::sleep(Duration::from_millis(200)).await;
+    }
+    Err(io::Error::other("MXC control sequence exhausted"))
+}
+
+/// Forward only to the provisioned host control endpoint. The host connector
+/// still verifies pinned TLS and the boundary still verifies supervisor JWTs.
+pub async fn relay<R, W>(mut reader: R, mut writer: W, address: SocketAddr) -> io::Result<()>
+where
+    R: AsyncRead + Unpin,
+    W: AsyncWrite + Unpin,
+{
+    if !address.ip().is_loopback() || address.port() == 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "MXC control relay requires loopback",
+        ));
+    }
+    for sequence in 1..=u64::MAX {
+        let mut magic = [0; 8];
+        reader.read_exact(&mut magic).await?;
+        if &magic != MAGIC || reader.read_u64().await? != sequence {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "invalid MXC control session header",
+            ));
+        }
+        let mut stream = tokio::time::timeout(Duration::from_secs(30), async {
+            loop {
+                match openshell_core::net::connect_tcp_nodelay_best_effort(&[address]).await {
+                    Ok(stream) => return stream,
+                    Err(_) => tokio::time::sleep(Duration::from_millis(200)).await,
+                }
+            }
+        })
+        .await
+        .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "MXC control listener unavailable"))?;
+        session(&mut reader, &mut writer, |mut application| async move {
+            match tokio::io::copy_bidirectional(&mut application, &mut stream).await {
+                Ok(_) => Ok(()),
+                Err(error)
+                    if matches!(
+                        error.kind(),
+                        io::ErrorKind::ConnectionAborted
+                            | io::ErrorKind::ConnectionReset
+                            | io::ErrorKind::BrokenPipe
+                    ) =>
+                {
+                    // Discovery can drop TCP without a graceful TLS shutdown.
+                    // Drain this framed session before the next authenticated one.
+                    tracing::debug!(%error, "MXC control TCP session closed");
+                    Ok(())
+                }
+                Err(error) => Err(error),
+            }
+        })
+        .await?;
+    }
+    Err(io::Error::other("MXC control sequence exhausted"))
+}
