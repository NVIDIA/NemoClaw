+impl Drop for ManagedProcess {
+    fn drop(&mut self) {
+        if let ProcessControl::Terminal(terminal) = &self.child {
+            // The monitor retains the terminal until exit. End its owned job
+            // even if an in-flight input operation keeps the pipe open; stdin
+            // closure is not the process-lifetime boundary. The monitor still
+            // drains and closes ConPTY off the async executor before EXIT.
+            if let Some(terminal) = lock(terminal).as_ref() {
+                let _ = terminal.terminate();
+            }
+        }
+    }
+}
