<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>NemoClaw.Bootstrapper</AssemblyName>
    <RootNamespace>Nvidia.NemoClaw.Bootstrapper</RootNamespace>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PlatformTarget>ARM64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <ApplicationIcon>..\assets\NemoClaw.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>$(ProductVersion)</Version>
    <AssemblyVersion>$(ProductVersion).0</AssemblyVersion>
    <FileVersion>$(ProductVersion).0</FileVersion>
    <!-- The legacy preview keeps its original fixed input. Finished packages
         must supply the digest admitted from their same-run MXC build. -->
    <MxcProbeSha256 Condition="'$(ImmutableRuntimePackage)' != 'true' and '$(MxcProbeSha256)' == ''">dde1c592270e9a659b01dccad70362da7b99fec114885fa4d625507aa775a503</MxcProbeSha256>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NemoClaw.MxcProbeSha256" Value="$(MxcProbeSha256)" />
    <EmbeddedResource Include="$(ImmutableRuntimeAvailabilityFile)" LogicalName="Nvidia.NemoClaw.NativeRuntimeAvailability.json" Condition="'$(ImmutableRuntimeAvailabilityFile)' != ''" />
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="5.0.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\runtime\native-inference-manifest.json" LogicalName="Nvidia.NemoClaw.NativeInferenceManifest.json" />
    <EmbeddedResource Include="..\runtime\native-local-models.json" LogicalName="Nvidia.NemoClaw.NativeLocalModels.json" />
    <Resource Include="..\assets\NemoClawLogo.png" Link="Assets\NemoClawLogo.png" />
    <Resource Include="..\onboarding\assets\openclaw.png" Link="Assets\openclaw.png" />
    <Resource Include="..\onboarding\assets\hermes.png" Link="Assets\hermes.png" />
  </ItemGroup>
  <Target Name="ValidateImmutableRuntimePresentation" BeforeTargets="BeforeBuild">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(MxcProbeSha256)', '^[a-f0-9]{64}$'))" Text="Setup requires the exact admitted MXC probe SHA-256 before compilation." />
    <Error Condition="'$(ImmutableRuntimePackage)' == 'true' and !Exists('$(ImmutableRuntimeAvailabilityFile)')" Text="A finished runtime package requires its exact bounded availability input." />
  </Target>
</Project>
