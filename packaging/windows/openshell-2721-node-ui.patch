+            env: Vec::new(),
+            timeout: 0,
+        };
+        let personal = MxcProcessContainer {
+            personal_network: true,
+            capabilities: vec!["privateNetworkClientServer".into()],
+            ..Default::default()
+        };
+        let enabled = oneshot_config_json("personal", &filesystem, &personal, &process, None);
+        assert_eq!(enabled["network"]["defaultPolicy"], "allow");
+        assert_eq!(enabled["network"]["allowLocalNetwork"], true);
+        assert_eq!(
+            enabled["processContainer"]["capabilities"],
+            serde_json::json!(["privateNetworkClientServer", "internetClient"])
+        );
+        let already_enabled = MxcProcessContainer {
+            capabilities: vec!["privateNetworkClientServer".into(), "internetClient".into()],
+            personal_network: true,
+            ..Default::default()
+        };
+        assert_eq!(
+            oneshot_config_json("existing", &filesystem, &already_enabled, &process, None)["processContainer"]
+                ["capabilities"],
+            enabled["processContainer"]["capabilities"]
+        );
+
+        assert_eq!(
+            enabled["filesystem"]["readwritePaths"],
+            serde_json::json!(["C:\\NemoClawData\\agent"])
+        );
+        let default = oneshot_config_json(
+            "default",
+            &filesystem,
+            &MxcProcessContainer::default(),
+            &process,
+            None,
+        );
+        assert!(default.get("network").is_none());
+        assert!(default["processContainer"].get("capabilities").is_none());
+        assert_eq!(enabled["filesystem"], default["filesystem"]);
+        let loopback = MxcProcessContainer {
+            host_loopback: true,
+            ..Default::default()
+        };
+        let restricted = oneshot_config_json("loopback", &filesystem, &loopback, &process, None);
+        assert_eq!(restricted["network"]["defaultPolicy"], "block");
+    }
