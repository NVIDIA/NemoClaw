{
  "formatVersion": 0,
  "name": "inspect_gh_job_log",
  "description": "Inspect a GitHub Actions job log with regex filtering, caller-selected head/tail clipping, and explicit truncation metadata.",
  "parameters": {
    "type": "object",
    "properties": {
      "workdir": {
        "type": "string"
      },
      "jobId": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "repo": {
        "type": "string"
      },
      "pattern": {
        "type": "string"
      },
      "contextLines": {
        "type": "integer"
      },
      "maxLines": {
        "type": "integer",
        "description": "Maximum log lines to return after filtering; defaults to 120 and is capped at 500."
      },
      "clipMode": {
        "type": "string",
        "enum": ["head", "tail"],
        "description": "Which end of filtered output to retain when clipping; defaults to tail."
      }
    },
    "required": ["workdir", "jobId"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "jobId": {
        "type": "string"
      },
      "repo": {
        "type": "string"
      },
      "pattern": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "code": {
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      },
      "matchedLines": {
        "type": "integer"
      },
      "stdout": {
        "type": "string"
      },
      "stderr": {
        "type": "string"
      },
      "truncationNotice": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "truncationReasons": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "clipMode": {
        "type": "string",
        "enum": ["head", "tail"]
      },
      "maxLines": {
        "type": "integer"
      },
      "selectedLines": {
        "type": "integer"
      },
      "returnedLines": {
        "type": "integer"
      },
      "omittedLines": {
        "type": "integer"
      }
    },
    "required": [
      "jobId",
      "repo",
      "pattern",
      "code",
      "truncated",
      "truncationNotice",
      "truncationReasons",
      "clipMode",
      "maxLines",
      "selectedLines",
      "returnedLines",
      "omittedLines",
      "matchedLines",
      "stdout",
      "stderr"
    ],
    "additionalProperties": false
  },
  "revision": 5
}
