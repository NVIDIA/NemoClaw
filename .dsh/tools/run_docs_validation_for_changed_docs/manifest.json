{
  "formatVersion": 0,
  "name": "run_docs_validation_for_changed_docs",
  "description": "Detect changed docs and run guarded documentation validation.",
  "parameters": {
    "type": "object",
    "properties": {
      "workdir": {
        "type": "string"
      },
      "baseRef": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9_./][A-Za-z0-9_./-]*$"
      },
      "runDocs": {
        "type": "boolean"
      },
      "dryRun": {
        "type": "boolean"
      }
    },
    "required": ["workdir"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "additionalProperties": true
  },
  "revision": 2
}
