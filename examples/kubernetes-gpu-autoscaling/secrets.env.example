#
# Copy to secrets.env (gitignored) and paste keys after the =.
# Do not quote values. Do not commit secrets.env.
#
# NGC_API_KEY is the NGC key from NVIDIA NGC (https://org.ngc.nvidia.com).
# That is not an NVIDIA API key (nvapi- from build.nvidia.com).
# Create it at https://org.ngc.nvidia.com/account/api-keys.
# Required for NIM (6c). apply-local-secrets.sh stores it as both
# ngc-registry (dockerconfigjson; kubelet pulls the NIM image) and
# nim-ngc-key (Opaque env NGC_API_KEY; NIM downloads the model profile).
# Public vLLM (6b) needs neither Secret.
#
# HF_TOKEN is optional. Set it only if Hugging Face returns 401 for a gated vLLM model.

NGC_API_KEY=
HF_TOKEN=

# Optional. OpenClaw Control UI web search on sandbox 0 only (same as
# nemoclaw onboard). Default e2e pin leaves search off. After setting a key:
#   NEMOCLAW_WEB_SEARCH_ENABLED=1 E2E_USERS=5 ./scripts/publish-openclaw-remote-http.sh
# NEMOCLAW_WEB_SEARCH_ENABLED=1
# NEMOCLAW_WEB_SEARCH_PROVIDER=brave
# BRAVE_API_KEY=
# TAVILY_API_KEY=
