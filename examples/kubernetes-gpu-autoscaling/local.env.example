#
# Copy to local.env (gitignored) and edit for your cluster.
# install-hpa.sh, hpa-reset.sh, hpa-load-test-dgx-8xh100.sh, and
# hpa-load-test-brev-4xl40s.sh auto-source local.env from this recipe directory
# — works even if you invoke the scripts from another cwd.
#
# Paths are resolved from this file's location (not $PWD), so they stay correct
# when the shell's working directory changes. Already-exported vars win over these
# defaults (${VAR:-...}).

_RECIPE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Chart values (ClusterIP HTTP Envoy).
HPA_VALUES="${HPA_VALUES:-${_RECIPE_DIR}/values.yaml}"
export HPA_VALUES

# Optional. Must match ingress.host when set.
INGRESS_HOST="${INGRESS_HOST:-nemoclaw.example.com}"
export INGRESS_HOST

# MicroK8s: gpu-operator-resources. k3s / standard NVIDIA GPU Operator: gpu-operator.
# export DCGM_NAMESPACE="${DCGM_NAMESPACE:-gpu-operator}"

# On a cluster-managed monitoring installation, set USE_EXISTING_PROMETHEUS=auto
# to discover one deployed kube-prometheus-stack, or set all four values below to
# require this specific stack. The installer configures its adapter with the recipe's
# GPU HPA rules. Leave this unset for the Brev-tested self-managed default.
# export USE_EXISTING_PROMETHEUS=auto
# export USE_EXISTING_PROMETHEUS=1
# export MONITORING_NS=prometheus
# export PROM_RELEASE=kube-prometheus-stack
# export ADAPTER_RELEASE=prometheus-adapter

# Optional:
# export INFERENCE_MODEL="${INFERENCE_MODEL:-llama3.2:3b}"
# Pin GPU inference and sandboxes to one node (do not leave unset on a shared cluster).
# On-prem validation is a DGX 8× H100 — set this to that node's Kubernetes hostname.
# export NEMOCLAW_TARGET_NODE=

# NIM (6c): paste NGC_API_KEY into gitignored secrets.env, then
# ./scripts/apply-local-secrets.sh --replace. Keep only Secret *names* here.
# Public vLLM (6b) needs no NGC Secret.
# export INFERENCE_RUNTIME=nim
# export INFERENCE_MODEL=nvidia/nemotron-3-nano
# export NIM_NGC_API_KEY_SECRET=nim-ngc-key
# export NIM_IMAGE_PULL_SECRET=ngc-registry
#
# Optional vLLM only if nvcr.io requires a pull Secret, or the HF model is gated.
# export VLLM_IMAGE_PULL_SECRET=ngc-registry
# export VLLM_HF_TOKEN_SECRET=hf-token

# Fast HPA-only (keep): ./scripts/hpa-load-test-dgx-8xh100.sh (8× H100, pod-IP Job)
#                       HPA_METRIC=latency_avg HPA_TARGET_LATENCY_MS=3000 ./scripts/hpa-load-test-dgx-8xh100.sh
# OpenClaw + Ollama (two terminals; this DGX GPU-util success path used E2E_USERS=5):
#            ./scripts/agentscaling_gpuutil.sh   then   ./scripts/client.sh
#            ./scripts/agentscaling_latency.sh   then   ./scripts/client.sh   (same client)
#            E2E_USERS=10 ./scripts/agentscaling_hermes_gpuutil.sh then ./scripts/client_hermes.sh (Hermes + public vLLM)
#            E2E_USERS=10 ./scripts/agentscaling_hermes_latency.sh then ./scripts/client_hermes.sh
#            Do not run Hermes e2e while OpenClaw e2e owns GPUs.
#            ./scripts/hpa-load-test-brev-4xl40s.sh (4× L40S on AWS)
# export E2E_USERS=5

unset _RECIPE_DIR
