{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NVIDIA/NemoClaw/schemas/dcode-validation-profile.schema.json",
  "$comment": "SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\nSPDX-License-Identifier: Apache-2.0",
  "title": "NemoClaw managed DCode validation profile",
  "description": "An immutable, sandbox-bound list of exact headless validation argv shapes. The contentDigest is the sha256 digest of the canonical JSON object after removing contentDigest and recursively sorting object keys. Runtime semantic validation additionally rejects shell syntax, credential-shaped environment names and values, duplicate identifiers, non-normalized paths, and working directories outside workingDirectoryRoots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentDigest",
    "sandboxName",
    "taskIdentity",
    "sourceIdentity",
    "workingDirectoryRoots",
    "commands"
  ],
  "properties": {
    "schemaVersion": {
      "const": "nemoclaw.dcode.validation-profile.v1"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sandboxName": {
      "$ref": "#/$defs/identity"
    },
    "taskIdentity": {
      "$ref": "#/$defs/identity"
    },
    "sourceIdentity": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "workingDirectoryRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/absolutePath"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "workingDirectory",
        "environment",
        "timeoutSeconds",
        "maxOutputBytes",
        "maxInvocations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "workingDirectory": {
          "$ref": "#/$defs/absolutePath"
        },
        "environment": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "maxInvocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  }
}
