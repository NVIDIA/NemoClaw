const MINUTE_MS = 60_000;

// The live test installs once, rebuilds three times, waits for two stopped
// source transitions, and proves native readiness after each rebuild.
export const REBUILD_OPENCLAW_INSTALL_TIMEOUT_MS = 20 * MINUTE_MS;
export const REBUILD_OPENCLAW_REBUILD_TIMEOUT_MS = 20 * MINUTE_MS;
export const REBUILD_OPENCLAW_REBUILD_COUNT = 3;
export const REBUILD_OPENCLAW_CONVERGENCE_TIMEOUT_MS = MINUTE_MS;
export const REBUILD_OPENCLAW_CONVERGENCE_COUNT = 2;
export const REBUILD_OPENCLAW_NATIVE_READINESS_TIMEOUT_MS = 3 * MINUTE_MS;
export const REBUILD_OPENCLAW_NATIVE_READINESS_COUNT = 3;
export const REBUILD_OPENCLAW_PRE_CLEANUP_TIMEOUT_MS = 2 * MINUTE_MS;
export const REBUILD_OPENCLAW_STOP_TIMEOUT_MS = 2 * MINUTE_MS;
export const REBUILD_OPENCLAW_KILL_TIMEOUT_MS = 30_000;
// The killed-source proof also stops Docker, rejects uninstall, then restores Docker.
export const REBUILD_OPENCLAW_DOCKER_OUTAGE_PROOF_BUDGET_MS = MINUTE_MS + 2 * MINUTE_MS + 90_000;

export const REBUILD_OPENCLAW_REQUIRED_OPERATION_BUDGET_MS =
  REBUILD_OPENCLAW_PRE_CLEANUP_TIMEOUT_MS +
  REBUILD_OPENCLAW_INSTALL_TIMEOUT_MS +
  REBUILD_OPENCLAW_REBUILD_COUNT * REBUILD_OPENCLAW_REBUILD_TIMEOUT_MS +
  REBUILD_OPENCLAW_CONVERGENCE_COUNT * REBUILD_OPENCLAW_CONVERGENCE_TIMEOUT_MS +
  REBUILD_OPENCLAW_NATIVE_READINESS_COUNT * REBUILD_OPENCLAW_NATIVE_READINESS_TIMEOUT_MS +
  REBUILD_OPENCLAW_STOP_TIMEOUT_MS +
  REBUILD_OPENCLAW_KILL_TIMEOUT_MS +
  REBUILD_OPENCLAW_DOCKER_OUTAGE_PROOF_BUDGET_MS;

// Cover source inspection, plugin setup, state proofs, and artifact writes,
// then retain headroom when the runner is slow between bounded commands.
export const REBUILD_OPENCLAW_SOURCE_PROOF_BUDGET_MS = 15 * MINUTE_MS;
export const REBUILD_OPENCLAW_TEST_HEADROOM_MS = 9 * MINUTE_MS;
export const REBUILD_OPENCLAW_TEST_TIMEOUT_MS =
  Math.ceil(
    (REBUILD_OPENCLAW_REQUIRED_OPERATION_BUDGET_MS +
      REBUILD_OPENCLAW_SOURCE_PROOF_BUDGET_MS +
      REBUILD_OPENCLAW_TEST_HEADROOM_MS) /
      MINUTE_MS,
  ) * MINUTE_MS;
export const REBUILD_OPENCLAW_TEST_TIMEOUT_MINUTES = REBUILD_OPENCLAW_TEST_TIMEOUT_MS / MINUTE_MS;

// The reusable workflow also prepares the candidate before Vitest starts and
// must still run cleanup, sanitize traces, and upload artifacts afterward.
export const REBUILD_OPENCLAW_PRE_TEST_SETUP_BUDGET_MS = 30 * MINUTE_MS;
export const REBUILD_OPENCLAW_POST_TEST_CLEANUP_BUDGET_MS = 10 * MINUTE_MS;
export const REBUILD_OPENCLAW_WORKFLOW_FINALIZATION_BUDGET_MS = 10 * MINUTE_MS;
export const REBUILD_OPENCLAW_TARGET_TIMEOUT_MINUTES =
  (REBUILD_OPENCLAW_PRE_TEST_SETUP_BUDGET_MS +
    REBUILD_OPENCLAW_TEST_TIMEOUT_MS +
    REBUILD_OPENCLAW_POST_TEST_CLEANUP_BUDGET_MS +
    REBUILD_OPENCLAW_WORKFLOW_FINALIZATION_BUDGET_MS) /
  MINUTE_MS;
