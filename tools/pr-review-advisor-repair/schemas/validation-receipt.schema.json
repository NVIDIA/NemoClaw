{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NVIDIA/NemoClaw/tools/pr-review-advisor-repair/schemas/validation-receipt.schema.json",
  "title": "Trusted PR Review Advisor repair Phase 0 validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "attemptKey",
    "repository",
    "prNumber",
    "headRef",
    "sourceHeadSha",
    "baseSha",
    "advisor",
    "findingIds",
    "patchSha256",
    "candidateTreeSha",
    "changedPaths",
    "validation",
    "productScope",
    "optIn",
    "outcome",
    "reason"
  ],
  "properties": {
    "version": { "const": 1 },
    "attemptKey": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository": { "const": "NVIDIA/NemoClaw" },
    "prNumber": { "type": "integer", "minimum": 1 },
    "headRef": { "type": "string", "minLength": 1, "maxLength": 255 },
    "sourceHeadSha": { "$ref": "#/$defs/sha" },
    "baseSha": { "$ref": "#/$defs/sha" },
    "advisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowSha", "runId", "runAttempt", "artifactIds"],
      "properties": {
        "workflowSha": { "$ref": "#/$defs/sha" },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "artifactIds": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "findingIds": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/findingId" }
    },
    "patchSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidateTreeSha": { "$ref": "#/$defs/sha" },
    "changedPaths": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "mode", "type", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "status": { "enum": ["A", "D", "M"] },
          "mode": { "const": "100644" },
          "type": { "const": "blob" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateDigestBefore", "candidateDigestAfter", "commands"],
      "properties": {
        "candidateDigestBefore": { "$ref": "#/$defs/digest" },
        "candidateDigestAfter": { "$ref": "#/$defs/digest" },
        "commands": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["argv", "exitCode"],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": { "type": "string", "minLength": 1, "maxLength": 256 }
              },
              "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          }
        }
      }
    },
    "productScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "enum": ["accepted-issue", "maintainer-decision"] },
        "identity": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "optIn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor", "headSha"],
      "properties": {
        "kind": { "const": "phase0-manual-dispatch" },
        "actor": { "type": "string", "minLength": 1, "maxLength": 256 },
        "headSha": { "$ref": "#/$defs/sha" }
      }
    },
    "outcome": { "enum": ["validated", "rejected", "skipped"] },
    "reason": { "type": ["string", "null"], "maxLength": 1000 }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "findingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
