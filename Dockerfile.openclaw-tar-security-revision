ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG EXPECTED_OPENCLAW_VERSION
ARG TAR_VERSION=7.5.19
ARG TAR_INTEGRITY=sha512-4LeEWl96twnS2Q7Bz4MGqgazLqO+hJN63GZxXoIqh1T3VweYD997gbU1ItNsQafqqXTXd5WFyFdReLtwvRBNiw==
ARG TAR_TARBALL=https://registry.npmjs.org/tar/-/tar-7.5.19.tgz
ARG AXIOS_VERSION=1.18.0
ARG AXIOS_INTEGRITY=sha512-E32NzpYKp++W7XRe52rHiXV2ehxmh3wbdgO7MHeFM+vqxLBYHzt0ElkiImtOBxtOmyp0yoC8C6uESVV84Y2/hw==
ARG AXIOS_TARBALL=https://registry.npmjs.org/axios/-/axios-1.18.0.tgz
ARG HTTPS_PROXY_AGENT_VERSION=5.0.1
ARG HTTPS_PROXY_AGENT_INTEGRITY=sha512-dFcAjpTQFgoLMzC2VwU+C/CbS7uRL0lWmxDITmqm7C+7F0Odmj6s9l6alZc6AELXhrnggM2CeWSXHGOdX2YtwA==
ARG HTTPS_PROXY_AGENT_TARBALL=https://registry.npmjs.org/https-proxy-agent/-/https-proxy-agent-5.0.1.tgz
ARG AGENT_BASE_VERSION=6.0.2
ARG AGENT_BASE_INTEGRITY=sha512-RZNwNclF7+MS/8bDg70amg32dyeZGZxiDuQmZxKLAlQjr3jGyLx+4Kkk58UO7D2QdgFIQCovuSuZESne6RG6XQ==
ARG AGENT_BASE_TARBALL=https://registry.npmjs.org/agent-base/-/agent-base-6.0.2.tgz

COPY scripts/lib/reviewed-npm-archive.mts /scripts/lib/reviewed-npm-archive.mts
COPY scripts/lib/staged-replacement-transaction.mts /scripts/lib/staged-replacement-transaction.mts
COPY scripts/openclaw-tar-security-revision.mts /scripts/openclaw-tar-security-revision.mts
COPY scripts/npm-tar-security-revision.mts /scripts/npm-tar-security-revision.mts
COPY scripts/lib/reviewed-npm-archive.mts /usr/local/lib/nemoclaw/lib/reviewed-npm-archive.mts
COPY scripts/lib/staged-replacement-transaction.mts /usr/local/lib/nemoclaw/lib/staged-replacement-transaction.mts
COPY scripts/openclaw-plugin-axios-security-revision.mts /usr/local/lib/nemoclaw/openclaw-plugin-axios-security-revision.mts
COPY scripts/openclaw-security-revision-invocation.mts /usr/local/lib/nemoclaw/openclaw-security-revision-invocation.mts
COPY scripts/npm-tar-security-revision.mts /usr/local/lib/nemoclaw/npm-tar-security-revision.mts
COPY scripts/openclaw-security-revision-wrapper.sh /usr/local/bin/openclaw.security-wrapper
COPY scripts/npm-security-revision-wrapper.sh /usr/local/bin/npm.security-wrapper

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The npm viability probe changes directory only inside a disposable tree and
# installs one exact local tarball produced by the same probe.
# hadolint ignore=DL3003,DL3016
RUN set -euo pipefail; \
    test -n "$BASE_IMAGE"; \
    test -n "$EXPECTED_OPENCLAW_VERSION"; \
    test "$TAR_VERSION" = "7.5.19"; \
    TAR_PACK_PATH="$(node --experimental-strip-types /scripts/lib/reviewed-npm-archive.mts \
        --package-spec "tar@${TAR_VERSION}" \
        --integrity "$TAR_INTEGRITY" \
        --tarball-url "$TAR_TARBALL" \
        --label "tar ${TAR_VERSION}")"; \
    test -f "$TAR_PACK_PATH"; \
    while IFS= read -r member; do \
        case "$member" in package|package/*) ;; *) echo "ERROR: Unexpected tar archive member: $member" >&2; exit 1 ;; esac; \
        case "/$member/" in */../*) echo "ERROR: Parent traversal in tar archive: $member" >&2; exit 1 ;; esac; \
    done < <(tar -tzf "$TAR_PACK_PATH"); \
    tar -tvzf "$TAR_PACK_PATH" | awk 'substr($0, 1, 1) != "-" && substr($0, 1, 1) != "d" { exit 1 }'; \
    TAR_REPLACEMENT_ROOT=/usr/local/share/nemoclaw/tar-7.5.19; \
    rm -rf "$TAR_REPLACEMENT_ROOT"; \
    mkdir -p "$TAR_REPLACEMENT_ROOT"; \
    tar -xzf "$TAR_PACK_PATH" --no-same-owner --no-same-permissions --strip-components=1 -C "$TAR_REPLACEMENT_ROOT"; \
    node --experimental-strip-types /scripts/openclaw-tar-security-revision.mts \
        --openclaw-root /usr/local/lib/node_modules/openclaw \
        --replacement-root "$TAR_REPLACEMENT_ROOT" \
        --expected-openclaw-version "$EXPECTED_OPENCLAW_VERSION"; \
    node --experimental-strip-types /scripts/npm-tar-security-revision.mts \
        --patch-bundled-npm \
        --npm-root /usr/local/lib/node_modules/npm \
        --replacement-root "$TAR_REPLACEMENT_ROOT"; \
    node --experimental-strip-types /scripts/npm-tar-security-revision.mts \
        --verify-bundled-npm \
        --npm-root /usr/local/lib/node_modules/npm; \
    rm -rf "$(dirname "$TAR_PACK_PATH")"; \
    chmod -R a-w "$TAR_REPLACEMENT_ROOT"; \
    stage_reviewed_package() { \
        local package_spec="$1" integrity="$2" tarball_url="$3" destination="$4" archive member; \
        archive="$(node --experimental-strip-types /scripts/lib/reviewed-npm-archive.mts \
            --package-spec "$package_spec" \
            --integrity "$integrity" \
            --tarball-url "$tarball_url" \
            --label "historical OpenClaw plugin remediation dependency ${package_spec}")"; \
        while IFS= read -r member; do \
            case "$member" in package|package/*) ;; *) echo "ERROR: Unexpected npm archive member: $member" >&2; exit 1 ;; esac; \
            case "/$member/" in */../*) echo "ERROR: Parent traversal in npm archive: $member" >&2; exit 1 ;; esac; \
        done < <(tar -tzf "$archive"); \
        tar -tvzf "$archive" | awk 'substr($0, 1, 1) != "-" && substr($0, 1, 1) != "d" { exit 1 }'; \
        mkdir -p "$destination"; \
        tar -xzf "$archive" --no-same-owner --no-same-permissions --strip-components=1 -C "$destination"; \
        rm -rf "$(dirname "$archive")"; \
    }; \
    AXIOS_REPLACEMENT=/usr/local/share/nemoclaw/openclaw-plugin-axios-1.18.0; \
    rm -rf "$AXIOS_REPLACEMENT"; \
    stage_reviewed_package "axios@${AXIOS_VERSION}" "$AXIOS_INTEGRITY" "$AXIOS_TARBALL" "$AXIOS_REPLACEMENT"; \
    stage_reviewed_package "https-proxy-agent@${HTTPS_PROXY_AGENT_VERSION}" "$HTTPS_PROXY_AGENT_INTEGRITY" "$HTTPS_PROXY_AGENT_TARBALL" "$AXIOS_REPLACEMENT/node_modules/https-proxy-agent"; \
    stage_reviewed_package "agent-base@${AGENT_BASE_VERSION}" "$AGENT_BASE_INTEGRITY" "$AGENT_BASE_TARBALL" "$AXIOS_REPLACEMENT/node_modules/https-proxy-agent/node_modules/agent-base"; \
    test "$(node -p "require('${AXIOS_REPLACEMENT}/package.json').version")" = "$AXIOS_VERSION"; \
    test "$(node -p "require('${AXIOS_REPLACEMENT}/node_modules/https-proxy-agent/package.json').version")" = "$HTTPS_PROXY_AGENT_VERSION"; \
    test "$(node -p "require('${AXIOS_REPLACEMENT}/node_modules/https-proxy-agent/node_modules/agent-base/package.json').version")" = "$AGENT_BASE_VERSION"; \
    test -L /usr/local/bin/openclaw; \
    test "$(readlink -f /usr/local/bin/openclaw)" = /usr/local/lib/node_modules/openclaw/openclaw.mjs; \
    test -L /usr/local/bin/npm; \
    test "$(readlink -f /usr/local/bin/npm)" = /usr/local/lib/node_modules/npm/bin/npm-cli.js; \
    mv /usr/local/bin/openclaw /usr/local/bin/openclaw.nemoclaw-original; \
    mv /usr/local/bin/npm /usr/local/bin/npm.nemoclaw-original; \
    chmod 0555 \
        /usr/local/lib/nemoclaw/npm-tar-security-revision.mts \
        /usr/local/lib/nemoclaw/openclaw-plugin-axios-security-revision.mts \
        /usr/local/lib/nemoclaw/openclaw-security-revision-invocation.mts \
        /usr/local/bin/npm.security-wrapper \
        /usr/local/bin/openclaw.security-wrapper; \
    mv /usr/local/bin/openclaw.security-wrapper /usr/local/bin/openclaw; \
    mv /usr/local/bin/npm.security-wrapper /usr/local/bin/npm; \
    test "$(openclaw --version 2>/dev/null | awk '{print $2}')" = "$EXPECTED_OPENCLAW_VERSION"; \
    test "$(npm --version)" = 10.9.7; \
    test "$(npx --version)" = 10.9.7; \
    test "$(node -p "require('/usr/local/lib/node_modules/openclaw/node_modules/tar/package.json').version")" = "$TAR_VERSION"; \
    test "$(node -p "require('/usr/local/lib/node_modules/npm/node_modules/tar/package.json').version")" = "$TAR_VERSION"; \
    NPM_PROBE_ROOT="$(mktemp -d)"; \
    printf '%s\n' '{"name":"nemoclaw-npm-security-probe","version":"1.0.0","private":true}' > "$NPM_PROBE_ROOT/package.json"; \
    printf '%s\n' 'module.exports = true;' > "$NPM_PROBE_ROOT/index.js"; \
    (cd "$NPM_PROBE_ROOT" && npm pack --dry-run --ignore-scripts --json > pack-dry-run.json); \
    node -e 'const report = require(process.argv[1]); if (!Array.isArray(report) || report.length !== 1) process.exit(1)' "$NPM_PROBE_ROOT/pack-dry-run.json"; \
    npm pack --ignore-scripts --json --pack-destination "$NPM_PROBE_ROOT" "$NPM_PROBE_ROOT" > "$NPM_PROBE_ROOT/probe-pack.json"; \
    test -f "$NPM_PROBE_ROOT/nemoclaw-npm-security-probe-1.0.0.tgz"; \
    mkdir -p "$NPM_PROBE_ROOT/install"; \
    printf '%s\n' '{"name":"nemoclaw-npm-install-probe","version":"1.0.0","private":true}' > "$NPM_PROBE_ROOT/install/package.json"; \
    npm install --prefix "$NPM_PROBE_ROOT/install" --ignore-scripts --no-audit --no-fund "$NPM_PROBE_ROOT/nemoclaw-npm-security-probe-1.0.0.tgz"; \
    npm ls --prefix "$NPM_PROBE_ROOT/install" --depth=0 nemoclaw-npm-security-probe; \
    test "$(node -p "require('${NPM_PROBE_ROOT}/install/node_modules/nemoclaw-npm-security-probe/package.json').version")" = 1.0.0; \
    rm -rf "$NPM_PROBE_ROOT"; \
    PROVENANCE_PATH=/usr/local/share/nemoclaw/openclaw-tar-cve-2026-59873-v1; \
    mkdir -p "$(dirname "$PROVENANCE_PATH")"; \
    PROVENANCE_TMP="$(mktemp "${PROVENANCE_PATH}.tmp.XXXXXX")"; \
    printf '%s\n' \
        'schema=1' \
        "source=${BASE_IMAGE}" \
        "openclaw=${EXPECTED_OPENCLAW_VERSION}" \
        "package=tar@${TAR_VERSION}" \
        "integrity=${TAR_INTEGRITY}" \
        "tarball=${TAR_TARBALL}" \
        'npm=10.9.7' \
        "npm-package=tar@${TAR_VERSION}" \
        'scope=openclaw,npm-bundle,historical-nemoclaw' \
        'advisory=CVE-2026-59873' \
        > "$PROVENANCE_TMP"; \
    chmod 0444 "$PROVENANCE_TMP"; \
    mv "$PROVENANCE_TMP" "$PROVENANCE_PATH"; \
    PLUGIN_PROVENANCE_PATH=/usr/local/share/nemoclaw/openclaw-plugin-axios-security-revision-v1; \
    PLUGIN_PROVENANCE_TMP="$(mktemp "${PLUGIN_PROVENANCE_PATH}.tmp.XXXXXX")"; \
    printf '%s\n' \
        'schema=1' \
        "source=${BASE_IMAGE}" \
        "openclaw=${EXPECTED_OPENCLAW_VERSION}" \
        "package=axios@${AXIOS_VERSION}" \
        "integrity=${AXIOS_INTEGRITY}" \
        "tarball=${AXIOS_TARBALL}" \
        'scope=@openclaw/slack,@openclaw/msteams' \
        'versions=2026.5.22,2026.5.27,2026.6.10' \
        > "$PLUGIN_PROVENANCE_TMP"; \
    chmod 0444 "$PLUGIN_PROVENANCE_TMP"; \
    mv "$PLUGIN_PROVENANCE_TMP" "$PLUGIN_PROVENANCE_PATH"
