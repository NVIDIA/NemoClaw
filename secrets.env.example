# Copy to ~/.nemoclaw/secrets.env (or run: nemoclaw credentials init-secrets)
# This example file is safe to keep in git — put real keys only in ~/.nemoclaw/secrets.env

# NVIDIA API key (nvapi-*) — https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# Inference Hub API key (sk-*) — https://inference-api.nvidia.com/v1/chat/completions
NVIDIA_INFERENCE_HUB_API_KEY=

# OPENAI_API_KEY=
# TAVILY_API_KEY=
