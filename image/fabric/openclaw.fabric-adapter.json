{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nemoclaw.local.openclaw",
  "adapter_kind": "python",
  "runner": {
    "module": "openclaw_adapter"
  },
  "settings_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agent_name": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "inference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api",
          "tuning"
        ],
        "properties": {
          "api": {
            "enum": [
              "openai-completions",
              "openai-responses",
              "anthropic-messages"
            ]
          },
          "tuning": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "contextWindow": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              },
              "maxTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              },
              "reasoning": {
                "type": "boolean"
              },
              "reasoningEffort": {
                "enum": [
                  "default",
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          },
          "agents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,39}$"
                },
                "tools": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "allow"
                      ],
                      "properties": {
                        "allow": {
                          "const": [
                            "read"
                          ]
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "disclosure"
                      ],
                      "properties": {
                        "disclosure": {
                          "enum": [
                            "progressive",
                            "direct"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "interfaces": {
            "type": "object",
            "required": [
              "dashboard"
            ],
            "additionalProperties": false,
            "properties": {
              "dashboard": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "port": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 65535,
                    "not": {
                      "minimum": 8642,
                      "maximum": 8652
                    }
                  },
                  "bind": {
                    "enum": [
                      "127.0.0.1",
                      "0.0.0.0"
                    ]
                  }
                }
              }
            }
          },
          "execution": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              },
              "heartbeatEvery": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^[0-9]+[smh]$(?![\\s\\S])"
              }
            }
          }
        }
      }
    },
    "required": [
      "agent_name"
    ]
  },
  "config": {
    "accepts": [
      "models",
      "models.base_url"
    ]
  }
}
