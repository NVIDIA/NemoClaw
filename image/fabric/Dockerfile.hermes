FROM node@sha256:ac39e4b5fcb2b1b34b20364fd58b2e898f3bb80731ee6f62a7536f9df3d6aadc
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv iproute2 nftables ca-certificates git ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/fabric \
    && install -d -m 0700 -o 1000 -g 1000 /sandbox
COPY wheels /opt/wheels
COPY requirements.txt /opt/requirements.txt
RUN /opt/fabric/bin/pip install --no-index --find-links=/opt/wheels --require-hashes -r /opt/requirements.txt \
    && rm -rf /opt/wheels
# Hermes resolves bundled assets relative to its source checkout. Keep the verified
# source and use its supported editable install, with already locked dependencies.
COPY hermes-agent-29112bef099274229cadff79cdff7bf7b99c4b77 /opt/hermes
RUN /opt/fabric/bin/pip install --no-index --no-deps --no-build-isolation -e /opt/hermes --config-settings editable_mode=compat
COPY fabric.py /opt/nemoclaw/fabric.py
COPY provenance.json /opt/nemoclaw/provenance.json
ENV HERMES_DISABLE_LAZY_INSTALLS=1
USER node
HEALTHCHECK NONE
