+            nemo_fabric_core::FabricError::UnverifiedAdapterCapability { .. } => {
+                Some("adapter_capability_unverified")
+            }
+            _ => None,
+        };
+        if let Some(code) = code
+            && let Err(failure) = exception.value(py).setattr("code", code)
+        {
+            return failure;
+        }
+        exception
+    })
