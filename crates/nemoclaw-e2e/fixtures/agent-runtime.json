{
  "policy": {
    "Version": 1,
    "Filesystem": {
      "IncludeWorkdir": false,
      "ReadOnly": [
        "/usr",
        "/bin",
        "/sbin",
        "/lib",
        "/lib64",
        "/etc",
        "/app",
        "/opt",
        "/proc"
      ],
      "ReadWrite": [
        "/sandbox",
        "/tmp",
        "/dev/null",
        "/dev/urandom",
        "/home/node"
      ]
    },
    "Landlock": {
      "Compatibility": "best_effort"
    },
    "Process": {
      "RunAsUser": "1000",
      "RunAsGroup": "1000"
    },
    "NetworkPolicies": {},
    "NetworkMiddlewares": null
  },
  "reference": "b549ccd43e6102b72aa9c65ee17abfe3c429fc0b",
  "runtimes": {
    "fabric-claude": {
      "command": [
        "/opt/fabric/bin/python",
        "/opt/nemoclaw/fabric.py",
        "serve"
      ],
      "environment": {
        "ADAPTER_PYTHON": "/opt/fabric/bin/python",
        "HOME": "/sandbox",
        "NEMOCLAW_AGENT_NAME": "main",
        "NEMOCLAW_FABRIC_HARNESS": "claude",
        "NODE_EXTRA_CA_CERTS": "/etc/ssl/certs/ca-certificates.crt",
        "OPENAI_API_KEY": "openshell-placeholder",
        "PATH": "/opt/fabric/bin:/usr/local/bin:/usr/bin:/bin",
        "PYTHONDONTWRITEBYTECODE": "1",
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
        "TMPDIR": "/sandbox/tmp",
        "XDG_CACHE_HOME": "/sandbox/.cache"
      }
    },
