{
  "policy": {
    "Version": 1,
    "Filesystem": {
      "IncludeWorkdir": false,
      "ReadOnly": [
        "/usr",
        "/bin",
        "/sbin",
        "/lib",
        "/lib64",
        "/etc",
        "/app",
        "/opt",
        "/proc"
