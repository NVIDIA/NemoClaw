#
# Copy to secrets.env (gitignored) and paste keys after the =.
# Do not quote values. Do not commit secrets.env.
#
# NGC_API_KEY is the nvapi- key from https://ngc.nvidia.com (Setup > API Keys).
# That same key authenticates nvcr.io image pulls. apply-local-secrets.sh stores
# it as Kubernetes Secret ngc-registry (dockerconfigjson) so kubelet can pull
# nvcr.io/nvidia/vllm. NIM also gets Opaque secret nim-ngc-key (env NGC_API_KEY)
# for in-container model-profile download. vLLM does not read that env var.
#
# HF_TOKEN is optional. Set it only if Hugging Face returns 401 for the vLLM model.

NGC_API_KEY=
HF_TOKEN=

# Optional. OpenClaw Control UI web search on sandbox 0 only (same as
# nemoclaw onboard). Default e2e pin leaves search off. After setting a key:
#   NEMOCLAW_WEB_SEARCH_ENABLED=1 E2E_USERS=5 ./scripts/publish-openclaw-remote-http.sh
# NEMOCLAW_WEB_SEARCH_ENABLED=1
# NEMOCLAW_WEB_SEARCH_PROVIDER=brave
# BRAVE_API_KEY=
# TAVILY_API_KEY=
