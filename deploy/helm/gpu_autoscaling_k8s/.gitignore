# Cluster-local overrides (see local.env.example)
local.env
hpa-tls-values.yaml

# Raw NGC / Hugging Face keys. Never commit. See secrets.env.example.
secrets.env
*.key

# Local OpenShell CLI prefix (pip --prefix); not part of the recipe.
.tools-openshell/

# Multi-user sandbox e2e output (HPA CSV, per-sandbox saturator logs).
# Animation JSONL (client-timeline.jsonl, hpa-timeline.jsonl) stays on the
# DGX. Do not commit or upload it.
e2e-results/
client-timeline.jsonl
hpa-timeline.jsonl
hpa-timeline.pid
*.token
