#
# Copy to local.env (gitignored) and edit for your cluster.
# install-hpa.sh / hpa-load-test.sh / hpa-reset.sh auto-source local.env from this
# recipe directory — works even if you invoke the scripts from another cwd.
#
# Paths are resolved from this file's location (not $PWD), so they stay correct
# when the shell's working directory changes. Already-exported vars win over these
# defaults (${VAR:-...}).

_RECIPE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# TLS Helm overlay (create once — see README "TLS values")
HPA_VALUES="${HPA_VALUES:-${_RECIPE_DIR}/hpa-tls-values.yaml}"
export HPA_VALUES

# Must match ingress.host / tls.hosts in that overlay
INGRESS_HOST="${INGRESS_HOST:-nemoclaw.example.com}"
export INGRESS_HOST

# Optional:
# export INFERENCE_MODEL="${INFERENCE_MODEL:-llama3.2:3b}"
# export NEMOCLAW_TARGET_NODE="${NEMOCLAW_TARGET_NODE:-}"

unset _RECIPE_DIR
