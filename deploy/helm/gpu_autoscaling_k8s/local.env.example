#
# Copy to local.env (gitignored) and edit for your cluster.
# install-hpa.sh / hpa-load-test.sh / hpa-reset.sh auto-source local.env from this
# recipe directory — works even if you invoke the scripts from another cwd.
#
# Paths are resolved from this file's location (not $PWD), so they stay correct
# when the shell's working directory changes. Already-exported vars win over these
# defaults (${VAR:-...}).

_RECIPE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# TLS Helm overlay (create once — see README "TLS values")
HPA_VALUES="${HPA_VALUES:-${_RECIPE_DIR}/hpa-tls-values.yaml}"
export HPA_VALUES

# Must match ingress.host / tls.hosts in that overlay
INGRESS_HOST="${INGRESS_HOST:-nemoclaw.example.com}"
export INGRESS_HOST

# MicroK8s uses gpu-operator-resources. Standard NVIDIA GPU Operator uses gpu-operator.
# export DCGM_NAMESPACE="${DCGM_NAMESPACE:-gpu-operator}"

# On a cluster-managed monitoring installation, set USE_EXISTING_PROMETHEUS=auto
# to discover one deployed kube-prometheus-stack, or set all four values below to
# require this specific stack. The installer configures its adapter with the recipe's
# GPU HPA rules. Leave this unset for the Brev-tested self-managed default.
# export USE_EXISTING_PROMETHEUS=auto
# export USE_EXISTING_PROMETHEUS=1
# export MONITORING_NS=prometheus
# export PROM_RELEASE=kube-prometheus-stack
# export ADAPTER_RELEASE=prometheus-adapter

# Optional:
# export INFERENCE_MODEL="${INFERENCE_MODEL:-llama3.2:3b}"
# export NEMOCLAW_TARGET_NODE="${NEMOCLAW_TARGET_NODE:-}"

# NVIDIA NIM only — default Ollama needs no NVIDIA/NGC key. Before selecting NIM, run
#   NAMESPACE=nemoclaw-gpu ./scripts/create-nim-ngc-secrets.sh
# It prompts for the key without echoing it and creates both needed Kubernetes Secrets.
# Keep only the Secret names here; never put the NGC API key in this file or Git:
# export INFERENCE_RUNTIME=nim
# export INFERENCE_MODEL=nvidia/nemotron-3-nano
# export NIM_NGC_API_KEY_SECRET=nim-ngc-key
# export NIM_IMAGE_PULL_SECRET=ngc-registry

# vLLM only — no NGC model-download key. Set this only if nvcr.io requires image-pull
# credentials; it can reuse the ngc-registry Secret created above. For a gated Hugging
# Face model, create an Opaque Secret with key HF_TOKEN and name it here.
# export VLLM_IMAGE_PULL_SECRET=ngc-registry
# export VLLM_HF_TOKEN_SECRET=hf-token

# HPA load-test profile. `auto` is the default: it chooses `dgx-8xh100` for eight
# H100 GPUs, `brev-4xl40s` for four L40S GPUs, or `portable` for other hardware.
# Pin one only when you need to override detection:
# export HPA_LOAD_PROFILE=dgx-8xh100
# export HPA_LOAD_PROFILE=brev-4xl40s

unset _RECIPE_DIR
