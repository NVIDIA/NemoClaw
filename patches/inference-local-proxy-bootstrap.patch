diff --git a/scripts/nemoclaw-start.sh b/scripts/nemoclaw-start.sh
index f995002..09b9da6 100755
--- a/scripts/nemoclaw-start.sh
+++ b/scripts/nemoclaw-start.sh
@@ -703,6 +703,44 @@ export http_proxy="$_PROXY_URL"
 export https_proxy="$_PROXY_URL"
 export no_proxy="$_NO_PROXY_VAL"
 
+# inference.local is intentionally routed through the OpenShell proxy. That
+# proxy terminates TLS with an OpenShell Sandbox CA that is not present in the
+# sandbox trust store by default. OpenClaw's Node/undici client validates TLS,
+# so bootstrap a small CA bundle from the proxy-presented chain and expose it
+# through NODE_EXTRA_CA_CERTS for both the gateway and interactive sessions.
+#
+# This preserves TLS verification instead of disabling it globally.
+_INFERENCE_LOCAL_CA_FILE="/tmp/nemoclaw-inference-local-ca.pem"
+bootstrap_inference_local_ca() {
+  [ "${NEMOCLAW_SKIP_INFERENCE_LOCAL_CA_BOOTSTRAP:-0}" = "1" ] && return 0
+  command -v openssl >/dev/null 2>&1 || return 0
+  local certs
+  if command -v timeout >/dev/null 2>&1; then
+    certs="$(timeout 5 openssl s_client \
+      -proxy "${PROXY_HOST}:${PROXY_PORT}" \
+      -connect inference.local:443 \
+      -servername inference.local \
+      -showcerts \
+      </dev/null 2>/dev/null | sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p')" || return 0
+  else
+    certs="$(openssl s_client \
+      -proxy "${PROXY_HOST}:${PROXY_PORT}" \
+      -connect inference.local:443 \
+      -servername inference.local \
+      -showcerts \
+      </dev/null 2>/dev/null | sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p')" || return 0
+  fi
+  [ -n "$certs" ] || return 0
+  printf '%s\n' "$certs" >"$_INFERENCE_LOCAL_CA_FILE"
+  chmod 644 "$_INFERENCE_LOCAL_CA_FILE"
+}
+bootstrap_inference_local_ca
+export NODE_EXTRA_CA_CERTS="$_INFERENCE_LOCAL_CA_FILE"
+case " ${NODE_OPTIONS:-} " in
+  *" --use-env-proxy "*) ;;
+  *) export NODE_OPTIONS="${NODE_OPTIONS:+${NODE_OPTIONS} }--use-env-proxy" ;;
+esac
+
 # OpenShell re-injects narrow NO_PROXY/no_proxy=127.0.0.1,localhost,::1 every
 # time a user connects via `openshell sandbox connect`.  The connect path spawns
 # `/bin/bash -i` (interactive, non-login), which sources ~/.bashrc — NOT
@@ -732,6 +770,11 @@ export NO_PROXY="$_NO_PROXY_VAL"
 export http_proxy="$_PROXY_URL"
 export https_proxy="$_PROXY_URL"
 export no_proxy="$_NO_PROXY_VAL"
+export NODE_EXTRA_CA_CERTS="$_INFERENCE_LOCAL_CA_FILE"
+case " ${NODE_OPTIONS:-} " in
+  *" --use-env-proxy "*) ;;
+  *) export NODE_OPTIONS="${NODE_OPTIONS:+${NODE_OPTIONS} }--use-env-proxy" ;;
+esac
 PROXYEOF
   # Tool cache redirects — generated from _TOOL_REDIRECTS (single source of truth)
   echo '# Tool cache redirects — /sandbox is Landlock read-only (#804)'
